<style>
    .topnav {
        display: flex;
        position: sticky;
        top: 0;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.6rem 1rem;
        /* translucent background with slight blur */
        background: rgba(255, 255, 255, 0.72);
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        border-bottom: 1px solid #eee;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    .brand {
        font-weight: 700;
        color: #6c4bd1;
    }

    .nav-links {
        display: flex;
        gap: 0.75rem;
        align-items: center;
    }

    .nav-links a {
        color: #333;
        text-decoration: none;
        padding: 0.35rem 0.6rem;
        border-radius: 6px;
    }

    .nav-links a:hover {
        background: #f3f3ff;
        color: #4b2fa6;
    }

    .greeting {
        color: #444;
        font-size: 0.95rem;
        margin-right: 0.5rem;
    }

    .badge {
        /* match the translucent navbar look */
        background: rgba(240, 244, 255, 0.6);
        color: #2b1b7a;
        padding: 0.2rem 0.4rem;
        border-radius: 4px;
        font-size: 0.8rem;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .navbar-logo-img {
        height: 50px;
        width: auto;
        object-fit: contain;
    }

    .navbar-title {
        font-size: 1.5rem;
        margin: 0;
        color: #6c4bd1;
        font-weight: 700;
    }
</style>

<nav class="topnav" role="navigation" aria-label="Main navigation">
    <div class="navbar-brand">
        <img src="/images/global/logo.png" alt="BabyStar Logo" class="navbar-logo-img">
        <h1 class="navbar-title">BabyStar</h1>
    </div>

    <div style="flex:1"></div>

    <div class="nav-links">
        <div class="greeting">
            Hello, <strong>
                <%= user && user.fullName ? user.fullName : 'Guest' %>
            </strong>
            <% if (user) { %>
                <span class="badge">Session: active</span>
                <% } else { %>
                    <span class="badge">Not signed in</span>
                    <% } %>
        </div>

        <% if (user) { %>
            <a href="/auth/profile">Profile</a>
            <a href="/auth/logout">Logout</a>
            <% } else { %>
                <a href="/auth/login">Login</a>
                <a href="/auth/register">Register</a>
                <% } %>
    </div>
</nav>