<link rel="stylesheet" href="/css/user-edit.css">

<main class="container" role="main">
  <header>
    <div class="logo">BS</div>
    <div class="brand">
      <div class="title">Account Settings</div>
      <div class="subtitle">Manage your profile and pregnancy information</div>
    </div>
  </header>

  <form id="profileForm" novalidate>
    <!-- Personal Information -->
    <section class="card">
      <h2 class="card-title">Personal Information</h2>
      
      <div class="field">
        <label for="fullName">Full Name</label>
        <input id="fullName" name="fullName" type="text" placeholder="Enter your full name" />
        <div class="field-error" id="fullNameError"></div>
      </div>

      <div class="row two">
        <div class="field">
          <label for="email">Email Address</label>
          <input id="email" name="email" type="email" placeholder="name@example.com" />
          <div class="field-error" id="emailError"></div>
        </div>
        <div class="field">
          <label for="phoneNumber">Phone Number</label>
          <input id="phoneNumber" name="phoneNumber" type="tel" placeholder="+1 555 555 5555" />
          <div class="field-error" id="phoneNumberError"></div>
        </div>
      </div>

      <div class="row two">
        <div class="field">
          <label for="dateOfBirth">Date of Birth</label>
          <input id="dateOfBirth" name="dateOfBirth" type="date" />
        </div>
        <div class="field">
          <label for="currentWeightKg">Current Weight (kg)</label>
          <input id="currentWeightKg" name="currentWeightKg" type="number" step="0.1" min="20" max="500" />
        </div>
      </div>
    </section>

    <!-- Pregnancy Information -->
    <section class="card">
      <h2 class="card-title">Pregnancy Information</h2>

      <div class="row two">
        <div class="field">
          <label for="pp_lastMenstrualPeriod">Last Menstrual Period (LMP)</label>
          <input id="pp_lastMenstrualPeriod" name="pregnancyProfile.lastMenstrualPeriod" type="date" />
          <div class="helper">First day of your last period</div>
        </div>
        <div class="field">
          <label for="pp_dueDate">Expected Due Date</label>
          <input id="pp_dueDate" name="pregnancyProfile.dueDate" type="date" />
        </div>
      </div>

      <div class="row three">
        <div class="field">
          <label for="pp_bloodType">Blood Type</label>
          <select id="pp_bloodType" name="pregnancyProfile.bloodType">
            <option value="">Select...</option>
            <option value="A+">A+</option><option value="A-">A-</option>
            <option value="B+">B+</option><option value="B-">B-</option>
            <option value="AB+">AB+</option><option value="AB-">AB-</option>
            <option value="O+">O+</option><option value="O-">O-</option>
          </select>
        </div>
        <div class="field">
          <label for="pp_gravida">Gravida</label>
          <input id="pp_gravida" name="pregnancyProfile.gravida" type="number" min="1" max="20" />
          <div class="helper">Total pregnancies</div>
        </div>
        <div class="field">
          <label for="pp_para">Para</label>
          <input id="pp_para" name="pregnancyProfile.para" type="number" min="0" max="20" />
          <div class="helper">Prior births after 20 weeks</div>
        </div>
      </div>

      <div class="row two">
        <div class="field">
          <label for="pp_heightCm">Height (cm)</label>
          <input id="pp_heightCm" name="pregnancyProfile.heightCm" type="number" step="0.1" min="50" max="300" />
        </div>
        <div class="field">
          <label for="pp_prePregnancyWeightKg">Pre-Pregnancy Weight (kg)</label>
          <input id="pp_prePregnancyWeightKg" name="pregnancyProfile.prePregnancyWeightKg" type="number" step="0.1" min="20" max="500" />
        </div>
      </div>

      <div class="field">
        <label for="pp_allergies">Allergies</label>
        <input id="pp_allergies" name="pregnancyProfile.allergies" type="text" placeholder="Peanuts, Shellfish (comma separated)" />
      </div>

      <div class="field">
        <label for="pp_medicalConditions">Medical Conditions</label>
        <input id="pp_medicalConditions" name="pregnancyProfile.medicalConditions" type="text" placeholder="Gestational diabetes (comma separated)" />
      </div>

      <div class="field checkbox-field">
        <label class="checkbox-label">
          <input type="checkbox" id="pp_isHighRisk" name="pregnancyProfile.isHighRisk" />
          <span>High-Risk Pregnancy</span>
        </label>
      </div>
    </section>

    <!-- Healthcare Provider -->
    <section class="card">
      <h2 class="card-title">Healthcare Provider</h2>
      <div class="row two">
        <div class="field">
          <label for="pp_primaryPhysician">Primary Physician / Midwife</label>
          <input id="pp_primaryPhysician" name="pregnancyProfile.primaryPhysician" type="text" />
        </div>
        <div class="field">
          <label for="pp_hospitalName">Hospital / Birth Center</label>
          <input id="pp_hospitalName" name="pregnancyProfile.hospitalName" type="text" />
        </div>
      </div>
    </section>

    <!-- Preferences -->
    <section class="card">
      <h2 class="card-title">Preferences</h2>
      <div class="row two">
        <div class="field">
          <label for="preferredLanguage">Language</label>
          <select id="preferredLanguage" name="preferredLanguage">
            <option value="en">English</option>
            <option value="vi">Tiếng Việt</option>
            <option value="es">Español</option>
            <option value="fr">Français</option>
          </select>
        </div>
        <div class="field">
          <label for="timezone">Timezone</label>
          <select id="timezone" name="timezone">
            <option value="UTC">UTC</option>
            <option value="America/New_York">Eastern Time (US)</option>
            <option value="America/Los_Angeles">Pacific Time (US)</option>
            <option value="Europe/London">London</option>
            <option value="Asia/Ho_Chi_Minh">Ho Chi Minh City</option>
            <option value="Asia/Tokyo">Tokyo</option>
          </select>
        </div>
      </div>

      <div class="notification-prefs">
        <h3>Notifications</h3>
        <div class="checkbox-grid">
          <label class="checkbox-label"><input type="checkbox" id="notif_email" /><span>Email</span></label>
          <label class="checkbox-label"><input type="checkbox" id="notif_push" /><span>Push</span></label>
          <label class="checkbox-label"><input type="checkbox" id="notif_dailyReminders" /><span>Daily Reminders</span></label>
          <label class="checkbox-label"><input type="checkbox" id="notif_weeklyReportReady" /><span>Weekly Reports</span></label>
          <label class="checkbox-label"><input type="checkbox" id="notif_appointmentReminders" /><span>Appointments</span></label>
          <label class="checkbox-label"><input type="checkbox" id="notif_healthAlerts" /><span>Health Alerts</span></label>
        </div>
      </div>
    </section>

    <!-- Password Section -->
    <section class="card" id="passwordSection">
      <h2 class="card-title">Password</h2>
      <div id="passwordInfo"></div>
      
      <div id="passwordForm" style="display:none;">
        <div class="field" id="currentPasswordField">
          <label for="currentPassword">Current Password</label>
          <input id="currentPassword" type="password" placeholder="Enter current password" />
          <div class="field-error" id="currentPasswordError"></div>
        </div>
        
        <div class="field">
          <label for="newPassword">New Password</label>
          <input id="newPassword" type="password" placeholder="At least 6 characters" />
          <div class="field-error" id="newPasswordError"></div>
        </div>
        
        <div class="field">
          <label for="newPassword2">Confirm New Password</label>
          <input id="newPassword2" type="password" placeholder="Confirm new password" />
          <div class="field-error" id="newPassword2Error"></div>
        </div>
        
        <button type="button" id="changePasswordBtn" class="btn-primary">
          <span id="changePasswordBtnText">Change Password</span>
        </button>
        <div id="passwordMessage" class="msg" hidden></div>
      </div>
    </section>

    <div class="form-actions">
      <button type="submit" class="btn-primary" id="saveBtn">Save Changes</button>
      <div id="message" class="msg" hidden></div>
    </div>
    <div id="formErrors" class="error"></div>
  </form>

  <!-- Status Sidebar -->
  <aside class="status-sidebar">
    <div class="card status-card">
      <div class="section-head">
        <strong>Pregnancy Progress</strong>
        <div id="progressText" class="progress-label">Not set</div>
      </div>
      <div class="progress-bar-container"><div class="progress-bar" id="progressBar"></div></div>
      <div class="small" id="progressDetail">Add LMP or due date to see progress.</div>
      <div class="stats-grid">
        <div class="stat-item"><div class="stat-value" id="statTrimester">-</div><div class="stat-label">Trimester</div></div>
        <div class="stat-item"><div class="stat-value" id="statDaysLeft">-</div><div class="stat-label">Days to Due</div></div>
        <div class="stat-item"><div class="stat-value" id="statAge">-</div><div class="stat-label">Your Age</div></div>
        <div class="stat-item"><div class="stat-value" id="statBMI">-</div><div class="stat-label">Pre-Preg BMI</div></div>
      </div>
    </div>
    <div class="card">
      <strong>Quick Actions</strong>
      <div class="quick-actions">
        <button type="button" id="exportProfile" class="btn-ghost">Export Profile</button>
        <button type="button" id="clearPregnancy" class="btn-ghost danger">Clear Pregnancy Data</button>
      </div>
    </div>
  </aside>
</main>

<script>
(function() {
  const form = document.getElementById('profileForm');
  const saveBtn = document.getElementById('saveBtn');
  const resetBtn = document.getElementById('resetBtn');
  const messageEl = document.getElementById('message');
  let originalData = {};

  async function loadUserData() {
    try {
      const resp = await fetch('/auth/user-edit/data', { credentials: 'include' });
      const result = await resp.json();
      if (result.success) {
        originalData = JSON.parse(JSON.stringify(result.data));
        populateForm(result.data);
        updateStatus(result.data);
      }
    } catch (err) {
      showMessage('Failed to load profile', 'error');
    }
  }

  function populateForm(data) {
    // Personal Info
    document.getElementById('fullName').value = data.fullName || '';
    document.getElementById('email').value = data.email || '';
    document.getElementById('phoneNumber').value = data.phoneNumber || '';
    document.getElementById('dateOfBirth').value = data.dateOfBirth || '';
    document.getElementById('currentWeightKg').value = data.currentWeightKg || '';

    // Pregnancy Profile
    const pp = data.pregnancyProfile || {};
    document.getElementById('pp_lastMenstrualPeriod').value = pp.lastMenstrualPeriod || '';
    document.getElementById('pp_dueDate').value = pp.dueDate || '';
    document.getElementById('pp_bloodType').value = pp.bloodType || '';
    document.getElementById('pp_gravida').value = pp.gravida || 1;
    document.getElementById('pp_para').value = pp.para || 0;
    document.getElementById('pp_heightCm').value = pp.heightCm || '';
    document.getElementById('pp_prePregnancyWeightKg').value = pp.prePregnancyWeightKg || '';
    document.getElementById('pp_allergies').value = Array.isArray(pp.allergies) ? pp.allergies.join(', ') : '';
    document.getElementById('pp_medicalConditions').value = Array.isArray(pp.medicalConditions) ? pp.medicalConditions.join(', ') : '';
    document.getElementById('pp_isHighRisk').checked = pp.isHighRisk || false;
    document.getElementById('pp_primaryPhysician').value = pp.primaryPhysician || '';
    document.getElementById('pp_hospitalName').value = pp.hospitalName || '';

    // Preferences
    document.getElementById('preferredLanguage').value = data.preferredLanguage || 'en';
    document.getElementById('timezone').value = data.timezone || 'UTC';

    // Notifications
    const notif = data.notificationPreferences || {};
    document.getElementById('notif_email').checked = notif.email !== false;
    document.getElementById('notif_push').checked = notif.push !== false;
    document.getElementById('notif_dailyReminders').checked = notif.dailyReminders !== false;
    document.getElementById('notif_weeklyReportReady').checked = notif.weeklyReportReady !== false;
    document.getElementById('notif_appointmentReminders').checked = notif.appointmentReminders !== false;
    document.getElementById('notif_healthAlerts').checked = notif.healthAlerts !== false;
  }

  function updateStatus(data) {
    const cw = data.currentWeek;
    if (cw) {
      document.getElementById('progressText').textContent = `Week ${cw.weeks}${cw.days > 0 ? ` + ${cw.days}d` : ''}`;
      document.getElementById('progressBar').style.width = `${Math.min(100, Math.round((cw.weeks / 40) * 100))}%`;
      document.getElementById('progressDetail').textContent = data.daysUntilDue > 0 ? `${data.daysUntilDue} days until due` : '';
    }
    document.getElementById('statTrimester').textContent = data.trimester || '-';
    document.getElementById('statDaysLeft').textContent = data.daysUntilDue ?? '-';
    document.getElementById('statAge').textContent = data.age ?? '-';
    
    const pp = data.pregnancyProfile || {};
    if (pp.heightCm && pp.prePregnancyWeightKg) {
      const bmi = (pp.prePregnancyWeightKg / Math.pow(pp.heightCm / 100, 2)).toFixed(1);
      document.getElementById('statBMI').textContent = bmi;
    }
  }

  function showMessage(text, type = 'success') {
    messageEl.textContent = text;
    messageEl.className = `msg ${type}`;
    messageEl.hidden = false;
    setTimeout(() => messageEl.hidden = true, 4000);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    saveBtn.textContent = 'Saving...';

    const formData = {
      fullName: document.getElementById('fullName').value,
      email: document.getElementById('email').value,
      phoneNumber: document.getElementById('phoneNumber').value,
      dateOfBirth: document.getElementById('dateOfBirth').value,
      currentWeightKg: document.getElementById('currentWeightKg').value,
      pregnancyProfile: {
        lastMenstrualPeriod: document.getElementById('pp_lastMenstrualPeriod').value,
        dueDate: document.getElementById('pp_dueDate').value,
        bloodType: document.getElementById('pp_bloodType').value,
        gravida: document.getElementById('pp_gravida').value,
        para: document.getElementById('pp_para').value,
        heightCm: document.getElementById('pp_heightCm').value,
        prePregnancyWeightKg: document.getElementById('pp_prePregnancyWeightKg').value,
        allergies: document.getElementById('pp_allergies').value,
        medicalConditions: document.getElementById('pp_medicalConditions').value,
        isHighRisk: document.getElementById('pp_isHighRisk').checked,
        primaryPhysician: document.getElementById('pp_primaryPhysician').value,
        hospitalName: document.getElementById('pp_hospitalName').value
      },
      preferredLanguage: document.getElementById('preferredLanguage').value,
      timezone: document.getElementById('timezone').value,
      notificationPreferences: {
        email: document.getElementById('notif_email').checked,
        push: document.getElementById('notif_push').checked,
        dailyReminders: document.getElementById('notif_dailyReminders').checked,
        weeklyReportReady: document.getElementById('notif_weeklyReportReady').checked,
        appointmentReminders: document.getElementById('notif_appointmentReminders').checked,
        healthAlerts: document.getElementById('notif_healthAlerts').checked
      }
    };

    try {
      const resp = await fetch('/auth/user-edit', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(formData)
      });
      const result = await resp.json();
      if (result.success) {
        showMessage('Profile saved!', 'success');
        await loadUserData();
      } else {
        showMessage(result.errors?.general || 'Error saving', 'error');
      }
    } catch (err) {
      showMessage('Failed to save', 'error');
    } finally {
      saveBtn.disabled = false;
      saveBtn.textContent = 'Save Changes';
    }
  });

  resetBtn.addEventListener('click', () => { populateForm(originalData); showMessage('Form reset', 'success'); });
  document.getElementById('exportProfile').addEventListener('click', () => { window.location.href = '/auth/user-edit/export'; });
  document.getElementById('clearPregnancy').addEventListener('click', async () => {
    if (!confirm('Clear all pregnancy data?')) return;
    await fetch('/auth/user-edit/pregnancy', { method: 'DELETE', credentials: 'include' });
    await loadUserData();
    showMessage('Pregnancy data cleared', 'success');
  });

  // Password section
  async function loadPasswordInfo() {
    try {
      const resp = await fetch('/auth/has-password', { credentials: 'include' });
      const data = await resp.json();
      
      const passwordInfo = document.getElementById('passwordInfo');
      const passwordForm = document.getElementById('passwordForm');
      const currentPasswordField = document.getElementById('currentPasswordField');
      const changePasswordBtnText = document.getElementById('changePasswordBtnText');
      
      if (data.success) {
        if (data.hasPassword) {
          passwordInfo.innerHTML = '<p class="info-text">You have a password set. You can change it below.</p>';
          currentPasswordField.style.display = 'block';
          changePasswordBtnText.textContent = 'Change Password';
        } else {
          passwordInfo.innerHTML = `<p class="info-text">You signed up with ${data.authProvider === 'google' ? 'Google' : 'another method'}. Set a password to also login with email/phone.</p>`;
          currentPasswordField.style.display = 'none';
          changePasswordBtnText.textContent = 'Set Password';
        }
        passwordForm.style.display = 'block';
      }
    } catch (err) {
      console.error('Failed to load password info:', err);
    }
  }

  document.getElementById('changePasswordBtn').addEventListener('click', async () => {
    const btn = document.getElementById('changePasswordBtn');
    const msgEl = document.getElementById('passwordMessage');
    
    // Clear errors
    document.querySelectorAll('#passwordForm .field-error').forEach(el => el.textContent = '');
    msgEl.hidden = true;
    
    const data = {
      currentPassword: document.getElementById('currentPassword').value,
      newPassword: document.getElementById('newPassword').value,
      newPassword2: document.getElementById('newPassword2').value
    };
    
    btn.disabled = true;
    
    try {
      const resp = await fetch('/auth/change-password', {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(data)
      });
      
      const result = await resp.json();
      
      if (result.success) {
        msgEl.className = 'msg success';
        msgEl.textContent = result.message;
        msgEl.hidden = false;
        // Clear form
        document.getElementById('currentPassword').value = '';
        document.getElementById('newPassword').value = '';
        document.getElementById('newPassword2').value = '';
        // Reload password info
        await loadPasswordInfo();
      } else {
        if (result.errors) {
          Object.entries(result.errors).forEach(([field, msg]) => {
            const el = document.getElementById(field + 'Error');
            if (el) el.textContent = msg;
          });
        }
        msgEl.className = 'msg error';
        msgEl.textContent = result.errors?.general || 'Failed to change password';
        msgEl.hidden = false;
      }
    } catch (err) {
      msgEl.className = 'msg error';
      msgEl.textContent = 'An error occurred';
      msgEl.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });

  // Load password info on page load
  loadPasswordInfo();

  // Auto-calculate due date
  document.getElementById('pp_lastMenstrualPeriod').addEventListener('change', (e) => {
    if (e.target.value && !document.getElementById('pp_dueDate').value) {
      const lmp = new Date(e.target.value);
      const due = new Date(lmp.getTime() + 280 * 24 * 60 * 60 * 1000);
      document.getElementById('pp_dueDate').value = due.toISOString().split('T')[0];
    }
  });

  loadUserData();
})();
</script>