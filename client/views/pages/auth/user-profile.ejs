 <link rel="stylesheet" href="/css/.cssuser-profile.css">
 
 <main class="container" role="main">
    <header class="top">
      <div class="brand">
        <div class="title">Pregnancy profile</div>
        <div class="subtitle">A quick view of saved details and pregnancy progress.</div>
      </div>
    </header>

    <section class="profile-card" aria-label="User profile">
      <div class="left">
        <div id="avatar" class="avatar" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-icon lucide-user"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div class="name" id="displayName">Phan Xuan Hung</div>
        <div class="meta" id="displayEmail">pxhung123456@gmail.com</div>
        <div class="meta" id="displayPhone">0123456</div>
      </div>

      <div class="right">
        <div class="stat">
          <div class="stat-label">Gestational age</div>
          <div class="stat-value" id="displayWeeks">100</div>
        </div>

        <div class="stat">
          <div class="stat-label">Expected due date</div>
          <div class="stat-value" id="displayDue">21/1/2029</div>
        </div>

        <div class="progress-wrap">
          <div class="progress-head">
            <div class="progress-title">Pregnancy progress</div>
            <div class="progress-percent" id="progressText">—</div>
          </div>
          <div class="progress" aria-hidden="true">
            <i id="progressBar" style="width:0%"></i>
          </div>
          <div class="small" id="progressDetail">Add details in Edit to see progress.</div>
        </div>

        <div class="actions-row">
          <button id="exportProfile" class="btn small">Export</button>
          <button id="toggleReminders" class="btn outline small">Edit Profile</button>
        </div>
      </div>
    </section>
  </main>