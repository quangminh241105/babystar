<link rel="stylesheet" href="/css/profile.css">

<main class="profile-container">
  <header class="profile-header">
    <div class="profile-avatar">
      <img id="profileImage" src="/images/default-avatar.png" alt="Profile">
    </div>
    <div class="profile-info">
      <h1 id="userName">Loading...</h1>
      <p id="userEmail" class="text-muted"></p>
      <a href="/auth/user-edit" class="btn-primary">Edit Profile</a>
    </div>
  </header>

  <div class="profile-grid">
    <!-- Personal Info Card -->
    <section class="card">
      <h2 class="card-title">Personal Information</h2>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Full Name</span>
          <span class="info-value" id="infoName">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Email</span>
          <span class="info-value" id="infoEmail">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Phone</span>
          <span class="info-value" id="infoPhone">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Date of Birth</span>
          <span class="info-value" id="infoDOB">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Age</span>
          <span class="info-value" id="infoAge">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Current Weight</span>
          <span class="info-value" id="infoWeight">-</span>
        </div>
      </div>
    </section>

    <!-- Pregnancy Info Card -->
    <section class="card">
      <h2 class="card-title">Pregnancy Information</h2>
      <div class="pregnancy-progress">
        <div class="progress-header">
          <span class="week-display" id="weekDisplay">Week -</span>
          <span class="trimester-badge" id="trimesterBadge">Trimester -</span>
        </div>
        <div class="progress-bar-container">
          <div class="progress-bar" id="progressBar"></div>
        </div>
        <div class="days-left" id="daysLeft">- days until due date</div>
      </div>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">LMP</span>
          <span class="info-value" id="infoLMP">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Due Date</span>
          <span class="info-value" id="infoDueDate">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Blood Type</span>
          <span class="info-value" id="infoBloodType">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Height</span>
          <span class="info-value" id="infoHeight">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Pre-Pregnancy Weight</span>
          <span class="info-value" id="infoPreWeight">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">High Risk</span>
          <span class="info-value" id="infoHighRisk">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Gravida / Para</span>
          <span class="info-value" id="infoGravidaPara">-</span>
        </div>
      </div>
      <div class="info-section" id="allergiesSection" style="display:none">
        <span class="info-label">Allergies</span>
        <div class="tags" id="allergiesTags"></div>
      </div>
      <div class="info-section" id="conditionsSection" style="display:none">
        <span class="info-label">Medical Conditions</span>
        <div class="tags" id="conditionsTags"></div>
      </div>
    </section>

    <!-- Healthcare Provider Card -->
    <section class="card">
      <h2 class="card-title">Healthcare Provider</h2>
      <div class="info-grid">
        <div class="info-item">
          <span class="info-label">Physician / Midwife</span>
          <span class="info-value" id="infoPhysician">-</span>
        </div>
        <div class="info-item">
          <span class="info-label">Hospital / Birth Center</span>
          <span class="info-value" id="infoHospital">-</span>
        </div>
      </div>
    </section>
  </div>
</main>

<script>
(async function() {
  try {
    const resp = await fetch('/auth/user-edit/data', { credentials: 'include' });
    const { success, data } = await resp.json();
    if (!success) return;

    const fmt = (d) => d ? new Date(d).toLocaleDateString() : '-';
    const pp = data.pregnancyProfile || {};

    // Header
    document.getElementById('profileImage').src = data.profileImageUrl || '/images/default-avatar.png';
    document.getElementById('userName').textContent = data.fullName || 'User';
    document.getElementById('userEmail').textContent = data.email;

    // Personal Info
    document.getElementById('infoName').textContent = data.fullName || '-';
    document.getElementById('infoEmail').textContent = data.email || '-';
    document.getElementById('infoPhone').textContent = data.phoneNumber || '-';
    document.getElementById('infoDOB').textContent = fmt(data.dateOfBirth);
    document.getElementById('infoAge').textContent = data.age ? `${data.age} years` : '-';
    document.getElementById('infoWeight').textContent = data.currentWeightKg ? `${data.currentWeightKg} kg` : '-';

    // Pregnancy Info
    if (data.currentWeek) {
      document.getElementById('weekDisplay').textContent = `Week ${data.currentWeek.weeks}`;
      document.getElementById('progressBar').style.width = `${Math.min(100, (data.currentWeek.weeks / 40) * 100)}%`;
    }
    document.getElementById('trimesterBadge').textContent = data.trimester ? `Trimester ${data.trimester}` : '-';
    document.getElementById('daysLeft').textContent = data.daysUntilDue != null ? `${data.daysUntilDue} days until due date` : '-';
    
    document.getElementById('infoLMP').textContent = fmt(pp.lastMenstrualPeriod);
    document.getElementById('infoDueDate').textContent = fmt(pp.dueDate);
    document.getElementById('infoBloodType').textContent = pp.bloodType || '-';
    document.getElementById('infoHeight').textContent = pp.heightCm ? `${pp.heightCm} cm` : '-';
    document.getElementById('infoPreWeight').textContent = pp.prePregnancyWeightKg ? `${pp.prePregnancyWeightKg} kg` : '-';
    document.getElementById('infoHighRisk').textContent = pp.isHighRisk ? 'Yes' : 'No';
    document.getElementById('infoGravidaPara').textContent = `G${pp.gravida || 1} P${pp.para || 0}`;

    // Allergies
    if (pp.allergies?.length) {
      document.getElementById('allergiesSection').style.display = 'block';
      document.getElementById('allergiesTags').innerHTML = pp.allergies.map(a => `<span class="tag">${a}</span>`).join('');
    }

    // Conditions
    if (pp.medicalConditions?.length) {
      document.getElementById('conditionsSection').style.display = 'block';
      document.getElementById('conditionsTags').innerHTML = pp.medicalConditions.map(c => `<span class="tag">${c}</span>`).join('');
    }

    // Healthcare
    document.getElementById('infoPhysician').textContent = pp.primaryPhysician || '-';
    document.getElementById('infoHospital').textContent = pp.hospitalName || '-';

  } catch (err) {
    console.error('Error loading profile:', err);
  }
})();
</script>