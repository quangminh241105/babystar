<link rel="stylesheet" href="/css/login.css">

<div class="auth-layout">
  <!-- Left decorative panel -->
  <div class="auth-left">
    <div class="blob blob-1"></div>
    <div class="blob blob-2"></div>
    <div class="blob blob-3"></div>
    <div class="blob blob-4"></div>
    
    <div class="logo-section">
      <div class="logo-circles"></div>
      <span class="logo-text navbar-title">BabyStar</span>
    </div>
    
    <div class="welcome-content">
      <h1 class="welcome-title">Join Us</h1>
      <h1 class="welcome-subtitle">Create an account<br>to get started</h1>
    </div>
    
    <a href="/" class="website-link">Back to Landing Page</a>
  </div>
  
  <!-- Right form panel -->
  <div class="auth-right">
    <div id="inner-box">
      <h3>Create Your Account</h3>
      <h4>Join BabyStar and start your journey</h4>

      <!-- Google Sign-In Button -->
      <div id="google-signin-container">
        <button type="button" id="google-btn" class="google-signin-btn" onclick="triggerGoogleSignIn()">
          <svg class="google-icon" viewBox="0 0 24 24" width="20" height="20">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span>Continue with Google</span>
        </button>
        
        <div id="g_id_onload"
             data-client_id="<%= typeof process !== 'undefined' && process.env ? process.env.GOOGLE_CLIENT_ID : '' %>"
             data-callback="handleGoogleSignIn"
             data-auto_prompt="false"
             data-ux_mode="popup"
             style="display:none;">
        </div>
        <div id="google-one-tap" class="g_id_signin" style="display:none;"></div>
      </div>

      <div class="divider">
        <span>or register with email</span>
      </div>

      <form id="registerForm" novalidate>
        <input type="hidden" id="redirect" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/' %>">
        
        <div class="registration">
          <label for="fullname">Full Name</label>
          <input type="text" id="fullname" name="fullname" placeholder="Enter your full name" />
          <div id="fullname-error" class="field-error"></div>
        </div>

        <div class="registration">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="Enter your email" />
          <div id="email-error" class="field-error"></div>
        </div>

        <div class="registration">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Create a password" />
          <div id="password-error" class="field-error"></div>
        </div>

        <div class="registration">
          <label for="password2">Confirm Password</label>
          <input type="password" id="password2" name="password2" placeholder="Confirm your password" />
          <div id="password2-error" class="field-error"></div>
        </div>

        <div id="general-error" class="field-error"></div>

        <input type="submit" class="button" value="Create Account">

        <p>Already have an account? <a href="/auth/login<%= typeof redirect !== 'undefined' && redirect !== '/' ? '?redirect=' + encodeURIComponent(redirect) : '' %>"><span>Sign in</span></a></p>
      </form>
    </div>
  </div>
</div>

<script src="https://accounts.google.com/gsi/client" async defer></script>

<script>
function triggerGoogleSignIn() {
  const googleBtn = document.querySelector('#google-one-tap div[role="button"]');
  if (googleBtn) {
    googleBtn.click();
  } else if (typeof google !== 'undefined' && google.accounts) {
    google.accounts.id.prompt();
  } else {
    document.getElementById('general-error').textContent = 'Google Sign-In not available. Please try again.';
  }
}

async function handleGoogleSignIn(response) {
  const redirect = document.getElementById('redirect')?.value || '/';
  const errorEl = document.getElementById('general-error');
  const btn = document.getElementById('google-btn');
  
  if (btn) {
    btn.disabled = true;
    btn.querySelector('span').textContent = 'Creating account...';
  }
  
  try {
    const resp = await fetch('/auth/google', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ credential: response.credential, redirect })
    });
    
    const data = await resp.json();
    
    if (data.success) {
      window.location.href = data.redirect || '/';
    } else {
      if (errorEl) errorEl.textContent = data.errors?.general || 'Google signup failed';
      if (btn) {
        btn.disabled = false;
        btn.querySelector('span').textContent = 'Continue with Google';
      }
    }
  } catch (err) {
    console.error('Google signup error:', err);
    if (errorEl) errorEl.textContent = 'Network error. Please try again.';
    if (btn) {
      btn.disabled = false;
      btn.querySelector('span').textContent = 'Continue with Google';
    }
  }
}
</script>

<script src="/js/auth/register.js"></script>