<link rel="stylesheet" href="/css/adminuser.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
.admin-users-main {
  max-width: 1000px;
  margin: 0 auto;
  padding: 32px 20px;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
}

.admin-header {
  margin-bottom: 32px;
}

.admin-header h1 {
  font-size: 2rem;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8px;
}

.admin-header p {
  font-size: 1rem;
  color: #666;
  margin: 0;
}

.generator-card {
  background: white;
  border-radius: 16px;
  padding: 32px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  margin-bottom: 24px;
  border: 1px solid #e8e8e8;
}

.form-group {
  margin-bottom: 24px;
}

.form-group label {
  display: block;
  font-weight: 600;
  font-size: 0.95rem;
  color: #333;
  margin-bottom: 8px;
}

.form-group select,
.form-group input[type="number"] {
  width: 100%;
  padding: 12px 16px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 1rem;
  font-family: 'Inter', sans-serif;
  transition: all 0.2s;
  background: white;
}

.form-group select:focus,
.form-group input[type="number"]:focus {
  outline: none;
  border-color: #D91E8F;
  box-shadow: 0 0 0 3px rgba(217, 30, 143, 0.1);
}

.form-group small {
  display: block;
  margin-top: 6px;
  font-size: 0.875rem;
  color: #666;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.message {
  padding: 14px 18px;
  border-radius: 8px;
  margin-bottom: 16px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
}

.message.success {
  background: #e0ffe8;
  color: #2e7d32;
  border: 1px solid #a5d6a7;
}

.message.error {
  background: #ffe0e0;
  color: #d91e8f;
  border: 1px solid #ffb3b3;
}

.button-group {
  display: flex;
  gap: 12px;
  margin-top: 24px;
}

.btn-primary,
.btn-secondary {
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.2s;
  border: none;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  justify-content: center;
  font-family: 'Inter', sans-serif;
}

.btn-primary {
  background: linear-gradient(135deg, #E00072 0%, #D91E8F 100%);
  color: white;
}

.btn-primary:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(217, 30, 143, 0.3);
}

.btn-secondary {
  background: white;
  color: #D91E8F;
  border: 2px solid #D91E8F;
}

.btn-secondary:hover {
  background: #FFF5F9;
}

.btn-primary:disabled {
  background: #ccc;
  cursor: not-allowed;
  transform: none;
  opacity: 0.6;
}

.btn-icon {
  font-size: 1.1rem;
}

.loading {
  text-align: center;
  padding: 40px;
  background: #f9f9f9;
  border-radius: 12px;
  margin-top: 20px;
}

.spinner {
  width: 50px;
  height: 50px;
  margin: 0 auto 16px;
  border: 4px solid #f3f3f3;
  border-top: 4px solid #D91E8F;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading p {
  color: #666;
  font-size: 1rem;
  margin: 0;
}

.quiz-preview {
  margin-top: 32px;
  padding-top: 32px;
  border-top: 2px solid #e0e0e0;
}

.quiz-preview h2 {
  color: #D91E8F;
  margin-bottom: 16px;
  font-size: 1.5rem;
  font-weight: 700;
}

#previewContent {
  background: #f9f9f9;
  padding: 24px;
  border-radius: 8px;
  margin-bottom: 20px;
  border: 1px solid #e8e8e8;
}

.preview-item {
  margin-bottom: 12px;
  font-size: 1rem;
}

.preview-item strong {
  color: #333;
  font-weight: 600;
}

.info-section {
  background: #FFF5F9;
  border-radius: 16px;
  padding: 32px;
  border: 2px solid #FFE3F0;
}

.info-section h3 {
  color: #D91E8F;
  margin-top: 0;
  margin-bottom: 16px;
  font-size: 1.25rem;
  font-weight: 700;
}

.info-section ol,
.info-section ul {
  color: #666;
  line-height: 1.8;
  padding-left: 24px;
}

.info-section li {
  margin-bottom: 8px;
}

.info-section li strong {
  color: #333;
  font-weight: 600;
}

@media (max-width: 768px) {
  .form-row {
    grid-template-columns: 1fr;
  }

  .button-group {
    flex-direction: column;
  }

  .generator-card {
    padding: 24px 20px;
  }

  .info-section {
    padding: 24px 20px;
  }
}
</style>

<main class="container admin-users-main">
  <div style="margin-bottom: 16px;">
    <a href="/admin" style="color: #D91E8F; text-decoration: none; font-weight: 600;">← Back to Admin Dashboard</a>
  </div>
  
  <header class="admin-header">
    <h1>🤖 AI Quiz Generator</h1>
    <p>Generate pregnancy quizzes automatically using AI</p>
  </header>

  <div class="generator-card">
    <form id="quizGeneratorForm">
      <div class="form-group">
        <label for="category">Quiz Category *</label>
        <select id="category" name="category" required>
          <option value="">Select category...</option>
          <option value="nutrition">Pregnancy Nutrition</option>
          <option value="exercise">Pregnancy Exercise</option>
          <option value="baby_development">Baby Development</option>
        </select>
        <small>Choose the topic area for the quiz</small>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="numQuestions">Number of Questions *</label>
          <input type="number" id="numQuestions" name="numQuestions" 
                min="5" max="15" value="10" required>
          <small>Between 5 and 15 questions</small>
        </div>

        <div class="form-group">
          <label for="difficulty">Difficulty Level *</label>
          <select id="difficulty" name="difficulty" required>
            <option value="easy">Easy</option>
            <option value="medium" selected>Medium</option>
            <option value="hard">Hard</option>
          </select>
          <small>Question complexity</small>
        </div>
      </div>

      <div class="button-group">
        <button type="submit" id="generateBtn" class="btn-primary">
          <span class="btn-icon">✨</span>
          Generate Quiz with AI
        </button>
        <a href="/admin/quizzes" class="btn-secondary">View All Quizzes</a>
      </div>
    </form>

    <div id="loadingIndicator" class="loading" style="display: none;">
      <div class="spinner"></div>
      <p>AI is generating your quiz... This may take around 60 seconds</p>
    </div>

    <div id="quizPreview" class="quiz-preview" style="display: none;">
      <h2>Generated Quiz Preview</h2>
      <div id="previewContent"></div>
    </div>
  </div>

  <div class="info-section">
    <h3>ℹ️ How It Works</h3>
    <ol>
      <li><strong>Select Category:</strong> Choose nutrition, exercise, or baby development</li>
      <li><strong>Set Parameters:</strong> Number of questions (5-15) and difficulty level</li>
      <li><strong>Generate:</strong> AI creates educational questions with explanations</li>
      <li><strong>Auto-Save:</strong> Quiz is automatically saved to database</li>
      <li><strong>Review:</strong> Preview and test the generated quiz</li>
    </ol>

    <h3>✨ AI Features</h3>
    <ul>
      <li>Generates medically accurate pregnancy information</li>
      <li>Creates 4 multiple-choice options per question</li>
      <li>Includes detailed explanations for correct answers</li>
      <li>Ensures questions are practical and helpful</li>
      <li>Covers diverse topics within each category</li>
    </ul>
  </div>
</main>

