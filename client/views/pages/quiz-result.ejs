<link rel="stylesheet" href="/css/quiz-result.css">

<h1>Quiz Results: <%= quiz.title %></h1>

<div class="attempts-container">

    <% if (attempts && attempts.length > 0) { %>
        <% attempts.forEach(attempt => { %>
            <div class="attempt-card">
                <div class="attempt-header">
                    <div class="quiz-name">
                        <!-- Book Icon -->
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M4 4.5A2.5 2.5 0 0 1 6.5 7H20"/>
                            <path d="M6.5 7A2.5 2.5 0 0 0 4 9.5V19.5"/>
                            <path d="M20 7V17"/>
                        </svg>
                        <%= quiz.title %>
                    </div>

                    <div class="score">
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M12 3l3 7h7l-5.5 4.2L18 21l-6-4-6 4 1.5-6.8L2 10h7z"/>
                        </svg>
                        <%= attempt.score %>/<%= attempt.totalQuestions %>
                    </div>
                </div>

                <div class="attempt-details">
                    <p>
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M3 8h18"/>
                            <path d="M21 5H3v14h18V5z"/>
                            <path d="M7 2v3"/>
                            <path d="M17 2v3"/>
                        </svg>
                        <strong>Date Started:</strong> <%= new Date(attempt.startedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                    </p>

                    <p>
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                        <strong>Start Time:</strong> <%= new Date(attempt.startedAt).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) %>
                    </p>

                    <% if (attempt.completedAt) { %>
                    <p>
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M5 13l4 4L19 7"/>
                        </svg>
                        <strong>Completion Time:</strong> <%= new Date(attempt.completedAt).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true }) %>
                    </p>
                    <% } %>
                </div>

                <!-- Status Tag -->
                <div class="status-tag <%= attempt.status === 'completed' ? 'completed' : 'in-progress' %>">
                    <% if (attempt.status === 'completed') { %>
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M5 13l4 4L19 7"/>
                        </svg>
                        Completed
                    <% } else { %>
                        <svg class="icon" fill="none" stroke-width="2" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M12 6v6l2 1"/>
                        </svg>
                        In Progress
                    <% } %>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <p class="no-attempts">No attempts found for this quiz.</p>
    <% } %>

</div>


