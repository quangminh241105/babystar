<link rel="stylesheet" href="/css/weekly-advice.css">

<main class="container" role="main" aria-labelledby="pageTitle">
    <header class="top">
      <div>
        <h1 id="pageTitle" class="title">Weekly pregnancy advice</h1>
        <p class="subtitle">Personalized tips to support you this week — based on logged symptoms and pregnancy progress.</p>
      </div>
    </header>

    <!-- Loading State -->
    <div id="loadingState" style="text-align: center; padding: 40px;">
      <div style="font-size: 48px; margin-bottom: 16px;">⏳</div>
      <p style="font-size: 18px; color: #666;">Generating your personalized advice...</p>
    </div>

    <!-- Error State -->
    <div id="errorState" style="display: none; text-align: center; padding: 40px;">
      <div style="font-size: 48px; margin-bottom: 16px;">⚠️</div>
      <p style="font-size: 18px; color: #666;">Failed to load advice. Please try again later.</p>
      <button onclick="location.reload()" style="margin-top: 20px; padding: 10px 20px; border-radius: 8px; border: none; background: #FF7AA2; color: white; cursor: pointer;">Retry</button>
    </div>

    <!-- Main Content (Hidden until loaded) -->
    <section id="mainContent" class="advice-grid" style="display: none;">
      <!-- Risk Assessment Banner (if available) -->
      <div id="riskBanner" style="display: none; grid-column: 1/-1; margin-bottom: 20px;"></div>

      <!-- Section 1: Advice for logged symptoms -->
      <article class="card advice-symptoms" aria-labelledby="symptomTitle">
        <div class="card-head">
          <div class="icon" aria-hidden="true">
            <!-- symptom / heart icon -->
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M12 21s-7-4.35-9-7.36C-0.53 8.45 3 4 7.5 4c2.22 0 3.96 1.23 4.5 2.02C12.54 5.23 14.28 4 16.5 4 21 4 24.53 8.45 21 13.64 19 16.65 12 21 12 21z" fill="#FF7AA2"/>
            </svg>
          </div>
          <div class="heading">
            <h2 id="symptomTitle">Advice for your symptoms</h2>
            <div class="muted">Personalized suggestions based on your recent health logs</div>
          </div>
        </div>

        <div id="symptomList" class="card-body">
          <!-- Populated by JS -->
        </div>

      </article>

      <!-- Section 2: General week-based advice -->
      <article class="card advice-week" aria-labelledby="weekTitle">
        <div class="card-head">
          <div class="icon" aria-hidden="true">
            <!-- calendar / week icon -->
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M3 8h18v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8z" stroke="#FFB1C9" stroke-width="1.2" fill="#FFF0F7"/>
              <path d="M16 3v3M8 3v3" stroke="#FF7AA2" stroke-width="1.6" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="heading">
            <h2 id="weekTitle">This week's guidance</h2>
            <div class="muted" id="weekLabel">Loading...</div>
          </div>
        </div>

        <div id="weekAdvice" class="card-body">
          <!-- Populated by JS -->
        </div>

      </article>

      <!-- Section 3: Focus areas — 4 boxes -->
      <article class="card advice-focus" aria-labelledby="focusTitle">
        <div class="card-head">
          <div class="icon" aria-hidden="true">
            <!-- target / focus icon -->
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <circle cx="12" cy="12" r="9" stroke="#FF7AA2" stroke-width="1.2" fill="transparent"/>
              <circle cx="12" cy="12" r="4" fill="#FFB1C9"/>
            </svg>
          </div>
          <div class="heading">
            <h2 id="focusTitle">Recommended focus areas</h2>
            <div class="muted">Areas to prioritize for health and wellbeing</div>
          </div>
        </div>

        <div class="focus-grid" id="focusGrid" aria-live="polite">
          <!-- Populated by JS -->
        </div>

      </article>
    </section>

    <footer class="note" id="footerNote" style="display: none;">Tip: Log your symptoms regularly to get more personalized advice.</footer>
  </main>

<script>
  // Load and render weekly advice
  document.addEventListener('DOMContentLoaded', async () => {
    const loadingState = document.getElementById('loadingState');
    const errorState = document.getElementById('errorState');
    const mainContent = document.getElementById('mainContent');
    const footerNote = document.getElementById('footerNote');

    try {
      // Fetch advice from API
      const response = await fetch('/api/weekly-advice');
      const result = await response.json();

      if (!response.ok || !result.success) {
        throw new Error(result.message || 'Failed to load advice');
      }

      const advice = result.data;

      // Hide loading, show content
      loadingState.style.display = 'none';
      mainContent.style.display = 'block';
      footerNote.style.display = 'block';

      // Render risk assessment if available
      if (advice.riskAssessment) {
        renderRiskAssessment(advice.riskAssessment);
      }

      // Render symptom advice
      renderSymptomAdvice(advice.symptomAdvice || []);

      // Render weekly guidance
      renderWeeklyGuidance(advice.weeklyGuidance || {}, advice.weekNumber || 0, advice.trimester || 1);

      // Render focus areas
      renderFocusAreas(advice.focusAreas || []);

    } catch (error) {
      console.error('Error loading weekly advice:', error);
      loadingState.style.display = 'none';
      errorState.style.display = 'block';
    }
  });

  function renderRiskAssessment(risk) {
    const banner = document.getElementById('riskBanner');
    
    // Determine color and emoji based on risk level
    const riskStyles = {
      low: { color: '#10B981', bg: '#D1FAE5', emoji: '✅', text: 'Low Risk' },
      mid: { color: '#F59E0B', bg: '#FEF3C7', emoji: '⚠️', text: 'Moderate Risk' },
      high: { color: '#EF4444', bg: '#FEE2E2', emoji: '🚨', text: 'High Risk' }
    };
    
    const style = riskStyles[risk.level] || riskStyles.mid;
    
    banner.innerHTML = `
      <div style="background: ${style.bg}; border-left: 4px solid ${style.color}; padding: 16px 20px; border-radius: 8px;">
        <div style="display: flex; align-items: start; gap: 12px;">
          <div style="font-size: 24px;">${style.emoji}</div>
          <div style="flex: 1;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
              <strong style="font-size: 16px; color: ${style.color};">${style.text}</strong>
              <span style="font-size: 12px; color: #666;">(${(risk.confidence * 100).toFixed(0)}% confidence)</span>
            </div>
            ${risk.vitals ? `
              <div style="font-size: 14px; color: #666; margin-bottom: 8px;">
                BP: ${risk.vitals.bloodPressure} | HR: ${risk.vitals.heartRate ? risk.vitals.heartRate + ' bpm' : 'N/A'} | BS: ${risk.vitals.bloodSugar ? risk.vitals.bloodSugar + ' mmol/L' : 'N/A'}
              </div>
            ` : ''}
            ${risk.factors && risk.factors.length > 0 ? `
              <div style="font-size: 14px; color: ${style.color}; margin-bottom: 8px;">
                <strong>Risk factors:</strong> ${risk.factors.join(', ')}
              </div>
            ` : ''}
            ${risk.recommendations && risk.recommendations.length > 0 ? `
              <div style="font-size: 14px; color: #333;">
                <strong>Recommendations:</strong> ${risk.recommendations.join(' • ')}
              </div>
            ` : ''}
          </div>
        </div>
      </div>
    `;
    
    banner.style.display = 'block';
  }

  function renderSymptomAdvice(symptomAdvice) {
    const container = document.getElementById('symptomList');
    
    if (symptomAdvice.length === 0) {
      container.innerHTML = '<div class="advice-item"><p style="color: #999;">No specific symptoms logged recently. Keep logging your health to get personalized advice!</p></div>';
      return;
    }

    container.innerHTML = symptomAdvice.map(item => `
      <div class="advice-item">
        <strong>${item.symptom}</strong>
        <p>${item.advice}</p>
      </div>
    `).join('');
  }

  function renderWeeklyGuidance(guidance, weekNumber, trimester) {
    const weekLabel = document.getElementById('weekLabel');
    const container = document.getElementById('weekAdvice');

    weekLabel.textContent = `Week ${weekNumber} • Trimester ${trimester}`;

    const items = [];
    
    if (guidance.fetalDevelopment) {
      items.push({ title: 'Fetal development', content: guidance.fetalDevelopment });
    }
    
    if (guidance.selfCare) {
      items.push({ title: 'Self care', content: guidance.selfCare });
    }
    
    if (guidance.nutritionTip) {
      items.push({ title: 'Nutrition tip', content: guidance.nutritionTip });
    }
    
    if (guidance.activityTip) {
      items.push({ title: 'Activity tip', content: guidance.activityTip });
    }
    
    if (guidance.riskManagement) {
      items.push({ title: 'Risk management', content: guidance.riskManagement });
    }

    if (items.length === 0) {
      container.innerHTML = '<div class="advice-item"><p>Loading guidance...</p></div>';
      return;
    }

    container.innerHTML = items.map(item => `
      <div class="advice-item">
        <strong>${item.title}</strong>
        <p>${item.content}</p>
      </div>
    `).join('');
  }

  function renderFocusAreas(focusAreas) {
    const container = document.getElementById('focusGrid');
    
    if (focusAreas.length === 0) {
      container.innerHTML = '<p style="grid-column: 1/-1; text-align: center; color: #999;">Loading focus areas...</p>';
      return;
    }

    container.innerHTML = focusAreas.map(area => `
      <div class="focus-box">
        <div class="box-icon">${area.icon || '📌'}</div>
        <div class="box-title">${area.title}</div>
        <div class="box-desc">${area.description}</div>
        <div class="box-actions">
          <button class="btn tiny" disabled style="opacity: 0.5;">${area.action || 'Learn more'}</button>
        </div>
      </div>
    `).join('');
  }
</script>
            <div class="box-actions">
              <button class="btn tiny">View exercises</button>
            </div>
          </div>

          <div class="focus-box" data-focus="sleep">
            <div class="box-icon">🛏️</div>
            <div class="box-title">Rest & sleep</div>
            <div class="box-desc">Practice bedtime routines; side-sleeping with pillows can be helpful in later weeks.</div>
            <div class="box-actions">
              <button class="btn tiny">Sleep tips</button>
            </div>
          </div>

          <div class="focus-box" data-focus="mental">
            <div class="box-icon">🧘‍♀️</div>
            <div class="box-title">Mental wellbeing</div>
            <div class="box-desc">Breathing exercises, peer support and pausing for self-care reduce stress and anxiety.</div>
            <div class="box-actions">
              <button class="btn tiny">Try a short practice</button>
            </div>
          </div>
        </div>

      </article>
    </section>

    <footer class="note">Tip: Edit your profile to improve personalization of advice. Data used locally in-app unless you opt-in to sharing.</footer>
  </main>