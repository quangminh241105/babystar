<style>
  .error-container {
    max-width: 600px;
    margin: 80px auto;
    padding: 40px;
    text-align: center;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .error-code {
    font-size: 6rem;
    font-weight: 700;
    color: #e8c0d8;
    margin: 0;
    line-height: 1;
  }
  .error-title {
    font-size: 1.5rem;
    color: #333;
    margin: 20px 0 10px;
  }
  .error-message {
    color: #666;
    margin-bottom: 30px;
  }
  .error-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .error-btn {
    padding: 12px 24px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }
  .error-btn-primary {
    background: linear-gradient(135deg, #E03FD8, #9333ea);
    color: white;
  }
  .error-btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(224, 63, 216, 0.3);
  }
  .error-btn-secondary {
    background: #f5f5f5;
    color: #333;
  }
  .error-btn-secondary:hover {
    background: #eee;
  }
</style>

<div class="error-container">
  <p class="error-code"><%= typeof statusCode !== 'undefined' ? statusCode : '404' %></p>
  <h1 class="error-title"><%= typeof errorTitle !== 'undefined' ? errorTitle : 'Page Not Found' %></h1>
  <p class="error-message"><%= typeof errorMessage !== 'undefined' ? errorMessage : "Sorry, the page you're looking for doesn't exist or is still under development." %></p>
  
  <div class="error-actions">
    <a href="/" class="error-btn error-btn-primary">Go Home</a>
    <a href="javascript:history.back()" class="error-btn error-btn-secondary">Go Back</a>
  </div>
</div>
