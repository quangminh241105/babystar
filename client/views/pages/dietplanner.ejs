<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diet Planner - BabyStar</title>
  <link rel="stylesheet" href="/css/dietplanner.css">
  <style>
    .loading-state {
      text-align: center;
      padding: 40px;
      color: #666;
    }
    .error-state {
      text-align: center;
      padding: 40px;
      background: #fff3cd;
      border-radius: 8px;
      margin: 20px;
    }
    .error-state h2 {
      color: #856404;
      margin-bottom: 10px;
    }
    .error-state p {
      color: #856404;
      margin-bottom: 20px;
    }
    .btn-retry, .btn-generate {
      background: #ff6b9d;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      cursor: pointer;
      margin: 5px;
      font-size: 16px;
    }
    .btn-retry:hover, .btn-generate:hover {
      background: #ff5289;
    }
    .hidden { display: none; }
    
    @keyframes slideIn {
      from {
        transform: translateX(100%);
        opacity: 0;
      }
      to {
        transform: translateX(0);
        opacity: 1;
      }
    }
    
    @keyframes slideOut {
      from {
        transform: translateX(0);
        opacity: 1;
      }
      to {
        transform: translateX(100%);
        opacity: 0;
      }
    }
  </style>
</head>
<body>
  

  <div class="planner-content">
    <!-- Loading State -->
    <div id="loadingState" class="loading-state">
      <div style="font-size: 48px; margin-bottom: 20px;">⏳</div>
      <h2>Loading Your Personalized Nutrition Plan...</h2>
      <p>Preparing your diet plan for this week...</p>
    </div>

    <!-- Error State (Only shown for critical errors - Own Plan) -->
    <div id="errorState" class="error-state hidden">
      <div style="font-size: 48px; margin-bottom: 20px;">⚠️</div>
      <h2 id="errorTitle">Notice</h2>
      <p id="errorMessage">Please check your profile settings.</p>
      <div>
        <button class="btn-retry" onclick="loadNutritionPlan()">Try Again</button>
        <button class="btn-generate" onclick="window.location.href='/auth/profile'">Go to Profile</button>
      </div>
    </div>

    <!-- Error State (Partner has no plan) -->
    <div id="partnerErrorState" class="error-state hidden" style="background: #e3f2fd;">
      <div style="font-size: 64px; margin-bottom: 20px;">👥</div>
      <h2 style="color: #1565c0; margin-bottom: 15px;">Partner Has No Nutrition Plan</h2>
      <p style="color: #1565c0; margin-bottom: 30px;">
        Your partner hasn't generated a nutrition plan yet. They need to log in and create their personalized plan first.
      </p>
    </div>

    <!-- Main Content (Hidden until loaded) -->
    <div id="mainContent" class="hidden">
      <!-- AI Badge -->
      <div class="ai-badge">
        <span class="ai-icon">✨</span>
        <div class="ai-text">
          <div class="ai-badge-header">
            <strong>AI-Customized Nutrition Plan</strong>
            <span class="ai-powered-tag">AI-Powered</span>
          </div>
          <p id="aiBadgeDescription">This meal plan is automatically tailored to your current pregnancy stage.</p>
        </div>
      </div>

      <!-- Page Header -->
      <header class="page-header">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
          <div>
            <h1>Personalized Diet Plan</h1>
            <p class="subtitle" id="pageSubtitle">AI-customized nutrition guide</p>
          </div>
          <% if (!isPartnerView) { %>
            <button onclick="generateNewPlan()" style="background: #ff6b9d; color: white; border: none; padding: 12px 24px; border-radius: 6px; cursor: pointer; font-weight: 600; white-space: nowrap;">
              🔄 Regenerate Plan
            </button>
          <% } %>
        </div>
      </header>

      <!-- Intake Summary (if available) -->
      <section id="intakeSummarySection" class="intake-summary-section" style="display: none; margin-bottom: 30px;">
        <h2 class="section-title">
          <span class="title-icon">📊</span>
          Your Nutrition Summary
        </h2>
        <div id="intakeSummaryContent"></div>
      </section>

      <!-- Daily Nutrition Goals -->
      <section class="nutrition-goals">
        <h2 class="section-title">Daily Nutrition Goals</h2>
        <p class="section-subtitle" style =" padding-bottom: 20px ">Recommended intake for healthy pregnancy</p>

        <div class="goals-grid" id="nutritionGoals">
          <!-- Goals will be loaded dynamically -->
        </div>
      </section>

      <!-- Weekly Meal Plan -->
      <section class="meal-section">
        <h2 class="section-title">
          <span class="title-icon">📅</span>
          7-Day Meal Plan
        </h2>
        <div id="weeklyMealPlan">
          <!-- Meal plan will be loaded dynamically -->
        </div>
      </section>

      <!-- Nutrient Focus Areas -->
      <section class="meal-section" id="nutrientFocusSection" style="display: none;">
        <h2 class="section-title">
          <span class="title-icon">🎯</span>
          Key Nutrient Focus
        </h2>
        <div id="nutrientFocus">
          <!-- Will be populated dynamically -->
        </div>
      </section>

      <!-- Foods to Avoid -->
      <section class="avoid-section">
        <h2 class="section-title warning">
          <span class="title-icon">⚠️</span>
          Foods to Avoid During Pregnancy
        </h2>
        <p class="section-subtitle">Important safety guidelines</p>

        <div class="avoid-grid">
          <div class="avoid-item">⚠️ Raw or undercooked meat, eggs, and seafood</div>
          <div class="avoid-item">⚠️ Unpasteurized dairy products</div>
          <div class="avoid-item">⚠️ High-mercury fish (shark, swordfish, king mackerel)</div>
          <div class="avoid-item">⚠️ Excessive caffeine (limit to 200mg/day)</div>
          <div class="avoid-item">⚠️ Alcohol</div>
          <div class="avoid-item">⚠️ Unwashed fruits and vegetables</div>
        </div>
      </section>

      <!-- Hydration -->
      <section class="hydration-section">
        <h2 class="section-title">
          <span class="title-icon">💧</span>
          Hydration
        </h2>
        <p class="hydration-text">
          Aim for <strong>2.5-3 litres</strong> of water per day. Proper hydration helps prevent constipation, reduces swelling, and supports increased blood volume during pregnancy.
        </p>

        <div class="hydration-tips">
          <h3>Hydration Tips</h3>
          <ul>
            <li>Carry a water bottle throughout the day</li>
            <li>Drink water before, during, and after exercise</li>
            <li>Add lemon or cucumber for flavor</li>
            <li>Limit caffeinated beverages</li>
          </ul>
        </div>
      </section>
    </div>
  </div>

  <script src="/js/dietplanner.js"></script>
</body>
</html>
