<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Diet Planner - BabyStar</title>
  <link rel="stylesheet" href="/css/dietplanner.css">
</head>
<body>
  

  <div class="planner-content">
    <!-- AI Badge -->
    <div class="ai-badge">
      <span class="ai-icon">✨</span>
      <div class="ai-text">
        <div class="ai-badge-header">
          <strong>AI-Customized Nutrition Plan</strong>
          <span class="ai-powered-tag">AI-Powered</span>
        </div>
        <p>This meal plan is automatically tailored to your current trimester (week 24), taking into account your logged symptoms and nutritional needs. As your pregnancy progresses, our AI will adjust recommendations accordingly.</p>
      </div>
    </div>

    <!-- Page Header -->
    <header class="page-header">
      <h1>Personalized Diet Plan</h1>
      <p class="subtitle">AI-customized nutrition guide for week 24</p>
    </header>

    <!-- Daily Nutrition Goals -->
    <section class="nutrition-goals">
      <h2 class="section-title">Daily Nutrition Goals</h2>
      <p class="section-subtitle" style =" padding-bottom: 20px ">Recommended intake for healthy pregnancy</p>

      <div class="goals-grid">
        <div class="goal-card">
          <div class="goal-value">2,200-2,400</div>
          <div class="goal-label">Calories</div>
          <div class="goal-unit">per day</div>
          <div class="goal-note">Increased for 2nd trimester</div>
        </div>

        <div class="goal-card">
          <div class="goal-value">75-100g</div>
          <div class="goal-label">Protein</div>
          <div class="goal-unit">per day</div>
          <div class="goal-note">Essential for baby's growth</div>
        </div>

        <div class="goal-card">
          <div class="goal-value">1,000mg</div>
          <div class="goal-label">Calcium</div>
          <div class="goal-unit">per day</div>
          <div class="goal-note">For bone development</div>
        </div>

        <div class="goal-card">
          <div class="goal-value">27mg</div>
          <div class="goal-label">Iron</div>
          <div class="goal-unit">per day</div>
          <div class="goal-note">Prevents anemia</div>
        </div>

        <div class="goal-card">
          <div class="goal-value">600mcg</div>
          <div class="goal-label">Folate</div>
          <div class="goal-unit">per day</div>
          <div class="goal-note">Critical for neural development</div>
        </div>

        <div class="goal-card">
          <div class="goal-value">200-300mg</div>
          <div class="goal-label">DHA</div>
          <div class="goal-unit">per day</div>
          <div class="goal-note">For brain development</div>
        </div>
      </div>
    </section>

    <!-- Breakfast Options -->
    <section class="meal-section">
      <h2 class="section-title">
        <span class="title-icon">🍳</span>
        Breakfast Options
      </h2>

      <div class="meal-options-grid">
        <div class="meal-option-card">
          <div class="meal-option-name">Oatmeal with berries and almonds</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">350 cal</span>
            <span class="meal-option-tags">High in fiber, iron</span>
          </div>
        </div>

        <div class="meal-option-card">
          <div class="meal-option-name">Greek yogurt parfait with granola</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">320 cal</span>
            <span class="meal-option-tags">Protein, calcium</span>
          </div>
        </div>

        <div class="meal-option-card">
          <div class="meal-option-name">Whole grain toast with avocado and eggs</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">400 cal</span>
            <span class="meal-option-tags">Protein, healthy fats</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Lunch Options -->
    <section class="meal-section">
      <h2 class="section-title">
        <span class="title-icon">🍽️</span>
        Lunch Options
      </h2>

      <div class="meal-options-grid">
        <div class="meal-option-card">
          <div class="meal-option-name">Grilled chicken salad with quinoa</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">450 cal</span>
            <span class="meal-option-tags">Protein, vitamins</span>
          </div>
        </div>

        <div class="meal-option-card">
          <div class="meal-option-name">Lentil soup with whole grain bread</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">400 cal</span>
            <span class="meal-option-tags">Iron, fiber</span>
          </div>
        </div>

        <div class="meal-option-card">
          <div class="meal-option-name">Salmon with sweet potato and broccoli</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">500 cal</span>
            <span class="meal-option-tags">Omega-3, vitamin C</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Dinner Options -->
    <section class="meal-section">
      <h2 class="section-title">
        <span class="title-icon">🍴</span>
        Dinner Options
      </h2>

      <div class="meal-options-grid">
        <div class="meal-option-card">
          <div class="meal-option-name">Lean beef stir-fry with vegetables</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">480 cal</span>
            <span class="meal-option-tags">Iron, protein</span>
          </div>
        </div>

        <div class="meal-option-card">
          <div class="meal-option-name">Baked chicken with brown rice and greens</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">450 cal</span>
            <span class="meal-option-tags">Protein, folate</span>
          </div>
        </div>

        <div class="meal-option-card">
          <div class="meal-option-name">Turkey meatballs with whole wheat pasta</div>
          <div class="meal-option-footer">
            <span class="meal-option-cal">500 cal</span>
            <span class="meal-option-tags">Protein, B vitamins</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Healthy Snacks -->
    <section class="meal-section">
      <h2 class="section-title">
        <span class="title-icon">🍎</span>
        Healthy Snacks
      </h2>

      <div class="snacks-options-grid">
        <div class="snack-option-card">
          <div class="snack-option-name">Apple slices with peanut butter</div>
          <div class="snack-option-footer">
            <span class="snack-option-cal">180 cal</span>
            <span class="snack-option-tags">Fiber, protein</span>
          </div>
        </div>

        <div class="snack-option-card">
          <div class="snack-option-name">Carrot sticks with hummus</div>
          <div class="snack-option-footer">
            <span class="snack-option-cal">150 cal</span>
            <span class="snack-option-tags">Vitamin A, fiber</span>
          </div>
        </div>

        <div class="snack-option-card">
          <div class="snack-option-name">Mixed nuts and dried fruit</div>
          <div class="snack-option-footer">
            <span class="snack-option-cal">200 cal</span>
            <span class="snack-option-tags">Healthy fats, minerals</span>
          </div>
        </div>

        <div class="snack-option-card">
          <div class="snack-option-name">Cheese and whole grain crackers</div>
          <div class="snack-option-footer">
            <span class="snack-option-cal">170 cal</span>
            <span class="snack-option-tags">Calcium, protein</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Foods to Avoid -->
    <section class="avoid-section">
      <h2 class="section-title warning">
        <span class="title-icon">⚠️</span>
        Foods to Avoid During Pregnancy
      </h2>
      <p class="section-subtitle">Important safety guidelines</p>

      <div class="avoid-grid">
        <div class="avoid-item">⚠️ Raw or undercooked meat, eggs, and seafood</div>
        <div class="avoid-item">⚠️ Unpasteurized dairy products</div>
        <div class="avoid-item">⚠️ High-mercury fish (shark, swordfish, king mackerel)</div>
        <div class="avoid-item">⚠️ Excessive caffeine (limit to 200mg/day)</div>
        <div class="avoid-item">⚠️ Alcohol</div>
        <div class="avoid-item">⚠️ Unwashed fruits and vegetables</div>
      </div>
    </section>

    <!-- Hydration -->
    <section class="hydration-section">
      <h2 class="section-title">
        <span class="title-icon">💧</span>
        Hydration
      </h2>
      <p class="hydration-text">
        Aim for <strong>8-10 glasses (64-80 oz)</strong> of water per day. Proper hydration helps prevent constipation, reduces swelling, and supports increased blood volume during pregnancy.
      </p>

      <div class="hydration-tips">
        <h3>Hydration Tips</h3>
        <ul>
          <li>Carry a water bottle throughout the day</li>
          <li>Drink water before, during, and after exercise</li>
          <li>Add lemon or cucumber for flavor</li>
          <li>Limit caffeinated beverages</li>
        </ul>
      </div>
    </section>
  </div>

  <script src="/js/dietplanner.js"></script>
</body>
</html>
