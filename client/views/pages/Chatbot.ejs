<link rel="stylesheet" href="/css/chatbot.css">

<!-- Main Chat Container with Sidebar -->
<div class="chatContainer">
    <!-- Conversation History Sidebar -->
    <div class="conversationSidebar" id="conversationSidebar">
        <div class="sidebarHeader">
            <h3>Conversations</h3>
            <div class="sidebarActions">
                <button class="newChatBtn" id="newChatBtn" title="Start new conversation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 5v14" />
                        <path d="M5 12h14" />
                    </svg>
                </button>
                <button class="collapseSidebarBtn" id="collapseSidebarBtn" title="Collapse sidebar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 18l-6-6 6-6" />
                    </svg>
                </button>
            </div>
        </div>
        <div class="conversationList" id="conversationList">
            <div class="loadingConversations">Loading conversations...</div>
        </div>
    </div>

    <!-- Toggle Sidebar Button (for mobile) -->
    <button class="sidebarToggle" id="sidebarToggle">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
    </button>

    <!-- Chat Main Area -->
    <div class="chatMainArea">
        <!-- Header card -->
        <div class="featureCard">
            <div class="icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="purple" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 8V4H8" />
                    <rect width="16" height="12" x="4" y="8" rx="2" />
                    <path d="M2 14h2" />
                    <path d="M20 14h2" />
                    <path d="M15 13v2" />
                    <path d="M9 13v2" />
                </svg>
            </div>
            <div class="feature">
                <div class="featureName">AI Pregnancy Assistant</div>
                <div class="featureDescription">Ask me anything about pregnancy, health and wellness</div>
            </div>
        </div>

        <!-- Chat messages container -->
        <div class="chatBox" id="chatBox"></div>

        <!-- User input section - fixed at bottom -->
        <div class="userInput">
            <div>Quick Questions:</div>

            <div id="quickQuestions">
                <div class="question" data-question="What foods should I avoid during pregnancy?">What foods should I
                    avoid?</div>
                <div class="question" data-question="Is it safe to exercise during pregnancy?">Is it safe to exercise?
                </div>
                <div class="question" data-question="How can I manage morning sickness?">How can I manage morning
                    sickness?</div>
                <div class="question" data-question="What are Braxton Hicks contractions?">What are Braxton Hicks?</div>
            </div>

            <div id="messageForm">
                <form id="chatForm">
                    <input type="text" placeholder="Enter your question here" id="messageInput" disabled>
                    <button type="submit" class="sendButton" id="sendBtn" disabled>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z" />
                            <path d="m21.854 2.147-10.94 10.939" />
                        </svg>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Overlay for mobile sidebar -->
<div class="sidebarOverlay" id="sidebarOverlay"></div>

<script>
    (async function () {
        // ===== DOM Elements =====
        const chatBox = document.getElementById('chatBox');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const chatForm = document.getElementById('chatForm');
        const quickQuestions = document.querySelectorAll('.question');
        const conversationList = document.getElementById('conversationList');
        const newChatBtn = document.getElementById('newChatBtn');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const conversationSidebar = document.getElementById('conversationSidebar');
        const collapseSidebarBtn = document.getElementById('collapseSidebarBtn');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const chatContainer = document.querySelector('.chatContainer');

        // ===== State =====
        let conversationId = null; // Tracks current conversation for context
        let conversations = []; // List of user's conversations
        let sidebarCollapsed = localStorage.getItem('chatSidebarCollapsed') === 'true';

        // ===== Utility Functions =====

        // Format current time as HH:MM
        function formatTime(date) {
            const d = date ? new Date(date) : new Date();
            return d.getHours().toString().padStart(2, '0') + ':' +
                d.getMinutes().toString().padStart(2, '0');
        }

        // Format date for conversation list
        function formatDate(dateStr) {
            if (!dateStr) return '';
            const date = new Date(dateStr);
            const now = new Date();

            // Reset time to midnight for accurate day comparison
            const dateOnly = new Date(date.getFullYear(), date.getMonth(), date.getDate());
            const nowOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const diffTime = nowOnly.getTime() - dateOnly.getTime();
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays === 0) {
                // Today - show time
                return date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            }
            if (diffDays === 1) return 'Yesterday';
            if (diffDays < 7) return date.toLocaleDateString('en-US', { weekday: 'long' });
            if (diffDays < 365) return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        // Escape HTML to prevent XSS
        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Enable/disable all input elements
        function enableInput(enable) {
            messageInput.disabled = !enable;
            sendBtn.disabled = !enable;
            quickQuestions.forEach(q => q.classList.toggle('disabled', !enable));
        }

        // ===== Sidebar Toggle & Collapse =====

        // Mobile sidebar toggle
        function openMobileSidebar() {
            conversationSidebar.classList.add('open');
            sidebarOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeMobileSidebar() {
            conversationSidebar.classList.remove('open');
            sidebarOverlay.classList.remove('active');
            document.body.style.overflow = '';
        }

        sidebarToggle.addEventListener('click', () => {
            if (conversationSidebar.classList.contains('open')) {
                closeMobileSidebar();
            } else {
                openMobileSidebar();
            }
        });

        // Close sidebar when clicking overlay
        sidebarOverlay.addEventListener('click', closeMobileSidebar);

        // Collapse/expand sidebar on desktop
        function toggleSidebarCollapse() {
            sidebarCollapsed = !sidebarCollapsed;
            localStorage.setItem('chatSidebarCollapsed', sidebarCollapsed);
            conversationSidebar.classList.toggle('collapsed', sidebarCollapsed);
            chatContainer.classList.toggle('sidebar-collapsed', sidebarCollapsed);
        }

        collapseSidebarBtn.addEventListener('click', toggleSidebarCollapse);

        // Apply initial collapsed state (only on desktop)
        function applyInitialSidebarState() {
            if (window.innerWidth > 768 && sidebarCollapsed) {
                conversationSidebar.classList.add('collapsed');
                chatContainer.classList.add('sidebar-collapsed');
            }
        }
        applyInitialSidebarState();

        // Handle resize
        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                closeMobileSidebar();
                if (sidebarCollapsed) {
                    conversationSidebar.classList.add('collapsed');
                    chatContainer.classList.add('sidebar-collapsed');
                }
            } else {
                conversationSidebar.classList.remove('collapsed');
                chatContainer.classList.remove('sidebar-collapsed');
            }
        });

        // ===== Message Display Functions =====

        // Add AI assistant message to chat
        function addAIMessage(text, timestamp) {
            const bubble = document.createElement('div');
            bubble.className = 'AIChatBubble';
            bubble.innerHTML = `
            <div class="AIchatIcon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 8V4H8" />
                    <rect width="16" height="12" x="4" y="8" rx="2" />
                    <path d="M2 14h2" /><path d="M20 14h2" />
                    <path d="M15 13v2" /><path d="M9 13v2" />
                </svg>
            </div>
            <div class="chat">
                <div class="chatText">${escapeHtml(text)}</div>
                <div class="AIchatTime">${formatTime(timestamp)}</div>
            </div>`;
            chatBox.appendChild(bubble);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        // Add user message to chat
        function addUserMessage(text, timestamp) {
            const bubble = document.createElement('div');
            bubble.className = 'UserChatBubble';
            bubble.innerHTML = `
            <div class="UserchatIcon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                    stroke="purple" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                    <circle cx="12" cy="7" r="4" />
                </svg>
            </div>
            <div class="chat">
                <div class="UserChatText">${escapeHtml(text)}</div>
                <div class="UserChatTime">${formatTime(timestamp)}</div>
            </div>`;
            chatBox.appendChild(bubble);
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        // Clear chat box
        function clearChatBox() {
            chatBox.innerHTML = '';
        }

        // ===== Conversation List Functions =====

        // Render conversation list in sidebar
        function renderConversationList() {
            if (conversations.length === 0) {
                conversationList.innerHTML = '<div class="noConversations">No conversations yet. Start a new chat!</div>';
                return;
            }

            conversationList.innerHTML = conversations.map(conv => `
            <div class="conversationItem ${conv._id === conversationId ? 'active' : ''}" data-id="${conv._id}">
                <div class="convTitle">${escapeHtml(conv.title || 'Untitled')}</div>
                <div class="convMeta">
                    <span class="convDate">${formatDate(conv.lastMessageAt || conv.createdAt)}</span>
                    <span class="convMessages">${conv.stats?.messageCount || 0} messages</span>
                </div>
                <button class="deleteConvBtn" data-id="${conv._id}" title="Delete conversation">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/>
                    </svg>
                </button>
            </div>
        `).join('');

            // Add click handlers
            conversationList.querySelectorAll('.conversationItem').forEach(item => {
                item.addEventListener('click', (e) => {
                    if (!e.target.closest('.deleteConvBtn')) {
                        loadConversation(item.dataset.id);
                        // Close sidebar on mobile after selection
                        if (window.innerWidth <= 768) {
                            closeMobileSidebar();
                        }
                    }
                });
            });

            // Add delete handlers
            conversationList.querySelectorAll('.deleteConvBtn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    deleteConversation(btn.dataset.id);
                });
            });
        }

        // ===== API Functions =====

        // Check if user has valid session
        async function checkSession() {
            try {
                const resp = await fetch('/chatbot/debug-session', { credentials: 'include' });
                const data = await resp.json();
                return !!data.sessionUser;
            } catch {
                return false;
            }
        }

        // Fetch conversation list
        async function fetchConversations() {
            try {
                const resp = await fetch('/chatbot/conversations', { credentials: 'include' });
                const data = await resp.json();
                if (data.success) {
                    conversations = data.conversations;
                    renderConversationList();
                }
            } catch (err) {
                console.error('Error fetching conversations:', err);
                conversationList.innerHTML = '<div class="errorLoading">Failed to load conversations</div>';
            }
        }

        // Load a specific conversation
        async function loadConversation(id) {
            try {
                enableInput(false);
                const resp = await fetch(`/chatbot/conversations/${id}`, { credentials: 'include' });
                const data = await resp.json();

                if (data.success && data.conversation) {
                    conversationId = data.conversation._id;
                    clearChatBox();

                    // Render all messages
                    data.conversation.messages.forEach(msg => {
                        if (msg.role === 'user') {
                            addUserMessage(msg.content, msg.createdAt);
                        } else if (msg.role === 'assistant') {
                            addAIMessage(msg.content, msg.createdAt);
                        }
                    });

                    // Update active state in sidebar
                    renderConversationList();
                }
            } catch (err) {
                console.error('Error loading conversation:', err);
                addAIMessage('Failed to load conversation. Please try again.');
            } finally {
                enableInput(true);
                messageInput.focus();
            }
        }

        // Delete a conversation
        async function deleteConversation(id) {
            if (!confirm('Are you sure you want to delete this conversation?')) return;

            try {
                const resp = await fetch(`/chatbot/conversations/${id}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const data = await resp.json();

                if (data.success) {
                    // Remove from list
                    conversations = conversations.filter(c => c._id !== id);
                    renderConversationList();

                    // If deleted current conversation, start new chat
                    if (conversationId === id) {
                        startNewChat();
                    }
                }
            } catch (err) {
                console.error('Error deleting conversation:', err);
                alert('Failed to delete conversation');
            }
        }

        // Start a new chat
        function startNewChat() {
            conversationId = null;
            clearChatBox();
            addAIMessage("Hello! I'm your BabyStar AI assistant. I can help answer questions about pregnancy, nutrition, exercise, and more. What would you like to know?");
            renderConversationList();
            messageInput.focus();
        }

        // Send message to server and get AI response
        async function sendMessageToServer(text) {
            const resp = await fetch('/chatbot/message', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ message: text, conversationId })
            });
            const data = await resp.json();
            if (data.success) {
                conversationId = data.conversationId; // Save for conversation context
                return data.assistant;
            }
            throw new Error(data.errors?.general || 'Server error');
        }

        // ===== Main Send Message Handler =====
        async function sendMessage(text) {
            if (!text.trim()) return;

            addUserMessage(text);
            messageInput.value = '';
            enableInput(false);

            try {
                const reply = await sendMessageToServer(text);
                addAIMessage(reply);
                // Refresh conversation list to show new/updated conversation
                await fetchConversations();
            } catch (e) {
                addAIMessage('Sorry, an error occurred. Please try again.');
            }

            enableInput(true);
            messageInput.focus();
        }

        // ===== Initialization =====

        // Check session and initialize chat
        const hasSession = await checkSession();
        if (!hasSession) {
            addAIMessage('Please login to use the chatbot. Redirecting...');
            setTimeout(() => {
                window.location.href = '/auth/login?redirect=' + encodeURIComponent(window.location.pathname);
            }, 2000);
            return;
        }

        // Session valid - enable chat and show greeting
        enableInput(true);
        addAIMessage("Hello! I'm your BabyStar AI assistant. I can help answer questions about pregnancy, nutrition, exercise, and more. What would you like to know?");

        // Fetch existing conversations
        await fetchConversations();

        // ===== Event Listeners =====

        // Form submit
        chatForm.addEventListener('submit', (e) => {
            e.preventDefault();
            sendMessage(messageInput.value);
        });

        // Quick question clicks
        quickQuestions.forEach(q => {
            q.addEventListener('click', () => {
                if (!q.classList.contains('disabled')) {
                    sendMessage(q.dataset.question);
                }
            });
        });

        // New chat button
        newChatBtn.addEventListener('click', startNewChat);
    })();
</script>