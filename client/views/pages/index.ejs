<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BabyStar - Your AI-Powered Pregnancy Companion</title>
  <link rel="stylesheet" href="/css/landing.css">
</head>
<body>
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <div class="hero-text">
        <h1>Your AI-Powered Pregnancy Journey Starts Here</h1>
        <p>Track your health, get personalized advice, and connect with healthcare professionals — all in one place.</p>
        <div class="cta-buttons">
          <a href="/auth/register" class="btn btn-primary">Join Free</a>
          <a href="/auth/login" class="btn btn-secondary">Sign In</a>
        </div>
      </div>
      <div class="hero-image">
        <div class="hero-card">
          <h3>✨ AI-Powered Insights</h3>
          <p>Get weekly personalized tips based on your health data and pregnancy stage.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="features">
    <div class="features-content">
      <div class="section-title">
        <h2>Everything You Need for a Healthy Pregnancy</h2>
        <p>BabyStar provides comprehensive tools to support you every step of the way.</p>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon">📊</div>
          <h3>Health Tracking</h3>
          <p>Log your daily health metrics, mood, and symptoms with ease.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🤖</div>
          <h3>AI Weekly Advice</h3>
          <p>Receive personalized recommendations based on your unique journey.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💬</div>
          <h3>24/7 AI Chatbot</h3>
          <p>Get instant answers to your pregnancy questions anytime.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🥗</div>
          <h3>Diet & Exercise Plans</h3>
          <p>Custom meal plans and safe workouts for each trimester.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🏥</div>
          <h3>Healthcare Connect</h3>
          <p>Seamlessly connect with your healthcare providers.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📈</div>
          <h3>Progress Reports</h3>
          <p>Visualize your health trends and milestones.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="cta-section">
    <h2>Ready to Start Your Journey?</h2>
    <p>Join thousands of expectant mothers using BabyStar for a healthier pregnancy.</p>
    <div class="cta-buttons" style="justify-content: center;">
      <a href="/auth/register" class="btn btn-primary">Get Started Free</a>
      <a href="/auth/login" class="btn btn-secondary">Sign In</a>
    </div>
  </section>
</body>
</html>
