<% 
  // Helper function for UTC date formatting in EJS (server-side)
  function formatDateUTC(dateStr) {
    if (!dateStr) return 'N/A';
    const date = new Date(dateStr);
    const year = date.getUTCFullYear();
    const month = String(date.getUTCMonth() + 1).padStart(2, '0');
    const day = String(date.getUTCDate()).padStart(2, '0');
    return `${year}-${month}-${day}`;
  }
%>

<link rel="stylesheet" href="/css/share-report.css">

<div class="page-container">
    <div class="content-wrapper">
      <!-- Header -->
      <header class="page-header">
        <h1>Export Reports</h1>
        <p>Select a report to preview and export as PDF or send via email</p>
      </header>

      <div class="main-grid">
        <!-- Left Side - Report Cards and Sharing Options -->
        <div class="left-column">
          <!-- Available Reports Section -->
          <section class="reports-section">
            <h2>Available Reports</h2>
            <div class="reports-container">
              
              <% if (reports && reports.length > 0) { %>
                <% reports.forEach((report, index) => { %>
                  <!-- Report Card <%= index + 1 %> -->
                  <article class="report-card">
                    <div class="report-card-inner">
                      <div class="checkbox-area">
                        <input type="radio" name="report-select" id="report-<%= index %>">
                      </div>
                      <div class="report-content">
                        <header class="report-header">
                          <h2 id="rpt-<%= report._id %>-title" class="report-title">Check-in — Week <%= report.weekNumber %></h2>
                        </header>
                        <dl class="report-meta">
                          <div>
                            <dt>Date</dt>
                            <dd><%= formatDateUTC(report.startDate) %> - <%= formatDateUTC(report.endDate) %></dd>
                          </div>
                          <div>
                            <dt>Report ID</dt>
                            <dd>RPT-<%= report._id.toString().substring(0, 4).toUpperCase() %></dd>
                          </div>
                          <div>
                            <dt>Avg weight</dt>
                            <dd><%= report.vitalsSummary?.avgWeightKg ? report.vitalsSummary.avgWeightKg.toFixed(1) + ' kg' : 'N/A' %></dd>
                          </div>
                          <div>
                            <dt>Sleep (avg)</dt>
                            <dd><%= report.activities?.avgSleepHours ? report.activities.avgSleepHours.toFixed(1) + ' hrs/night' : 'N/A' %></dd>
                          </div>
                        </dl>
                        <div class="report-symptoms">
                          <div class="symptoms-title">Include symptoms</div>
                          <ul class="symptoms-list">
                            <% if (report.summary?.keySymptoms && report.summary.keySymptoms.length > 0) { %>
                              <% report.summary.keySymptoms.forEach(symptom => { %>
                                <li><%= symptom.replace(/_/g, ' ').charAt(0).toUpperCase() + symptom.replace(/_/g, ' ').slice(1) %></li>
                              <% }) %>
                            <% } else { %>
                              <li>No symptoms reported</li>
                            <% } %>
                          </ul>
                        </div>
                      </div>
                    </div>
                  </article>
                <% }) %>
              <% } else { %>
                <div class="no-reports">
                  <p>No weekly reports available yet. Start logging your health data to generate reports.</p>
                </div>
              <% } %>

            </div>
          </section>

          <!-- Export Options Section -->
          <section class="export-section">
            <h2>Export Options</h2>
            <div class="export-options">
              
              <!-- Download PDF Card -->
              <article class="share-card">
                <div class="share-card-inner">
                  <div class="share-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7 10 12 15 17 10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                  </div>
                  <div class="share-content">
                    <h3>Download PDF</h3>
                    <p>Export the selected report as a PDF file</p>
                    <a href="#" id="download-pdf-button" class="action-button" style="pointer-events: none; opacity: 0.5;">Download</a>
                  </div>
                </div>
              </article>

              <!-- Send Email Card -->
              <article class="share-card">
                <div class="share-card-inner">
                  <div class="share-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                    </svg>
                  </div>
                  <div class="share-content">
                    <h3>Send via Email</h3>
                    <p>Send the report PDF to your email address</p>
                    <button type="button" class="action-button">Send Email</button>
                  </div>
                </div>
              </article>

            </div>
          </section>
        </div>

        <!-- Right Side - PDF Preview -->
        <aside class="right-column">
          <div class="pdf-preview">
            <div class="no-preview" id="no-preview-message">
              <p>Select a report to preview</p>
            </div>
            <div id="pdf-preview-container" style="display: none;">
              <% if (reports && reports.length > 0) { %>
                <!-- PDF Preview Header -->
                <header class="pdf-preview-header">
                  <h3>PDF Preview</h3>
                  <span class="page-info">Page 1 of 1</span>
                </header>

                <!-- PDF Content -->
                <div class="pdf-content" id="pdf-preview-content">
                  <!-- Dynamic content will be updated by JavaScript -->
                </div>
              <% } %>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>

<% if (reports && reports.length > 0) { %>
<script>
  // Store all reports data for dynamic preview
  const reportsData = <%- JSON.stringify(reports) %>;
  let selectedReportId = null;
  
  // Add event listeners to radio buttons
  document.addEventListener('DOMContentLoaded', function() {
    const radioButtons = document.querySelectorAll('input[name="report-select"]');
    const downloadButton = document.getElementById('download-pdf-button');
    
    radioButtons.forEach((radio, index) => {
      radio.addEventListener('change', function() {
        if (this.checked) {
          // Store selected report ID
          selectedReportId = reportsData[index]._id;
          
          // Update download link
          downloadButton.href = `/download-report-pdf/${selectedReportId}`;
          downloadButton.style.pointerEvents = 'auto';
          downloadButton.style.opacity = '1';
          
          // Show PDF preview container and hide no-preview message
          document.getElementById('no-preview-message').style.display = 'none';
          document.getElementById('pdf-preview-container').style.display = 'block';
          
          updatePDFPreview(index);
          updateReportCardSelection(index);
        }
      });
    });
  });
  
  function updateReportCardSelection(selectedIndex) {
    const reportCards = document.querySelectorAll('.report-card');
    reportCards.forEach((card, index) => {
      if (index === selectedIndex) {
        card.classList.add('selected');
      } else {
        card.classList.remove('selected');
      }
    });
  }
  
  function updatePDFPreview(reportIndex) {
    const report = reportsData[reportIndex];
    const previewContent = document.getElementById('pdf-preview-content');
    
    if (!report || !previewContent) return;
    
    // Helper function to format date - USE UTC to match database storage
    const formatDate = (dateStr) => {
      const date = new Date(dateStr);
      const year = date.getUTCFullYear();
      const month = String(date.getUTCMonth() + 1).padStart(2, '0');
      const day = String(date.getUTCDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };
    
    // Helper function to format mood from dominantMoods array
    const formatMood = (dominantMoods) => {
      if (!dominantMoods || dominantMoods.length === 0) return 'N/A';
      
      const sortedMoods = dominantMoods.sort((a, b) => (b.frequency || 0) - (a.frequency || 0));
      const topMood = sortedMoods[0];

      if (!topMood || !topMood.mood) return 'N/A';

      const mood = topMood.mood;

      const moodMap = {
        'very_happy': '😊 Very Happy',
        'happy': '😊 Happy',
        'neutral': '😐 Neutral',
        'anxious': '😰 Anxious',
        'sad': '😢 Sad',
        'stressed': '😫 Stressed',
        'irritable': '😠 Irritable',
        'emotional': '😢 Emotional',
        'overwhelmed': '😵 Overwhelmed'
      };
      return moodMap[mood] || 'N/A';
    };
    
    // Helper function to format sleep quality
    const formatSleepQuality = (quality) => {
      if (!quality) return 'N/A';
      if (quality >= 4) return 'Good';
      if (quality >= 2.5) return 'Fair';
      return 'Poor';
    };
    
    // Helper function to format energy level
    const formatEnergyLevel = (energy) => {
      if (!energy) return 'N/A';
      if (energy >= 4) return 'High';
      if (energy >= 2.5) return 'Moderate';
      return 'Low';
    };
    
    // Helper function to capitalize and format symptom
    const formatSymptom = (symptom) => {
      const formatted = symptom.replace(/_/g, ' ');
      return formatted.charAt(0).toUpperCase() + formatted.slice(1);
    };
    
    // Helper function to get highest concern severity from aiFlags
    const getHighestSeverity = (aiFlags) => {
      if (!aiFlags || aiFlags.length === 0) return 'none';
      
      const severityOrder = { 'high': 3, 'medium': 2, 'low': 1 };
      let highest = 'low';
      
      aiFlags.forEach(flag => {
        if (severityOrder[flag.severity] > severityOrder[highest]) {
          highest = flag.severity;
        }
      });
      
      return highest;
    };
    
    // Helper function to format concern severity
    const formatConcernSeverity = (severity) => {
      if (!severity || severity === 'none') return 'None';
      return severity.charAt(0).toUpperCase() + severity.slice(1);
    };
    
    // Helper function to calculate blood pressure status
    const getBloodPressureStatus = (systolic, diastolic) => {
      if (!systolic || !diastolic) return { status: 'N/A', class: 'normal' };
      
      // Hypertensive Crisis
      if (systolic > 180 || diastolic > 120) {
        return { status: 'Hypertensive Crisis', class: 'high' };
      }
      // Stage 2 Hypertension
      if (systolic >= 140 || diastolic >= 90) {
        return { status: 'High (Stage 2)', class: 'high' };
      }
      // Stage 1 Hypertension
      if (systolic >= 130 || diastolic >= 80) {
        return { status: 'High (Stage 1)', class: 'high' };
      }
      // Elevated
      if (systolic >= 120 && systolic < 130 && diastolic < 80) {
        return { status: 'Elevated', class: 'normal' };
      }
      // Low
      if (systolic < 90 || diastolic < 60) {
        return { status: 'Low', class: 'low' };
      }
      // Normal
      return { status: 'Normal', class: 'normal' };
    };

    // Get highest severity from aiFlags
    const highestSeverity = getHighestSeverity(report.summary?.aiFlags);
    
    // Build the HTML content
    const html = `
      <!-- PDF Title Section -->
      <section class="pdf-title-section">
        <div class="pdf-title-left">
          <div class="pdf-label">PREGNANCY CHECK-IN REPORT</div>
          <h1>Check-in — Week ${report.weekNumber}</h1>
        </div>
        <div class="pdf-title-right">
          <div class="pdf-label">Report ID</div>
          <div class="pdf-value">RPT-${report._id.toString().substring(0, 4).toUpperCase()}</div>
        </div>
      </section>

      <!-- Report Info -->
      <section class="pdf-info-section">
        <div class="pdf-info-grid">
          <div class="pdf-info-item">
            <div class="pdf-info-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>Start Date</span>
            </div>
            <div class="pdf-info-value">${formatDate(report.startDate)}</div>
          </div>
          <div class="pdf-info-item">
            <div class="pdf-info-label">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <span>End Date</span>
            </div>
            <div class="pdf-info-value">${formatDate(report.endDate)}</div>
          </div>
        </div>
      </section>

      <!-- Health Metrics Section -->
      <section class="pdf-metrics-section">
        <header class="pdf-section-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
          </svg>
          <h2>Health Metrics</h2>
        </header>
        <div class="metrics-grid-extended">
          <div class="metric-card">
            <div class="metric-label">Average Weight</div>
            <div class="metric-value">${report.vitalsSummary?.avgWeightKg ? report.vitalsSummary.avgWeightKg.toFixed(1) + ' kg' : 'N/A'}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Average Sleep</div>
            <div class="metric-value">${report.activities?.avgSleepHours ? report.activities.avgSleepHours.toFixed(1) + ' hrs/night' : 'N/A'}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Sleep Quality</div>
            <div class="metric-value">${formatSleepQuality(report.activities?.avgSleepQuality)}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Avg Heart Rate</div>
            <div class="metric-value">${report.vitalsSummary?.avgHeartRateBpm ? report.vitalsSummary.avgHeartRateBpm + ' bpm' : 'N/A'}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Avg Temperature</div>
            <div class="metric-value">${report.vitalsSummary?.avgTemperatureC ? report.vitalsSummary.avgTemperatureC.toFixed(1) + '°C' : 'N/A'}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Exercise Minutes</div>
            <div class="metric-value">${report.activities?.totalExerciseMinutes || 0} min/week</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Avg Water Intake</div>
            <div class="metric-value">${report.activities?.avgWaterIntakeLiters ? report.activities.avgWaterIntakeLiters.toFixed(1) + ' L/day' : 'N/A'}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Energy Level</div>
            <div class="metric-value metric-value-tag energy-${formatEnergyLevel(report.summary?.avgEnergyLevel)}">${formatEnergyLevel(report.summary?.avgEnergyLevel)}</div>
          </div>
        </div>
      </section>

      ${report.vitalsSummary?.avgSystolic || report.vitalsSummary?.avgDiastolic ? `
      <section class="pdf-bp-section">
        <header class="pdf-section-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
          </svg>
          <h2>Blood Pressure</h2>
        </header>
        <div class="bp-grid">
          <div class="bp-card">
            <div class="bp-label">Avg Systolic</div>
            <div class="bp-value">${report.vitalsSummary.avgSystolic || 'N/A'} <span class="bp-unit">mmHg</span></div>
            <div class="bp-status ${getBloodPressureStatus(report.vitalsSummary.avgSystolic, report.vitalsSummary.avgDiastolic).class}">${getBloodPressureStatus(report.vitalsSummary.avgSystolic, report.vitalsSummary.avgDiastolic).status}</div>
          </div>
          <div class="bp-card">
            <div class="bp-label">Avg Diastolic</div>
            <div class="bp-value">${report.vitalsSummary.avgDiastolic || 'N/A'} <span class="bp-unit">mmHg</span></div>
            <div class="bp-status ${getBloodPressureStatus(report.vitalsSummary.avgSystolic, report.vitalsSummary.avgDiastolic).class}">${getBloodPressureStatus(report.vitalsSummary.avgSystolic, report.vitalsSummary.avgDiastolic).status}</div>
          </div>
        </div>
      </section>
      ` : ''}

      <!-- Mood & Wellbeing Section -->
      <section class="pdf-mood-section">
        <header class="pdf-section-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M8 14s1.5 2 4 2 4-2 4-2"></path>
            <line x1="9" y1="9" x2="9.01" y2="9"></line>
            <line x1="15" y1="9" x2="15.01" y2="9"></line>
          </svg>
          <h2>Mood & Wellbeing</h2>
        </header>
        <div class="mood-grid">
          <div class="mood-card">
            <div class="mood-label">Overall Mood</div>
            <div class="mood-value">${formatMood(report.summary?.dominantMoods)}</div>
          </div>
          <div class="mood-card">
            <div class="mood-label">Stress Level</div>
            <div class="mood-value">${formatEnergyLevel(report.summary?.avgStressLevel)}</div>
          </div>
        </div>
      </section>
      
      <!-- Concerns Section -->
      <section class="pdf-concerns-section">
        <header class="pdf-section-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
          <h2>Concerns Detected</h2>
        </header>
        <div class="concerns-box">
          ${report.summary?.aiFlags && report.summary.aiFlags.length > 0 ? `
            <ul class="concerns-list">
              ${report.summary.aiFlags.map(flag => `
                <li class="concern-item ${flag.severity}">
                  <span class="concern-indicator"></span>
                  <span class="concern-text">${flag.message}</span>
                </li>
              `).join('')}
            </ul>
          ` : `
            <div class="concerns-note">
              No critical issues detected during this check-in period.
            </div>
          `}
        </div>
      </section>

      <!-- Symptoms Section -->
      <section class="pdf-symptoms-section">
        <h2>Reported Symptoms</h2>
        <div class="symptoms-box">
          ${report.summary?.keySymptoms && report.summary.keySymptoms.length > 0 ? `
            <ul class="symptoms-box-list">
              ${report.summary.keySymptoms.map(symptom => `
                <li>
                  <span class="symptom-bullet"></span>
                  ${formatSymptom(symptom)}
                </li>
              `).join('')}
            </ul>
          ` : `
            <p>No symptoms reported during this period.</p>
          `}
        </div>
      </section>

      <!-- Summary Section -->
      <section class="pdf-summary-section">
        <h2>Summary</h2>
        <div class="summary-text">
          <p>This check-in report provides a comprehensive overview of health metrics and symptoms recorded during this period of your pregnancy journey.</p>
          <p>Regular monitoring of weight, sleep patterns, and symptoms helps ensure a healthy pregnancy and allows healthcare providers to track your progress effectively.</p>
          <p>Please share this report with your healthcare provider during your next appointment for a detailed discussion of your pregnancy progress.</p>
        </div>
      </section>

      <!-- PDF Footer -->
      <footer class="pdf-footer">
        <p>This report was automatically generated on ${formatDate(report.createdAt)}</p>
        <p>For medical advice, please consult with your healthcare provider</p>
      </footer>
    `;
    
    previewContent.innerHTML = html;
  }
</script>
<% } %>