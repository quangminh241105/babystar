      tabHealthDetails.style.display = tab === 'health' ? 'block' : 'none';
      tabNotes.style.display = tab === 'notes' ? 'block' : 'none';
      if (tabBasicsBtn) tabBasicsBtn.classList.toggle('active', tab === 'basics');
      if (tabHealthDetailsBtn) tabHealthDetailsBtn.classList.toggle('active', tab === 'health');
      if (tabNotesBtn) tabNotesBtn.classList.toggle('active', tab === 'notes');
