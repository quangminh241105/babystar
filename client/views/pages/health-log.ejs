    function updateLogStatus() {
      // Count individual fields completed
      let totalFields = 0;
      let completedFields = 0;

      // Section 1: Vitals & Mood (8 possible fields)
      const vitalsFields = [
        document.getElementById('weightKg').value,
        parseInt(document.getElementById('heartRateBpm').value) > 50,
        document.getElementById('systolicBP')?.value,
        document.getElementById('diastolicBP')?.value,
        document.getElementById('energyLevel').value,
        document.getElementById('stressLevel').value,
        parseFloat(document.getElementById('sleepHours').value) > 0,
        document.getElementById('sleepQuality').value
      ];
      const section1Extras = (symptoms.length > 0 ? 1 : 0) + (moodLog.length > 0 ? 1 : 0);
      totalFields += 10;
      completedFields += vitalsFields.filter(f => f).length + section1Extras;

      // Section 2: Hydration & Activity (6 possible fields)
      const hydrationFields = [
        parseFloat(document.getElementById('waterLiters').value) > 0,
        parseFloat(document.getElementById('otherFluidsLiters').value) > 0,
        parseInt(document.getElementById('caffeineIntakeMg').value) > 0,
        drinks.length > 0,
        exercises.length > 0,
        meals.length > 0
      ];
      const fetalMovement = (document.getElementById('fmKickCount') && document.getElementById('fmKickCount').value) ? 1 : 0;
      totalFields += 7;
      completedFields += hydrationFields.filter(f => f).length + fetalMovement;

      // Section 3: Notes & Visits (3 possible fields)
      const notesFields = [
        document.getElementById('visitedDoctor').checked,
        document.getElementById('doctorVisitNotes').value,
        document.getElementById('notes').value
      ];
      totalFields += 3;
      completedFields += notesFields.filter(f => f).length;

      // Calculate percentage
      const percentage = Math.round((completedFields / totalFields) * 100);
      
      // Update progress bar width and color
      const progressBar = document.getElementById('logProgress');
      progressBar.style.width = percentage + '%';
      
      // Change color based on completion percentage
      if (percentage < 30) {
        progressBar.style.background = 'linear-gradient(90deg, #ff6b6b 0%, #ff8787 100%)';
      } else if (percentage < 60) {
        progressBar.style.background = 'linear-gradient(90deg, #ffa500 0%, #ffb733 100%)';
      } else if (percentage < 90) {
        progressBar.style.background = 'linear-gradient(90deg, #4dabf7 0%, #74c0fc 100%)';
      } else {
        progressBar.style.background = 'linear-gradient(90deg, #51cf66 0%, #69db7c 100%)';
      }

      // Update percentage text
      document.getElementById('progressPercentage').textContent = `${percentage}% Complete`;
      
      // Update status text
      document.getElementById('logStatusText').textContent = 
        percentage >= 90 ? 'Complete' : 
        percentage >= 30 ? 'In Progress' : 'Draft';

      // Update completion icons
      const section1Complete = isSection1Filled();
      const section2Complete = isSection2Filled();
      const section3Complete = isSection3Filled();
      
      document.getElementById('vitalsIcon').textContent = section1Complete ? '✅' : '⭕';
      document.getElementById('hydrationIcon').textContent = section2Complete ? '✅' : '⭕';
      document.getElementById('notesIcon').textContent = section3Complete ? '✅' : '⭕';

      // Update stats
      const filled = [section1Complete, section2Complete, section3Complete].filter(Boolean).length;
      document.getElementById('statSections').textContent = `${filled}/3`;
      document.getElementById('statWeek').textContent = userContext.pregnancyWeek || '-';
      document.getElementById('statTrimester').textContent = userContext.trimester || '-';
      document.getElementById('statEnergy').textContent = document.getElementById('energyLevel').value || '-';
      document.getElementById('statSleep').textContent = document.getElementById('sleepHours').value || '-';
      document.getElementById('statWater').textContent = document.getElementById('waterLiters').value || '-';
      
      // Update section statuses
      updateSectionStatuses();
    }

    // Listen to inputs for status update
    ['weightKg', 'heartRateBpm', 'sleepHours', 'waterLiters', 'otherFluidsLiters', 'caffeineIntakeMg'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', updateLogStatus);
