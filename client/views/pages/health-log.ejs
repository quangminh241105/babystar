<link rel="stylesheet" href="/css/user-edit.css">
<link rel="stylesheet" href="/css/healthlog.css">

<div class="healthlog-bg">
  <main class="container healthlog-main" role="main">
    <header class="healthlog-header">
      <div class="brand">
        <div class="title">Daily Health Log</div>
        <div class="subtitle">Quick, optional entries to personalize your AI insights</div>
      </div>
    </header>

    <!-- Sticky action bar with tab navigation -->
    <nav class="card healthlog-actionbar">
      <button type="button" class="step-label tab-btn active" id="tabBasicsBtn">1. Today’s Basics</button>
      <button type="button" class="step-label tab-btn" id="tabHealthDetailsBtn">2. Health Details</button>
      <button type="button" class="step-label tab-btn" id="tabNotesBtn">3. Details & Notes</button>
      <div class="action-btns">
        <button type="button" class="btn-ghost" id="saveBtn">Save</button>
        <button type="button" class="btn-primary" id="saveCompleteBtn">Save & Mark Complete</button>
      </div>
    </nav>

    <div class="healthlog-grid">
      <!-- Main Form -->
      <form id="healthLogForm" novalidate>
        <!-- 1. Today’s Basics -->
        <section class="card healthlog-card tab-section" id="tabBasics" style="display:block;">
          <h2 class="card-title">Today’s Basics</h2>

          <!-- Vitals Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🩺</span> Vitals
            </div>
            <div class="vitals-form">
              <div class="row two">
                <div class="field">
                  <label for="weightKg">💪 Weight</label>
                  <div class="input-with-unit">
                    <input id="weightKg" type="number" step="0.1" min="20" max="300" placeholder="e.g., 65.5" class="input-primary">
                    <span class="input-unit">kg</span>
                  </div>
                </div>
                <div class="field">
                  <label for="heartRateBpm">❤️ Heart Rate</label>
                  <div class="heart-rate-display">
                    <span class="heart-value" id="heartRateDisplay">—</span>
                    <span class="heart-label">bpm</span>
                  </div>
                  <input id="heartRateBpm" type="range" min="50" max="160" step="1" class="custom-range">
                  <div class="range-labels">
                    <span>50</span>
                    <span>105</span>
                    <span>160</span>
                  </div>
                </div>
              </div>

              <div class="vitals-optional-section">
                <div class="row two">
                  <div class="field">
                    <label>🩸 Blood Sugar <span class="optional-badge">Optional</span></label>
                    <div class="blood-sugar-inputs">
                      <input id="bloodSugarValue" type="number" step="0.1" min="0" max="500" placeholder="Value" class="input-primary sugar-value-input">
                      <select id="bloodSugarUnit" class="input-primary sugar-unit-select">
                        <option value="mg/dL">mg/dL</option>
                        <option value="mmol/L">mmol/L</option>
                      </select>
                    </div>
                    <select id="bloodSugarTiming" class="input-primary" style="margin-top:8px;">
                      <option value="">When was it measured?</option>
                      <option value="fasting">🌅 Fasting (morning)</option>
                      <option value="before_meal">🍽️ Before Meal</option>
                      <option value="after_meal">✅ After Meal</option>
                      <option value="bedtime">🌙 Bedtime</option>
                    </select>
                  </div>
                  <div class="field">
                    <label>💉 Blood Pressure <span class="optional-badge">Optional</span></label>
                    <div class="blood-pressure-inputs">
                      <input id="systolicBP" type="number" min="70" max="200" placeholder="120" class="input-primary bp-input">
                      <span class="bp-separator">/</span>
                      <input id="diastolicBP" type="number" min="40" max="130" placeholder="80" class="input-primary bp-input">
                      <span class="bp-unit">mmHg</span>
                    </div>
                    <div class="bp-hint">Normal: 90-120 / 60-80</div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mood & Energy Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🙂</span> Mood & Energy
            </div>
            <div class="mood-energy-form">
              <div class="row two">
                <div class="field">
                  <label>⚡ Energy Level</label>
                  <div class="energy-rating-container">
                    <div class="rating energy-rating" id="energyRating" aria-label="Energy"></div>
                    <span class="rating-label" id="energyLabel">Not rated</span>
                  </div>
                  <input type="hidden" id="energyLevel">
                </div>
                <div class="field">
                  <label>😰 Stress Level</label>
                  <div class="stress-rating-container">
                    <div class="rating stress-rating" id="stressRating" aria-label="Stress"></div>
                    <span class="rating-label" id="stressLabel">Not rated</span>
                  </div>
                  <input type="hidden" id="stressLevel">
                </div>
              </div>

              <div class="mood-log-section">
                <label class="section-sublabel">💭 Track Your Mood Throughout the Day <span class="optional-badge">Optional</span></label>
                <div class="mood-log-inputs">
                  <select id="moodLogMood" class="input-primary mood-select">
                    <option value="">How are you feeling?</option>
                    <option value="very_happy">😁 Very Happy</option>
                    <option value="happy">🙂 Happy</option>
                    <option value="neutral">😐 Neutral</option>
                    <option value="anxious">😟 Anxious</option>
                    <option value="sad">😢 Sad</option>
                    <option value="stressed">😣 Stressed</option>
                    <option value="irritable">😠 Irritable</option>
                    <option value="emotional">😭 Emotional</option>
                    <option value="overwhelmed">😩 Overwhelmed</option>
                  </select>
                  <input id="moodLogTrigger" class="input-primary mood-trigger-input" type="text" placeholder="What triggered this feeling? (optional)">
                  <button type="button" class="btn-add-mood" id="addMoodLogBtn">
                    <span>+ Add</span>
                  </button>
                </div>
                <div id="moodLogList" class="mood-log-list"></div>
              </div>
            </div>
          </div>

          <!-- Sleep Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">😴</span> Sleep
            </div>
            <div class="sleep-form">
              <div class="row two">
                <div class="field">
                  <label for="sleepHours">Total Sleep Hours</label>
                  <div class="sleep-hours-display">
                    <span class="hours-value" id="sleepHoursDisplay">0</span>
                    <span class="hours-label">hours</span>
                  </div>
                  <input id="sleepHours" type="range" min="0" max="12" step="0.5" class="custom-range">
                  <div class="range-labels">
                    <span>0h</span>
                    <span>6h</span>
                    <span>12h</span>
                  </div>
                </div>
                <div class="field">
                  <label>Sleep Quality</label>
                  <div class="quality-stars-container">
                    <div class="rating quality-rating" id="sleepQualityRating"></div>
                    <span class="quality-label" id="qualityLabel">Not rated</span>
                  </div>
                  <input type="hidden" id="sleepQuality">
                </div>
              </div>

              <div class="sleep-details-card">
                <div class="row three">
                  <div class="field">
                    <label for="bedTime">🌙 Bed Time</label>
                    <input id="bedTime" type="time" class="input-primary">
                  </div>
                  <div class="field">
                    <label for="wakeTime">☀️ Wake Time</label>
                    <input id="wakeTime" type="time" class="input-primary">
                  </div>
                  <div class="field">
                    <label for="primaryPosition">🛏️ Sleep Position</label>
                    <select id="primaryPosition" class="input-primary">
                      <option value="">Choose position...</option>
                      <option value="left_side">Left Side (Recommended)</option>
                      <option value="right_side">Right Side</option>
                      <option value="back">Back</option>
                      <option value="varied">Varied</option>
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label class="section-sublabel">What woke you up during the night?</label>
                  <div class="awakening-chips" id="awakeningChips">
                    <button type="button" class="awakening-chip" data-reason="bathroom">🚽 Bathroom</button>
                    <button type="button" class="awakening-chip" data-reason="discomfort">😣 Discomfort</button>
                    <button type="button" class="awakening-chip" data-reason="baby_movement">👶 Baby Movement</button>
                    <button type="button" class="awakening-chip" data-reason="noise">🔊 Noise</button>
                    <button type="button" class="awakening-chip" data-reason="pain">😖 Pain</button>
                    <button type="button" class="awakening-chip" data-reason="nightmare">😰 Nightmare</button>
                    <button type="button" class="awakening-chip" data-reason="other">Other</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Symptoms Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🤒</span> Symptoms
            </div>
            <div class="symptoms-form">
              <label class="section-sublabel">Select symptoms you're experiencing</label>
              <div class="symptom-chips" id="symptomChips">
                <button type="button" class="symptom-chip" data-symptom="nausea">🤢 Nausea</button>
                <button type="button" class="symptom-chip" data-symptom="fatigue">😴 Fatigue</button>
                <button type="button" class="symptom-chip" data-symptom="headache">🤕 Headache</button>
                <button type="button" class="symptom-chip" data-symptom="back_pain">🔙 Back Pain</button>
                <button type="button" class="symptom-chip" data-symptom="spotting">🩸 Spotting</button>
                <button type="button" class="symptom-chip" data-symptom="leg_cramps">🦵 Leg Cramps</button>
                <button type="button" class="symptom-chip" data-symptom="heartburn">🔥 Heartburn</button>
                <button type="button" class="symptom-chip" data-symptom="swelling_feet">🦶 Swelling</button>
              </div>

              <div class="symptom-details-panel" id="symptomDetailsPanel" style="display:none;">
                <div class="row two">
                  <div class="field">
                    <label for="symptomSeverity">How severe? (1-10)</label>
                    <div class="severity-display">
                      <div class="severity-bar-container">
                        <div class="severity-bar" id="severityBar"></div>
                      </div>
                      <span class="severity-value" id="severityValue">5</span>
                    </div>
                    <input id="symptomSeverity" type="range" min="1" max="10" step="1" value="5" class="custom-range">
                    <div class="range-labels">
                      <span>Mild</span>
                      <span>Moderate</span>
                      <span>Severe</span>
                    </div>
                  </div>
                  <div class="field">
                    <label for="occurredAt">Time it started (optional)</label>
                    <input id="occurredAt" type="time" class="input-primary">
                  </div>
                </div>
                <button type="button" class="btn-add-item" id="addSymptomBtn">
                  <span class="btn-icon">+</span> Add This Symptom
                </button>
              </div>
            </div>
            
            <div id="symptomList" class="item-list"></div>
          </div>
        </section>

        <!-- 2. Health Details -->
        <section class="card healthlog-card tab-section" id="tabHealthDetails" style="display:none;">
          <h2 class="card-title">Health Details</h2>

          <!-- Drinks Section (Hydration & Caffeine grouped) -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🥤</span> Hydration & Drinks
            </div>
            <div class="drinks-form">
              <div class="hydration-trackers">
                <div class="tracker-card">
                  <div class="tracker-icon">💧</div>
                  <div class="tracker-content">
                    <label for="waterLiters">Water</label>
                    <div class="tracker-value-display">
                      <span class="tracker-value" id="waterDisplay">0</span>
                      <span class="tracker-unit">liters</span>
                    </div>
                    <input id="waterLiters" type="range" min="0" max="5" step="0.1" class="custom-range">
                    <div class="range-labels">
                      <span>0L</span>
                      <span>2.5L</span>
                      <span>5L</span>
                    </div>
                  </div>
                </div>

                <div class="tracker-card">
                  <div class="tracker-icon">🧃</div>
                  <div class="tracker-content">
                    <label for="otherFluidsLiters">Other Fluids</label>
                    <div class="tracker-value-display">
                      <span class="tracker-value" id="fluidsDisplay">0</span>
                      <span class="tracker-unit">liters</span>
                    </div>
                    <input id="otherFluidsLiters" type="range" min="0" max="3" step="0.1" class="custom-range">
                    <div class="range-labels">
                      <span>0L</span>
                      <span>1.5L</span>
                      <span>3L</span>
                    </div>
                  </div>
                </div>

                <div class="tracker-card caffeine-tracker">
                  <div class="tracker-icon">☕</div>
                  <div class="tracker-content">
                    <label for="caffeineIntakeMg">Caffeine</label>
                    <div class="tracker-value-display">
                      <span class="tracker-value" id="caffeineDisplay">0</span>
                      <span class="tracker-unit">mg</span>
                    </div>
                    <input id="caffeineIntakeMg" type="range" min="0" max="500" step="10" class="custom-range">
                    <div class="range-labels">
                      <span>0mg</span>
                      <span>250mg</span>
                      <span>500mg</span>
                    </div>
                    <div class="caffeine-warning" id="caffeineWarning" style="display:none;">
                      ⚠️ Limit to 200mg/day during pregnancy
                    </div>
                  </div>
                </div>
              </div>

              <div class="drink-log-section">
                <label class="section-sublabel">📝 Log Individual Drinks <span class="optional-badge">Optional</span></label>
                <div class="drink-input-row">
                  <select id="drinkType" class="input-primary drink-type-select">
                    <option value="">Choose drink type...</option>
                    <option value="water">💧 Water</option>
                    <option value="juice">🧃 Juice</option>
                    <option value="milk">🥛 Milk</option>
                    <option value="tea">🍵 Tea</option>
                    <option value="coffee">☕ Coffee</option>
                    <option value="other">🥤 Other</option>
                  </select>
                  <div class="input-with-unit">
                    <input id="drinkAmount" type="number" min="0" max="2000" placeholder="Amount" class="input-primary drink-amount-input">
                    <span class="input-unit">ml</span>
                  </div>
                  <button type="button" class="btn-add-drink-item" id="addDrinkBtn">
                    <span>+ Add</span>
                  </button>
                </div>
                <div id="drinkList" class="drink-chips-list"></div>
              </div>
            </div>
          </div>

          <!-- Exercise Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🏃‍♀️</span> Exercise
            </div>
            <div class="exercise-form">
              <div class="row two">
                <div class="field">
                  <label for="exerciseType">Exercise Type</label>
                  <select id="exerciseType" class="input-primary">
                    <option value="">Choose exercise...</option>
                    <option value="walking">🚶‍♀️ Walking</option>
                    <option value="prenatal_yoga">🧘‍♀️ Prenatal Yoga</option>
                    <option value="swimming">🏊‍♀️ Swimming</option>
                    <option value="strength_training">💪 Strength Training</option>
                    <option value="stretching">🤸‍♀️ Stretching</option>
                    <option value="pilates">Pilates</option>
                    <option value="stationary_cycling">🚴‍♀️ Stationary Cycling</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="field">
                  <label for="exerciseMinutes">Duration (minutes)</label>
                  <input id="exerciseMinutes" type="number" min="0" max="300" placeholder="e.g., 30" class="input-primary">
                </div>
              </div>
              
              <div class="row two">
                <div class="field">
                  <label>Intensity Level</label>
                  <div class="intensity-buttons">
                    <button type="button" class="intensity-btn" data-val="light">
                      <span class="intensity-icon">🟢</span>
                      <span>Light</span>
                    </button>
                    <button type="button" class="intensity-btn" data-val="moderate">
                      <span class="intensity-icon">🟡</span>
                      <span>Moderate</span>
                    </button>
                    <button type="button" class="intensity-btn" data-val="vigorous">
                      <span class="intensity-icon">🔴</span>
                      <span>Vigorous</span>
                    </button>
                  </div>
                  <input type="hidden" id="exerciseIntensity">
                </div>
                <div class="field">
                  <label for="exerciseFeeling">How did you feel?</label>
                  <select id="exerciseFeeling" class="input-primary">
                    <option value="">Select feeling...</option>
                    <option value="great">😊 Great</option>
                    <option value="good">🙂 Good</option>
                    <option value="okay">😐 Okay</option>
                    <option value="tired">😴 Tired</option>
                    <option value="uncomfortable">😣 Uncomfortable</option>
                    <option value="painful">😖 Painful</option>
                  </select>
                </div>
              </div>

              <div class="row two">
                <div class="field">
                  <label for="exerciseTime">Time of Exercise</label>
                  <input id="exerciseTime" type="time" class="input-primary">
                </div>
                <div class="field">
                  <label for="exerciseNotes">Additional Notes</label>
                  <input id="exerciseNotes" type="text" placeholder="Any other details..." class="input-primary">
                </div>
              </div>

              <button type="button" class="btn-add-item" id="addExerciseBtn">
                <span class="btn-icon">+</span> Add Exercise
              </button>
            </div>
            
            <div id="exerciseList" class="item-list"></div>
          </div>

          <!-- Nutrition Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🥗</span> Nutrition
            </div>
            <div class="nutrition-form">
              <div class="meal-header">
                <div class="row two">
                  <div class="field">
                    <label for="mealType">Meal Type</label>
                    <select id="mealType" class="input-primary">
                      <option value="">Choose meal...</option>
                      <option value="breakfast">🍳 Breakfast</option>
                      <option value="lunch">🥙 Lunch</option>
                      <option value="dinner">🍽️ Dinner</option>
                      <option value="snack">🍎 Snack</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                  <div class="field">
                    <label for="mealTime">Time</label>
                    <input id="mealTime" type="time" class="input-primary">
                  </div>
                </div>
              </div>

              <div class="food-entry-section">
                <label class="section-sublabel">Add Foods to This Meal</label>
                <div class="food-input-row">
                  <input id="foodName" type="text" placeholder="Food name (e.g., Grilled Chicken)" class="input-primary food-name-input">
                  <input id="foodAmount" type="number" min="0" placeholder="Amount" class="input-primary food-amount-input">
                  <select id="foodUnit" class="input-primary food-unit-select">
                    <option value="g">grams</option>
                    <option value="ml">ml</option>
                    <option value="serving">serving</option>
                    <option value="piece">piece</option>
                    <option value="cup">cup</option>
                  </select>
                  <button type="button" class="btn-add-food" id="addFoodBtn">
                    <span>+ Add</span>
                  </button>
                </div>
                <div id="foodList" class="food-list"></div>
              </div>

              <div class="meal-footer">
                <div class="field">
                  <label for="mealNotes">Meal Notes (optional)</label>
                  <input id="mealNotes" type="text" placeholder="Any additional details about this meal..." class="input-primary">
                </div>

                <button type="button" class="btn-add-item" id="addMealBtn">
                  <span class="btn-icon">+</span> Add Meal to Log
                </button>
              </div>
            </div>
            
            <div id="mealList" class="item-list"></div>
          </div>

          <!-- Fetal Movement Section (only show if week >= 16) -->
          <div class="section-block" id="fetalMovementSection" style="display:none;">
            <div class="section-title">
              <span class="section-icon">🤰</span> Fetal Movement
            </div>
            <div class="row three">
              <div class="field">
                <label for="fmStartTime">Start Time</label>
                <input id="fmStartTime" type="time">
              </div>
              <div class="field">
                <label for="fmEndTime">End Time</label>
                <input id="fmEndTime" type="time">
              </div>
              <div class="field">
                <label for="fmMotherPosition">Mother Position</label>
                <select id="fmMotherPosition">
                  <option value="">Select...</option>
                  <option value="lying_left">Lying Left</option>
                  <option value="lying_right">Lying Right</option>
                  <option value="sitting">Sitting</option>
                  <option value="standing">Standing</option>
                </select>
              </div>
            </div>
            <div class="row two">
              <div class="field">
                <label for="fmTimeSinceMeal">Time Since Meal</label>
                <select id="fmTimeSinceMeal">
                  <option value="">Select...</option>
                  <option value="just_ate">Just Ate</option>
                  <option value="1_hour">1 hour</option>
                  <option value="2_hours">2 hours</option>
                  <option value="3_plus_hours">3+ hours</option>
                </select>
              </div>
              <div class="field">
                <label for="fmNotes">Notes</label>
                <input id="fmNotes" type="text" placeholder="Notes">
              </div>
            </div>
          </div>
        </section>

        <!-- 3. Details & Notes -->
        <section class="card healthlog-card tab-section" id="tabNotes" style="display:none;">
          <h2 class="card-title">Details & Notes</h2>

          <!-- Doctor Visit -->
          <div class="row two">
            <div class="field checkbox-field">
              <label class="checkbox-label">
                <input type="checkbox" id="visitedDoctor" />
                <span>Visited Doctor Today</span>
              </label>
            </div>
            <div class="field">
              <label for="visitType">Visit Type</label>
              <select id="visitType">
                <option value="">Select...</option>
                <option value="routine">Routine</option>
                <option value="ultrasound">Ultrasound</option>
                <option value="lab_work">Lab Work</option>
                <option value="specialist">Specialist</option>
                <option value="emergency">Emergency</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="doctorVisitNotes">Doctor Visit Notes</label>
            <input id="doctorVisitNotes" type="text" placeholder="Notes">
          </div>
          <div class="field">
            <label for="nextAppointment">Next Appointment</label>
            <input id="nextAppointment" type="date">
          </div>
          <!-- Notes -->
          <div class="field">
            <label for="notes">Notes (optional)</label>
            <textarea id="notes" rows="4" placeholder="Anything notable about today..."></textarea>
          </div>
        </section>
        <div id="message" class="msg" hidden></div>
      </form>

      <!-- Sidebar -->
      <aside class="status-sidebar healthlog-sidebar">
        <div class="card status-card">
          <div class="section-head">
            <strong>Log Status</strong>
            <div id="logStatusText" class="progress-label">Draft</div>
          </div>
          <div id="lastUpdatedTime" class="last-updated-time" style="display:none;"></div>
          <div class="progress-bar-container">
            <div class="progress-bar" id="logProgress"></div>
          </div>
          <div class="small" id="logDetail">Complete more sections to improve insights.</div>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-value" id="statSections">0/3</div>
              <div class="stat-label">Sections</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statTrimester">-</div>
              <div class="stat-label">Trimester</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statWeek">-</div>
              <div class="stat-label">Week</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statEnergy">-</div>
              <div class="stat-label">Energy</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statSleep">-</div>
              <div class="stat-label">Sleep Hours</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statWater">-</div>
              <div class="stat-label">Water (L)</div>
            </div>
          </div>
        </div>
        <div class="card">
          <strong>Quick Actions</strong>
          <div class="quick-actions">
            <button type="button" class="btn-ghost" id="saveSidebarBtn">Save</button>
            <button type="button" class="btn-ghost" id="completeSidebarBtn">Mark Complete</button>
          </div>
        </div>
      </aside>
    </div>
  </main>
</div>

<script>
  (function () {
    // ==================== STATE ====================
    let currentLogId = null;
    let currentLogDate = null;
    let symptoms = [];
    let exercises = [];
    let moodLog = [];
    let drinks = [];
    let meals = [];
    let currentFoodList = []; // Add this line - initialize food list
    let isReadOnly = false;
    let userContext = {
      pregnancyWeek: <%= typeof currentPregnancyWeek !== 'undefined' && currentPregnancyWeek ? currentPregnancyWeek : null %>,
      trimester: <%= typeof currentTrimester !== 'undefined' && currentTrimester ? currentTrimester : null %>
    };

    // ==================== DOM ELEMENTS ====================
    const messageEl = document.getElementById('message');
    const saveBtn = document.getElementById('saveBtn');
    const saveCompleteBtn = document.getElementById('saveCompleteBtn');
    const saveSidebarBtn = document.getElementById('saveSidebarBtn');
    const completeSidebarBtn = document.getElementById('completeSidebarBtn');

    // ==================== BLOOD PRESSURE VALIDATION ====================
    const systolicBP = document.getElementById('systolicBP');
    const diastolicBP = document.getElementById('diastolicBP');

    function validateBloodPressure(input, min, max, name) {
      input.addEventListener('input', function() {
        const value = parseInt(this.value);
        if (this.value && (value < min || value > max)) {
          this.style.borderColor = '#d91e8f';
          this.style.background = '#ffe3f0';
          this.setCustomValidity(`${name} must be between ${min} and ${max}`);
        } else {
          this.style.borderColor = '';
          this.style.background = '';
          this.setCustomValidity('');
        }
      });

      input.addEventListener('blur', function() {
        const value = parseInt(this.value);
        if (this.value && value < min) {
          this.value = min;
          showMsg(`${name} adjusted to minimum (${min})`, 'info');
        } else if (this.value && value > max) {
          this.value = max;
          showMsg(`${name} adjusted to maximum (${max})`, 'info');
        }
        this.style.borderColor = '';
        this.style.background = '';
      });
    }

    if (systolicBP) validateBloodPressure(systolicBP, 70, 200, 'Systolic BP');
    if (diastolicBP) validateBloodPressure(diastolicBP, 40, 130, 'Diastolic BP');

    // ==================== UTILITY FUNCTIONS ====================
    function isToday(dateString) {
      if (!dateString) return false;
      const logDate = new Date(dateString);
      const today = new Date();
      return logDate.toDateString() === today.toDateString();
    }

    function setReadOnlyMode(readonly) {
      isReadOnly = readonly;
      const allInputs = document.querySelectorAll('input, select, textarea');
      const allButtons = document.querySelectorAll('button[type="button"]');

      allInputs.forEach(input => {
        if (readonly) {
          input.disabled = true;
          input.style.opacity = '0.7';
        } else {
          input.disabled = false;
          input.style.opacity = '1';
        }
      });

      // Disable add buttons but keep tab buttons enabled
      allButtons.forEach(btn => {
        if (btn.id.startsWith('add') || btn.id === 'saveBtn' || btn.id === 'saveCompleteBtn' ||
          btn.id === 'saveSidebarBtn' || btn.id === 'completeSidebarBtn') {
          btn.disabled = readonly;
          btn.style.opacity = readonly ? '0.5' : '1';
        }
      });

      if (readonly) {
        showMsg('This log is from a previous day and cannot be edited.', 'info');
      }
    }

    function showMsg(text, type = 'success') {
      messageEl.textContent = text;
      messageEl.className = `msg ${type}`;
      messageEl.hidden = false;
      setTimeout(() => messageEl.hidden = true, 4000);
    }

    function updateLastSavedTime(timestamp) {
      const lastUpdatedEl = document.getElementById('lastUpdatedTime');
      if (!lastUpdatedEl) return;
      
      const date = new Date(timestamp);
      const now = new Date();
      const diffMs = now - date;
      const diffMins = Math.floor(diffMs / 60000);
      
      let timeText;
      if (diffMins < 1) {
        timeText = 'Just now';
      } else if (diffMins < 60) {
        timeText = `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
      } else {
        const hours = date.getHours();
        const minutes = date.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        const displayHours = hours % 12 || 12;
        timeText = `Today at ${displayHours}:${minutes.toString().padStart(2, '0')} ${ampm}`;
      }
      
      lastUpdatedEl.innerHTML = `<strong>Last saved:</strong> ${timeText}`;
      lastUpdatedEl.style.display = 'block';
    }

    // ==================== TAB SWITCHING ====================
    const tabBasicsBtn = document.getElementById('tabBasicsBtn');
    const tabHealthDetailsBtn = document.getElementById('tabHealthDetailsBtn');
    const tabNotesBtn = document.getElementById('tabNotesBtn');
    const tabBasics = document.getElementById('tabBasics');
    const tabHealthDetails = document.getElementById('tabHealthDetails');
    const tabNotes = document.getElementById('tabNotes');

    function showTab(tab) {
      tabBasics.style.display = tab === 'basics' ? 'block' : 'none';
      tabHealthDetails.style.display = tab === 'health' ? 'block' : 'none';
      tabNotes.style.display = tab === 'notes' ? 'block' : 'none';
      tabBasicsBtn.classList.toggle('active', tab === 'basics');
      tabHealthDetailsBtn.classList.toggle('active', tab === 'health');
      tabNotesBtn.classList.toggle('active', tab === 'notes');
    }
    tabBasicsBtn.addEventListener('click', () => showTab('basics'));
    tabHealthDetailsBtn.addEventListener('click', () => showTab('health'));
    tabNotesBtn.addEventListener('click', () => showTab('notes'));

    // Show fetal movement only if week >= 16
    const fetalMovementSection = document.getElementById('fetalMovementSection');
    if (fetalMovementSection && userContext.pregnancyWeek && userContext.pregnancyWeek >= 16) {
      fetalMovementSection.style.display = '';
    } else if (fetalMovementSection) {
      fetalMovementSection.style.display = 'none';
    }

    // ==================== RANGE SLIDERS ====================
    const bindRange = (id, labelId, format = (v) => v) => {
      const el = document.getElementById(id);
      const lab = document.getElementById(labelId);
      if (!el || !lab) return;
      const update = () => lab.textContent = format(el.value);
      el.addEventListener('input', update);
      update();
    };
    
    // Enhanced bindings with new display elements
    const heartRateInput = document.getElementById('heartRateBpm');
    const heartRateDisplay = document.getElementById('heartRateDisplay');
    if (heartRateInput && heartRateDisplay) {
      heartRateInput.addEventListener('input', () => {
        heartRateDisplay.textContent = heartRateInput.value;
      });
    }

    const waterInput = document.getElementById('waterLiters');
    const waterDisplay = document.getElementById('waterDisplay');
    if (waterInput && waterDisplay) {
      waterInput.addEventListener('input', () => {
        waterDisplay.textContent = waterInput.value;
      });
    }

    const fluidsInput = document.getElementById('otherFluidsLiters');
    const fluidsDisplay = document.getElementById('fluidsDisplay');
    if (fluidsInput && fluidsDisplay) {
      fluidsInput.addEventListener('input', () => {
        fluidsDisplay.textContent = fluidsInput.value;
      });
    }

    const caffeineInput = document.getElementById('caffeineIntakeMg');
    const caffeineDisplay = document.getElementById('caffeineDisplay');
    const caffeineWarning = document.getElementById('caffeineWarning');
    if (caffeineInput && caffeineDisplay) {
      caffeineInput.addEventListener('input', () => {
        const value = caffeineInput.value;
        caffeineDisplay.textContent = value;
        if (caffeineWarning) {
          caffeineWarning.style.display = value > 200 ? 'block' : 'none';
        }
      });
    }

    // Legacy bindings (for backward compatibility)
    bindRange('heartRateBpm', 'hrVal');
    bindRange('sleepHours', 'sleepHoursVal');
    bindRange('waterLiters', 'waterVal');
    bindRange('otherFluidsLiters', 'fluidsVal');
    bindRange('caffeineIntakeMg', 'caffVal');
    bindRange('symptomSeverity', 'sevVal');

    // ==================== SEGMENTED SELECT ====================
    const makeSegmented = (containerId, hiddenId) => {
      const c = document.getElementById(containerId);
      const h = document.getElementById(hiddenId);
      if (!c || !h) return;
      c.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', () => {
          if (isReadOnly) return;
          c.querySelectorAll('button').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          h.value = btn.dataset.val;
        });
      });
    };
    
    // Update for intensity buttons with new class
    const intensityButtons = document.querySelectorAll('.intensity-btn');
    const intensityHidden = document.getElementById('exerciseIntensity');
    if (intensityButtons.length && intensityHidden) {
      intensityButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          if (isReadOnly) return;
          intensityButtons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          intensityHidden.value = btn.dataset.val;
        });
      });
    }

    // ==================== RATING (1-5 STARS) ====================
    const makeRating = (containerId, hiddenId, labelId) => {
      const c = document.getElementById(containerId);
      const h = document.getElementById(hiddenId);
      const label = labelId ? document.getElementById(labelId) : null;
      if (!c || !h) return;
      c.innerHTML = '';
      const labels = {
        energyLabel: ['Very Low', 'Low', 'Moderate', 'High', 'Very High'],
        stressLabel: ['Very Low', 'Low', 'Moderate', 'High', 'Very High']
      };
      const labelTexts = labels[labelId] || [];
      for (let i = 1; i <= 5; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = '★';
        b.dataset.val = i;
        b.style.cssText = 'font-size:20px;color:#C88DA8;background:transparent;border:none;cursor:pointer;margin-right:4px;transition:all 0.2s;';
        b.addEventListener('click', () => {
          if (isReadOnly) return;
          h.value = i;
          [...c.children].forEach((ch, idx) => ch.style.color = idx < i ? '#D91E8F' : '#C88DA8');
          if (label && labelTexts[i-1]) label.textContent = labelTexts[i-1];
          updateLogStatus();
        });
        c.appendChild(b);
      }
    };
    makeRating('energyRating', 'energyLevel', 'energyLabel');
    makeRating('stressRating', 'stressLevel', 'stressLabel');
    
    // Enhanced sleep quality rating with label
    const makeQualityRating = (containerId, hiddenId) => {
      const c = document.getElementById(containerId);
      const h = document.getElementById(hiddenId);
      const label = document.getElementById('qualityLabel');
      if (!c || !h) return;
      c.innerHTML = '';
      const qualities = ['Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
      for (let i = 1; i <= 5; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.textContent = '★';
        b.dataset.val = i;
        b.style.cssText = 'font-size:28px;color:#C88DA8;background:transparent;border:none;cursor:pointer;margin-right:4px;transition:all 0.2s;';
        b.addEventListener('click', () => {
          if (isReadOnly) return;
          h.value = i;
          [...c.children].forEach((ch, idx) => ch.style.color = idx < i ? '#D91E8F' : '#C88DA8');
          if (label) label.textContent = qualities[i-1];
          updateLogStatus();
        });
        c.appendChild(b);
      }
    };
    makeQualityRating('sleepQualityRating', 'sleepQuality');

    // Sleep hours display update
    const sleepHoursInput = document.getElementById('sleepHours');
    const sleepHoursDisplay = document.getElementById('sleepHoursDisplay');
    if (sleepHoursInput && sleepHoursDisplay) {
      sleepHoursInput.addEventListener('input', () => {
        sleepHoursDisplay.textContent = sleepHoursInput.value;
      });
    }

    // Awakening reasons chips
    const awakeningChips = document.querySelectorAll('.awakening-chip');
    const selectedAwakeningReasons = new Set();
    awakeningChips.forEach(chip => {
      chip.addEventListener('click', () => {
        if (isReadOnly) return;
        const reason = chip.dataset.reason;
        if (selectedAwakeningReasons.has(reason)) {
          selectedAwakeningReasons.delete(reason);
          chip.classList.remove('active');
        } else {
          selectedAwakeningReasons.add(reason);
          chip.classList.add('active');
        }
      });
    });

    // ==================== SYMPTOMS ====================
    const symptomDetailsPanel = document.getElementById('symptomDetailsPanel');
    const severityInput = document.getElementById('symptomSeverity');
    const severityBar = document.getElementById('severityBar');
    const severityValue = document.getElementById('severityValue');

    // Update severity display
    if (severityInput && severityBar && severityValue) {
      severityInput.addEventListener('input', () => {
        const value = severityInput.value;
        severityValue.textContent = value;
        severityBar.style.width = (value * 10) + '%';
      });
      // Initialize
      severityInput.dispatchEvent(new Event('input'));
    }

    document.getElementById('symptomChips').addEventListener('click', (e) => {
      if (isReadOnly) return;
      const chip = e.target.closest('.symptom-chip');
      if (chip) {
        // Toggle selection
        const wasActive = chip.classList.contains('active');
        document.querySelectorAll('.symptom-chip').forEach(c => c.classList.remove('active'));
        
        if (!wasActive) {
          chip.classList.add('active');
          symptomDetailsPanel.style.display = 'block';
        } else {
          symptomDetailsPanel.style.display = 'none';
        }
      }
    });

    document.getElementById('addSymptomBtn').addEventListener('click', () => {
      if (isReadOnly) return;
      const activeChip = document.querySelector('.symptom-chip.active');
      if (!activeChip) return;
      const name = activeChip.dataset.symptom;
      const sev = parseInt(document.getElementById('symptomSeverity').value) || 5;
      const occurredAt = document.getElementById('occurredAt').value || null;
      symptoms.push({ symptom: name, severity: sev, occurredAt });
      renderSymptomList();
      activeChip.classList.remove('active');
      symptomDetailsPanel.style.display = 'none';
      document.getElementById('occurredAt').value = '';
      document.getElementById('symptomSeverity').value = 5;
      severityInput.dispatchEvent(new Event('input'));
      updateLogStatus();
    });

    function renderSymptomList() {
      const container = document.getElementById('symptomList');
      if (!container) return;
      
      if (symptoms.length === 0) {
        container.innerHTML = '';
        return;
      }
      
      container.innerHTML = symptoms.map((s, i) => {
        const symptomName = s.symptom.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        const severityColor = s.severity <= 3 ? '#4caf50' : s.severity <= 7 ? '#ffc107' : '#ff5722';
        const severityBadge = `<span style="background:${severityColor};color:white;padding:4px 10px;border-radius:12px;font-size:0.85rem;font-weight:600;">${s.severity}/10</span>`;
        
        return `
          <div class="item-card">
            <div class="item-content">
              <div class="item-title">${symptomName}</div>
              <div class="item-details">
                Severity: ${severityBadge}
                ${s.occurredAt ? ' • Started at ' + s.occurredAt : ''}
              </div>
            </div>
            ${!isReadOnly ? `<button type="button" class="item-remove" onclick="removeSymptom(${i})">×</button>` : ''}
          </div>
        `;
      }).join('');
    }
    window.removeSymptom = (i) => { if (isReadOnly) return; symptoms.splice(i, 1); renderSymptomList(); updateLogStatus(); };

    // ==================== EXERCISES ====================
    document.getElementById('addExerciseBtn').addEventListener('click', () => {
      if (isReadOnly) return;
      const type = document.getElementById('exerciseType').value;
      const durationMinutes = document.getElementById('exerciseMinutes').value ? Number(document.getElementById('exerciseMinutes').value) : null;
      const intensity = document.getElementById('exerciseIntensity').value || 'light';
      const feeling = document.getElementById('exerciseFeeling').value || null;
      const time = document.getElementById('exerciseTime').value || null;
      const notes = document.getElementById('exerciseNotes').value || null;
      if (!type) return;
      exercises.push({ type, durationMinutes, intensity, feeling, time, notes });
      renderExerciseList();
      document.getElementById('exerciseType').value = '';
      document.getElementById('exerciseMinutes').value = '';
      document.getElementById('exerciseFeeling').value = '';
      document.getElementById('exerciseTime').value = '';
      document.getElementById('exerciseNotes').value = '';
      updateLogStatus();
    });

    function renderExerciseList() {
      const container = document.getElementById('exerciseList');
      if (!container) return;
      
      if (exercises.length === 0) {
        container.innerHTML = '';
        return;
      }
      
      container.innerHTML = exercises.map((ex, i) => {
        const typeDisplay = ex.type.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
        const intensityEmoji = ex.intensity === 'light' ? '🟢' : ex.intensity === 'moderate' ? '🟡' : '🔴';
        const feelingEmoji = ex.feeling === 'great' ? '😊' : ex.feeling === 'good' ? '🙂' : ex.feeling === 'okay' ? '😐' : ex.feeling === 'tired' ? '😴' : ex.feeling === 'uncomfortable' ? '😣' : ex.feeling === 'painful' ? '😖' : '';
        
        return `
          <div class="item-card">
            <div class="item-content">
              <div class="item-title">${typeDisplay}</div>
              <div class="item-details">
                ${ex.durationMinutes ? ex.durationMinutes + ' min' : 'Duration not specified'} • 
                ${intensityEmoji} ${ex.intensity} ${ex.feeling ? '• ' + feelingEmoji + ' ' + ex.feeling : ''}
                ${ex.time ? '• at ' + ex.time : ''}
                ${ex.notes ? '<br><small>' + ex.notes + '</small>' : ''}
              </div>
            </div>
            ${!isReadOnly ? `<button type="button" class="item-remove" onclick="removeExercise(${i})">×</button>` : ''}
          </div>
        `;
      }).join('');
    }
    window.removeExercise = (i) => { if (isReadOnly) return; exercises.splice(i, 1); renderExerciseList(); updateLogStatus(); };

    // ==================== MOOD LOG ====================
    document.getElementById('addMoodLogBtn').addEventListener('click', () => {
      if (isReadOnly) return;
      const mood = document.getElementById('moodLogMood').value;
      const trigger = document.getElementById('moodLogTrigger').value;
      if (!mood) return;
      moodLog.push({ mood, trigger, time: new Date().toISOString() });
      renderMoodLogList();
      document.getElementById('moodLogMood').value = '';
      document.getElementById('moodLogTrigger').value = '';
      updateLogStatus();
    });

    function renderMoodLogList() {
      const list = document.getElementById('moodLogList');
      list.innerHTML = moodLog.map((m, i) => `
      <div class="mood-log-item">
        <span>${m.mood}${m.trigger ? ' · ' + m.trigger : ''}</span>
        ${!isReadOnly ? `<button type="button" class="mood-log-item-remove" onclick="removeMoodLog(${i})">×</button>` : ''}
      </div>
    `).join('');
    }
    window.removeMoodLog = (i) => { if (isReadOnly) return; moodLog.splice(i, 1); renderMoodLogList(); updateLogStatus(); };

    // ==================== DRINKS ====================
    document.getElementById('addDrinkBtn').addEventListener('click', () => {
      if (isReadOnly) return;
      const type = document.getElementById('drinkType').value;
      const amountMl = document.getElementById('drinkAmount').value ? Number(document.getElementById('drinkAmount').value) : null;
      if (!type) return;
      drinks.push({ type, amountMl, time: null });
      renderDrinkList();
      document.getElementById('drinkType').value = '';
      document.getElementById('drinkAmount').value = '';
      updateLogStatus();
    });

    function renderDrinkList() {
      const list = document.getElementById('drinkList');
      list.innerHTML = drinks.map((d, i) => `
      <div class="drink-chip">
        <span>${d.type} • ${d.amountMl || '-'} ml${d.time ? ' at ' + d.time : ''}</span>
        ${!isReadOnly ? `<button type="button" class="drink-chip-remove" onclick="removeDrink(${i})">×</button>` : ''}
      </div>
    `).join('');
    }
    window.removeDrink = (i) => { if (isReadOnly) return; drinks.splice(i, 1); renderDrinkList(); updateLogStatus(); };

    // ==================== FOODS ====================
    document.getElementById('addFoodBtn').addEventListener('click', () => {
      if (isReadOnly) return;
      const name = document.getElementById('foodName').value.trim();
      const amount = document.getElementById('foodAmount').value ? Number(document.getElementById('foodAmount').value) : null;
      const unit = document.getElementById('foodUnit')?.value || 'g';
      if (!name) return;
      currentFoodList.push({ name, amount, unit });
      renderFoodList();
      document.getElementById('foodName').value = '';
      document.getElementById('foodAmount').value = '';
    });

    function renderFoodList() {
      const container = document.getElementById('foodList');
      if (!container) return;
      
      if (currentFoodList.length === 0) {
        container.innerHTML = '';
        return;
      }
      
      container.innerHTML = currentFoodList.map((f, i) => `
        <div class="food-chip">
          <span>${f.name}${f.amount ? ' (' + f.amount + (f.unit || 'g') + ')' : ''}</span>
          ${!isReadOnly ? `<button type="button" class="food-chip-remove" onclick="removeFood(${i})">×</button>` : ''}
        </div>
      `).join('');
    }
    window.removeFood = (i) => { if (isReadOnly) return; currentFoodList.splice(i, 1); renderFoodList(); };
    
    // Meal skipped checkbox handler
    // ==================== MEALS ====================
    document.getElementById('addMealBtn').addEventListener('click', () => {
      if (isReadOnly) return;
      const mealType = document.getElementById('mealType').value;
      const time = document.getElementById('mealTime').value || null;
      const notes = document.getElementById('mealNotes').value || null;
      if (!mealType) return;

      meals.push({ mealType, time, foods: [...currentFoodList], notes });
      renderMealList();
      currentFoodList = [];
      renderFoodList();
      document.getElementById('mealType').value = '';
      document.getElementById('mealTime').value = '';
      document.getElementById('mealNotes').value = '';
      updateLogStatus();
    });

    function renderMealList() {
      const container = document.getElementById('mealList');
      if (!container) return;
      
      if (meals.length === 0) {
        container.innerHTML = '';
        return;
      }
      
      container.innerHTML = meals.map((m, i) => {
        const mealTypeDisplay = m.mealType ? m.mealType.charAt(0).toUpperCase() + m.mealType.slice(1) : 'Meal';
        const mealEmoji = m.mealType === 'breakfast' ? '🍳' : m.mealType === 'lunch' ? '🥙' : m.mealType === 'dinner' ? '🍽️' : m.mealType === 'snack' ? '🍎' : '🍴';
        const foodsText = m.foods && m.foods.length > 0 
          ? m.foods.map(f => `${f.name}${f.amount ? ' (' + f.amount + (f.unit || 'g') + ')' : ''}`).join(', ')
          : '';
        
        return `
          <div class="item-card">
            <div class="item-content">
              <div class="item-title">${mealEmoji} ${mealTypeDisplay}${m.time ? ' at ' + m.time : ''}</div>
              <div class="item-details">
                ${foodsText ? 'Foods: ' + foodsText : 'No foods added'}
                ${m.notes ? '<br><small>' + m.notes + '</small>' : ''}
              </div>
            </div>
            ${!isReadOnly ? `<button type="button" class="item-remove" onclick="removeMeal(${i})">×</button>` : ''}
          </div>
        `;
      }).join('');
    }
    window.removeMeal = (i) => { if (isReadOnly) return; meals.splice(i, 1); renderMealList(); updateLogStatus(); };

    // ==================== LOG STATUS ====================
    function isSection1Filled() {
      return !!(
        document.getElementById('weightKg').value ||
        parseInt(document.getElementById('heartRateBpm').value) > 50 ||
        document.getElementById('energyLevel').value ||
        document.getElementById('stressLevel').value ||
        parseFloat(document.getElementById('sleepHours').value) > 0 ||
        document.getElementById('sleepQuality').value ||
        symptoms.length > 0 ||
        moodLog.length > 0 ||
        naps.length > 0
      );
    }

    function isSection2Filled() {
      return !!(
        parseFloat(document.getElementById('waterLiters').value) > 0 ||
        parseFloat(document.getElementById('otherFluidsLiters').value) > 0 ||
        parseInt(document.getElementById('caffeineIntakeMg').value) > 0 ||
        drinks.length > 0 ||
        exercises.length > 0 ||
        meals.length > 0 ||
        (document.getElementById('fmKickCount') && document.getElementById('fmKickCount').value)
      );
    }

    function isSection3Filled() {
      return !!(
        document.getElementById('visitedDoctor').checked ||
        document.getElementById('visitType').value ||
        document.getElementById('doctorVisitNotes').value ||
        document.getElementById('nextAppointment').value ||
        document.getElementById('notes').value
      );
    }

    function updateLogStatus() {
      let filled = 0;
      if (isSection1Filled()) filled++;
      if (isSection2Filled()) filled++;
      if (isSection3Filled()) filled++;
      document.getElementById('statSections').textContent = `${filled}/3`;

      const progress = filled / 3;
      document.getElementById('logProgress').style.width = (progress * 100) + '%';
      document.getElementById('logStatusText').textContent = filled === 3 ? 'Complete' : (filled > 0 ? 'In Progress' : 'Draft');
      document.getElementById('logDetail').textContent = filled === 3
        ? 'All sections complete!'
        : 'Complete more sections to improve insights.';

      document.getElementById('statWeek').textContent = userContext.pregnancyWeek || '-';
      document.getElementById('statTrimester').textContent = userContext.trimester || '-';
      document.getElementById('statEnergy').textContent = document.getElementById('energyLevel').value || '-';
      document.getElementById('statSleep').textContent = document.getElementById('sleepHours').value || '-';
      document.getElementById('statWater').textContent = document.getElementById('waterLiters').value || '-';
    }

    // Listen to inputs for status update
    ['weightKg', 'heartRateBpm', 'sleepHours', 'waterLiters', 'otherFluidsLiters', 'caffeineIntakeMg'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('input', updateLogStatus);
    });
    ['visitedDoctor'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener('change', updateLogStatus);
    });

    // ==================== COLLECT FORM DATA ====================
    function collectFormData() {
      return {
        weightKg: parseFloat(document.getElementById('weightKg').value) || null,
        heartRateBpm: parseInt(document.getElementById('heartRateBpm').value) || null,
        bloodPressure: {
          systolic: parseInt(document.getElementById('systolicBP')?.value) || null,
          diastolic: parseInt(document.getElementById('diastolicBP')?.value) || null
        },
        bloodSugar: {
          value: parseFloat(document.getElementById('bloodSugarValue').value) || null,
          unit: document.getElementById('bloodSugarUnit').value || 'mg/dL',
          timing: document.getElementById('bloodSugarTiming').value || null,
          measuredAt: null
        },
        energyLevel: parseInt(document.getElementById('energyLevel').value) || null,
        stressLevel: parseInt(document.getElementById('stressLevel').value) || null,
        moodLog: moodLog,
        sleep: {
          totalHours: parseFloat(document.getElementById('sleepHours').value) || null,
          quality: parseInt(document.getElementById('sleepQuality').value) || null,
          bedTime: document.getElementById('bedTime').value || null,
          wakeTime: document.getElementById('wakeTime').value || null,
          primaryPosition: document.getElementById('primaryPosition').value || null,
          awakeningReasons: Array.from(selectedAwakeningReasons),
          naps: []
        },
        symptoms: symptoms,
        exercises: exercises,
        hydration: {
          waterLiters: parseFloat(document.getElementById('waterLiters').value) || 0,
          otherFluidsLiters: parseFloat(document.getElementById('otherFluidsLiters').value) || 0,
          drinks: drinks
        },
        caffeineIntakeMg: parseInt(document.getElementById('caffeineIntakeMg').value) || null,
        foodIntake: meals,
        fetalMovement: {
          startTime: document.getElementById('fmStartTime')?.value || null,
          endTime: document.getElementById('fmEndTime')?.value || null,
          count: parseInt(document.getElementById('fmKickCount')?.value) || null,
          motherPosition: document.getElementById('fmMotherPosition')?.value || null,
          timeSinceMeal: document.getElementById('fmTimeSinceMeal')?.value || null,
          notes: document.getElementById('fmNotes')?.value || null
        },
        doctorVisit: {
          visited: document.getElementById('visitedDoctor').checked,
          visitType: document.getElementById('visitType').value || null,
          notes: document.getElementById('doctorVisitNotes').value || null,
          nextAppointment: document.getElementById('nextAppointment').value || null
        },
        notes: document.getElementById('notes').value || null
      };
    }

    // ==================== POPULATE FORM FROM LOG ====================
    function populateForm(log) {
      if (!log) return;

      currentLogId = log._id;
      currentLogDate = log.logDate;

      // Check if log is from today - if not, make read-only
      if (!isToday(log.logDate)) {
        setReadOnlyMode(true);
      } else {
        setReadOnlyMode(false);
      }

      // Vitals
      const weightInput = document.getElementById('weightKg');
      if (log.weightKg && weightInput) weightInput.value = log.weightKg;
      if (log.heartRateBpm) {
        const heartRateInput = document.getElementById('heartRateBpm');
        if (heartRateInput) heartRateInput.value = log.heartRateBpm;
        const hrVal = document.getElementById('hrVal');
        if (hrVal) hrVal.textContent = log.heartRateBpm;
        const heartRateDisplay = document.getElementById('heartRateDisplay');
        if (heartRateDisplay) heartRateDisplay.textContent = log.heartRateBpm;
      }
      if (log.bloodPressure) {
        if (log.bloodPressure.systolic && document.getElementById('systolicBP')) {
          document.getElementById('systolicBP').value = log.bloodPressure.systolic;
        }
        if (log.bloodPressure.diastolic && document.getElementById('diastolicBP')) {
          document.getElementById('diastolicBP').value = log.bloodPressure.diastolic;
        }
      }
      if (log.bloodSugar?.value) {
        const bloodSugarValueInput = document.getElementById('bloodSugarValue');
        if (bloodSugarValueInput) bloodSugarValueInput.value = log.bloodSugar.value;
        const bloodSugarUnitInput = document.getElementById('bloodSugarUnit');
        if (bloodSugarUnitInput) bloodSugarUnitInput.value = log.bloodSugar.unit || 'mg/dL';
        const bloodSugarTimingInput = document.getElementById('bloodSugarTiming');
        if (bloodSugarTimingInput) bloodSugarTimingInput.value = log.bloodSugar.timing || '';
      }

      // Energy & Stress
      if (log.energyLevel) {
        const energyLevelInput = document.getElementById('energyLevel');
        if (energyLevelInput) energyLevelInput.value = log.energyLevel;
        const rating = document.getElementById('energyRating');
        if (rating && rating.children) {
          [...rating.children].forEach((ch, idx) => ch.style.color = idx < log.energyLevel ? '#D91E8F' : '#C88DA8');
        }
        const energyLabel = document.getElementById('energyLabel');
        if (energyLabel) {
          const labels = ['Very Low', 'Low', 'Moderate', 'High', 'Very High'];
          energyLabel.textContent = labels[log.energyLevel - 1];
        }
      }
      if (log.stressLevel) {
        const stressLevelInput = document.getElementById('stressLevel');
        if (stressLevelInput) stressLevelInput.value = log.stressLevel;
        const rating = document.getElementById('stressRating');
        if (rating && rating.children) {
          [...rating.children].forEach((ch, idx) => ch.style.color = idx < log.stressLevel ? '#D91E8F' : '#C88DA8');
        }
        const stressLabel = document.getElementById('stressLabel');
        if (stressLabel) {
          const labels = ['Very Low', 'Low', 'Moderate', 'High', 'Very High'];
          stressLabel.textContent = labels[log.stressLevel - 1];
        }
      }

      // Mood Log
      if (log.moodLog?.length) {
        moodLog = [...log.moodLog];
        renderMoodLogList();
      }

      // Sleep
      if (log.sleep) {
        if (log.sleep.totalHours) {
          document.getElementById('sleepHours').value = log.sleep.totalHours;
          if (document.getElementById('sleepHoursDisplay')) {
            document.getElementById('sleepHoursDisplay').textContent = log.sleep.totalHours;
          }
          if (document.getElementById('sleepHoursVal')) {
            document.getElementById('sleepHoursVal').textContent = log.sleep.totalHours;
          }
        }
        if (log.sleep.quality) {
          const sleepQualityInput = document.getElementById('sleepQuality');
          if (sleepQualityInput) sleepQualityInput.value = log.sleep.quality;
          const rating = document.getElementById('sleepQualityRating');
          if (rating && rating.children) {
            const qualities = ['Poor', 'Fair', 'Good', 'Very Good', 'Excellent'];
            [...rating.children].forEach((ch, idx) => ch.style.color = idx < log.sleep.quality ? '#D91E8F' : '#C88DA8');
            const qualityLabel = document.getElementById('qualityLabel');
            if (qualityLabel) qualityLabel.textContent = qualities[log.sleep.quality - 1];
          }
        }
        const bedTimeInput = document.getElementById('bedTime');
        if (log.sleep.bedTime && bedTimeInput) bedTimeInput.value = log.sleep.bedTime;
        const wakeTimeInput = document.getElementById('wakeTime');
        if (log.sleep.wakeTime && wakeTimeInput) wakeTimeInput.value = log.sleep.wakeTime;
        const primaryPositionInput = document.getElementById('primaryPosition');
        if (log.sleep.primaryPosition && primaryPositionInput) primaryPositionInput.value = log.sleep.primaryPosition;
        
        // Awakening reasons
        if (log.sleep.awakeningReasons?.length) {
          selectedAwakeningReasons.clear();
          log.sleep.awakeningReasons.forEach(reason => {
            selectedAwakeningReasons.add(reason);
            const chip = document.querySelector(`.awakening-chip[data-reason="${reason}"]`);
            if (chip) chip.classList.add('active');
          });
        }
      }

      // Symptoms
      if (log.symptoms?.length) {
        symptoms = [...log.symptoms];
        renderSymptomList();
      }

      // Exercises
      if (log.exercises?.length) {
        exercises = [...log.exercises];
        renderExerciseList();
      }

      // Hydration
      if (log.hydration) {
        if (log.hydration.waterLiters) {
          const waterLitersInput = document.getElementById('waterLiters');
          if (waterLitersInput) waterLitersInput.value = log.hydration.waterLiters;
          const waterVal = document.getElementById('waterVal');
          if (waterVal) waterVal.textContent = log.hydration.waterLiters;
          const waterDisplay = document.getElementById('waterDisplay');
          if (waterDisplay) waterDisplay.textContent = log.hydration.waterLiters;
        }
        if (log.hydration.otherFluidsLiters) {
          const otherFluidsInput = document.getElementById('otherFluidsLiters');
          if (otherFluidsInput) otherFluidsInput.value = log.hydration.otherFluidsLiters;
          const fluidsVal = document.getElementById('fluidsVal');
          if (fluidsVal) fluidsVal.textContent = log.hydration.otherFluidsLiters;
          const fluidsDisplay = document.getElementById('fluidsDisplay');
          if (fluidsDisplay) fluidsDisplay.textContent = log.hydration.otherFluidsLiters;
        }
        if (log.hydration.drinks?.length) {
          drinks = [...log.hydration.drinks];
          renderDrinkList();
        }
      }
      if (log.caffeineIntakeMg) {
        const caffeineInput = document.getElementById('caffeineIntakeMg');
        if (caffeineInput) caffeineInput.value = log.caffeineIntakeMg;
        const caffVal = document.getElementById('caffVal');
        if (caffVal) caffVal.textContent = log.caffeineIntakeMg;
        const caffeineDisplay = document.getElementById('caffeineDisplay');
        if (caffeineDisplay) caffeineDisplay.textContent = log.caffeineIntakeMg;
        const caffeineWarning = document.getElementById('caffeineWarning');
        if (caffeineWarning) {
          caffeineWarning.style.display = log.caffeineIntakeMg > 200 ? 'flex' : 'none';
        }
      }

      // Meals
      if (log.foodIntake?.length) {
        meals = [...log.foodIntake];
        renderMealList();
      }

      // Fetal Movement
      if (log.fetalMovement) {
        const fm = log.fetalMovement;
        if (fm.startTime && document.getElementById('fmStartTime')) document.getElementById('fmStartTime').value = fm.startTime;
        if (fm.endTime && document.getElementById('fmEndTime')) document.getElementById('fmEndTime').value = fm.endTime;
        if (fm.count && document.getElementById('fmKickCount')) document.getElementById('fmKickCount').value = fm.count;
        if (fm.motherPosition && document.getElementById('fmMotherPosition')) document.getElementById('fmMotherPosition').value = fm.motherPosition;
        if (fm.timeSinceMeal && document.getElementById('fmTimeSinceMeal')) document.getElementById('fmTimeSinceMeal').value = fm.timeSinceMeal;
        if (fm.notes && document.getElementById('fmNotes')) document.getElementById('fmNotes').value = fm.notes;
      }

      // Doctor Visit
      if (log.doctorVisit) {
        document.getElementById('visitedDoctor').checked = log.doctorVisit.visited || false;
        if (log.doctorVisit.visitType) document.getElementById('visitType').value = log.doctorVisit.visitType;
        if (log.doctorVisit.notes) document.getElementById('doctorVisitNotes').value = log.doctorVisit.notes;
        if (log.doctorVisit.nextAppointment) {
          const dateStr = new Date(log.doctorVisit.nextAppointment).toISOString().split('T')[0];
          document.getElementById('nextAppointment').value = dateStr;
        }
      }

      // Notes
      if (log.notes) document.getElementById('notes').value = log.notes;

      // Update status
      updateLogStatus();
    }

    // ==================== LOAD TODAY'S LOG ====================
    async function loadTodayLog() {
      try {
        const resp = await fetch('/api/health-log/today', {
          credentials: 'include',
          cache: 'no-store',
          headers: { 'Cache-Control': 'no-cache' }
        });
        const result = await resp.json();

        if (result.success && result.log) {
          // Update user context from server
          if (result.userContext) {
            userContext.pregnancyWeek = result.userContext.pregnancyWeek;
            userContext.trimester = result.userContext.trimester;

            // Show/hide fetal movement section based on week
            if (fetalMovementSection) {
              fetalMovementSection.style.display = userContext.pregnancyWeek >= 16 ? '' : 'none';
            }
          }

          populateForm(result.log);
        }
      } catch (err) {
        console.error('Failed to load health log:', err);
        showMsg('Failed to load health log', 'error');
      }
    }

    // ==================== SAVE LOG ====================
    async function saveLog(markComplete = false) {
      if (isReadOnly) {
        showMsg('Cannot edit logs from previous days', 'error');
        return;
      }

      // Disable buttons during save
      saveBtn.disabled = true;
      saveCompleteBtn.disabled = true;
      saveSidebarBtn.disabled = true;
      completeSidebarBtn.disabled = true;
      saveBtn.textContent = 'Saving...';

      const formData = collectFormData();
      formData.isComplete = markComplete;
      
      // Debug: Log what we're sending
      console.log('Sending data to server:', JSON.stringify(formData, null, 2));

      try {
        const resp = await fetch('/api/health-log', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(formData)
        });

        const result = await resp.json();
        
        // Debug: Log server response
        console.log('Server response:', result);

        if (result.success) {
          showMsg(markComplete ? 'Log saved and marked complete!' : 'Log saved successfully!', 'success');
          if (result.log) {
            currentLogId = result.log._id;
            console.log('Saved log ID:', currentLogId);
            // Update last saved timestamp
            updateLastSavedTime(result.log.updatedAt || new Date().toISOString());
          }
          updateLogStatus();
        } else {
          showMsg(result.error || 'Failed to save log', 'error');
          console.error('Save failed:', result.error);
        }
      } catch (err) {
        console.error('Save error:', err);
        showMsg('Network error - please try again', 'error');
      } finally {
        saveBtn.disabled = false;
        saveCompleteBtn.disabled = false;
        saveSidebarBtn.disabled = false;
        completeSidebarBtn.disabled = false;
        saveBtn.textContent = 'Save';
      }
    }

    // ==================== EVENT LISTENERS ====================
    saveBtn.addEventListener('click', () => saveLog(false));
    saveCompleteBtn.addEventListener('click', () => saveLog(true));
    saveSidebarBtn.addEventListener('click', () => saveLog(false));
    completeSidebarBtn.addEventListener('click', () => saveLog(true));

    // ==================== INITIALIZE ====================
    loadTodayLog();
    updateLogStatus();
  })();
</script>

