<link rel="stylesheet" href="/css/user-edit.css">
<link rel="stylesheet" href="/css/healthlog.css">

<div class="healthlog-bg">
  <main class="container healthlog-main" role="main">
    <header class="healthlog-header">
      <div class="brand">
        <div class="title">Daily Health Log</div>
        <div class="subtitle">Quick, optional entries to personalize your AI insights</div>
      </div>
    </header>
    <!-- Sticky action bar with tab navigation -->
    <nav class="card healthlog-actionbar">
      <button type="button" class="step-label tab-btn active" id="tabBasicsBtn">1. Today’s Basics</button>
      <button type="button" class="step-label tab-btn" id="tabHealthDetailsBtn">2. Health Details</button>
      <button type="button" class="step-label tab-btn" id="tabNotesBtn">3. Details & Notes</button>
      <div class="action-btns">
        <button type="button" class="btn-ghost" id="saveBtn">Save</button>
        <button type="button" class="btn-primary" id="saveCompleteBtn">Save & Mark Complete</button>
      </div>
    </nav>
    <div id="message" class="msg" hidden></div>

    <div class="healthlog-grid">
      <!-- Main Form -->
      <form id="healthLogForm" novalidate>
        <!-- 1. Today’s Basics -->
        <section class="card healthlog-card tab-section" id="tabBasics" style="display:block;">
          <h2 class="card-title">Today’s Basics</h2>

          <!-- Vitals Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🩺</span> Vitals
              <span class="section-status incomplete" id="vitalsStatus">Not started</span>
            </div>
            <div class="vitals-form">
              <div class="row two">
                <div class="field">
                  <label for="weightKg">
                    💪 Weight <span class="required-badge">Required</span>
                    <span class="info-tooltip">
                      <span class="tooltip-content">Track your weight regularly. Normal weight gain during pregnancy varies by trimester.</span>
                    </span>
                  </label>
                  <div class="input-with-unit">
                    <input id="weightKg" type="number" step="0.1" min="20" max="300" placeholder="e.g., 65.5" class="input-primary" required>
                    <span class="input-unit">kg</span>
                  </div>
                  <span class="field-hint">Valid range: 20-300 kg</span>
                  <div class="validation-message" id="weightValidation"></div>
                </div>
                <div class="field">
                  <label for="heartRateBpm">
                    ❤️ Heart Rate <span class="required-badge">Required</span>
                    <span class="info-tooltip">
                      <span class="tooltip-content">Resting heart rate typically increases 10-20 bpm during pregnancy. Normal range: 60-100 bpm.</span>
                    </span>
                  </label>
                  <div class="heart-rate-display">
                    <span class="heart-value" id="heartRateDisplay">—</span>
                    <span class="heart-label">bpm</span>
                  </div>
                  <input id="heartRateBpm" type="range" min="50" max="160" step="1" class="custom-range" required>
                  <div class="range-labels">
                    <span>50 (Low)</span>
                    <span>105 (Normal)</span>
                    <span>160 (High)</span>
                  </div>
                  <div class="validation-message" id="heartRateValidation"></div>
                </div>
              </div>

              <div class="vitals-optional-section">
                <div class="row two">
                  <div class="field">
                    <label>
                      🩸 Blood Sugar <span class="optional-badge">Optional</span>
                      <span class="info-tooltip">
                        <span class="tooltip-content">Monitor blood sugar if recommended by your healthcare provider. Gestational diabetes affects 2-10% of pregnancies.</span>
                      </span>
                    </label>
                    <div class="blood-sugar-inputs">
                      <input id="bloodSugarValue" type="number" step="0.1" min="0" max="500" placeholder="Value" class="input-primary sugar-value-input">
                      <select id="bloodSugarUnit" class="input-primary sugar-unit-select">
                        <option value="mg/dL">mg/dL</option>
                        <option value="mmol/L">mmol/L</option>
                      </select>
                    </div>
                    <select id="bloodSugarTiming" class="input-primary" style="margin-top:8px;">
                      <option value="">When was it measured?</option>
                      <option value="fasting">🌅 Fasting (morning)</option>
                      <option value="before_meal">🍽️ Before Meal</option>
                      <option value="after_meal">✅ After Meal (2hr)</option>
                      <option value="bedtime">🌙 Bedtime</option>
                    </select>
                    <span class="field-hint">Fasting: 70-95 mg/dL | After meal: &lt;140 mg/dL</span>
                    <div class="validation-message" id="bloodSugarValidation"></div>
                  </div>
                  <div class="field">
                    <label>
                      💉 Blood Pressure <span class="required-badge">Required</span>
                      <span class="info-tooltip">
                        <span class="tooltip-content">Blood pressure above 140/90 mmHg may indicate hypertension. Contact your healthcare provider if readings are consistently high.</span>
                      </span>
                    </label>
                    <div class="blood-pressure-inputs">
                      <input id="systolicBP" type="number" min="70" max="200" placeholder="120" class="input-primary bp-input" required aria-label="Systolic blood pressure">
                      <span class="bp-separator">/</span>
                      <input id="diastolicBP" type="number" min="40" max="130" placeholder="80" class="input-primary bp-input" required aria-label="Diastolic blood pressure">
                      <span class="bp-unit">mmHg</span>
                    </div>
                    <span class="field-hint info">🎯 Target: 90-120 / 60-80 mmHg</span>
                    <div class="validation-message" id="bpValidation"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Mood & Energy Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🙂</span> Mood & Energy
              <span class="section-status incomplete" id="moodStatus">Not started</span>
            </div>
            <div class="mood-energy-form">
              <div class="row two">
                <div class="field">
                  <label>
                    ⚡ Energy Level
                    <span class="info-tooltip">
                      <span class="tooltip-content">Rate your overall energy. Fatigue is common in 1st and 3rd trimesters.</span>
                    </span>
                  </label>
                  <div class="energy-rating-container">
                    <div class="rating energy-rating" id="energyRating" aria-label="Energy level from 1 to 5"></div>
                    <span class="rating-label" id="energyLabel">Not rated</span>
                  </div>
                  <input type="hidden" id="energyLevel">
                </div>
                <div class="field">
                  <label>
                    😰 Stress Level
                    <span class="info-tooltip">
                      <span class="tooltip-content">Managing stress is important for you and baby. Consider relaxation techniques if stress is high.</span>
                    </span>
                  </label>
                  <div class="stress-rating-container">
                    <div class="rating stress-rating" id="stressRating" aria-label="Stress level from 1 to 5"></div>
                    <span class="rating-label" id="stressLabel">Not rated</span>
                  </div>
                  <input type="hidden" id="stressLevel">
                </div>
              </div>

              <div class="mood-log-section">
                <label class="section-sublabel">
                  💭 Track Your Mood Throughout the Day <span class="optional-badge">Optional</span>
                  <span class="info-tooltip">
                    <span class="tooltip-content">Log mood changes to identify patterns. Hormonal changes can affect emotions - this is normal!</span>
                  </span>
                </label>
                <div class="mood-log-inputs">
                  <select id="moodLogMood" class="input-primary mood-select" aria-label="Select your current mood">
                    <option value="">How are you feeling?</option>
                    <option value="very_happy">😁 Very Happy</option>
                    <option value="happy">🙂 Happy</option>
                    <option value="neutral">😐 Neutral</option>
                    <option value="anxious">😟 Anxious</option>
                    <option value="sad">😢 Sad</option>
                    <option value="stressed">😣 Stressed</option>
                    <option value="irritable">😠 Irritable</option>
                    <option value="emotional">😭 Emotional</option>
                    <option value="overwhelmed">😩 Overwhelmed</option>
                  </select>
                  <input id="moodLogTrigger" class="input-primary mood-trigger-input" type="text" placeholder="What triggered this feeling? (optional)" maxlength="100" aria-label="Mood trigger">
                  <button type="button" class="btn-add-mood" id="addMoodLogBtn">
                    <span>+ Add</span>
                  </button>
                </div>
                <span class="field-hint">Add multiple entries to track mood changes throughout the day</span>
                <div id="moodLogList" class="mood-log-list"></div>
              </div>
            </div>
          </div>

          <!-- Sleep Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">😴</span> Sleep
              <span class="section-status incomplete" id="sleepStatus">Not started</span>
            </div>
            <div class="sleep-form">
              <div class="row two">
                <div class="field">
                  <label for="sleepHours">
                    Total Sleep Hours
                    <span class="info-tooltip">
                      <span class="tooltip-content">Aim for 7-9 hours of sleep. Quality matters as much as quantity during pregnancy.</span>
                    </span>
                  </label>
                  <div class="sleep-hours-display">
                    <span class="hours-value" id="sleepHoursDisplay">0</span>
                    <span class="hours-label">hours</span>
                  </div>
                  <input id="sleepHours" type="range" min="0" max="12" step="0.5" class="custom-range" aria-label="Total sleep hours">
                  <div class="range-labels">
                    <span>0h (None)</span>
                    <span>6h (Fair)</span>
                    <span>12h (Max)</span>
                  </div>
                  <span class="field-hint" id="sleepHint">Recommended: 7-9 hours per night</span>
                </div>
                <div class="field">
                  <label>
                    Sleep Quality
                    <span class="info-tooltip">
                      <span class="tooltip-content">Poor sleep quality may be due to discomfort, frequent urination, or anxiety. Try relaxation techniques before bed.</span>
                    </span>
                  </label>
                  <div class="quality-stars-container">
                    <div class="rating quality-rating" id="sleepQualityRating" aria-label="Sleep quality from 1 to 5 stars"></div>
                    <span class="quality-label" id="qualityLabel">Not rated</span>
                  </div>
                  <input type="hidden" id="sleepQuality">
                </div>
              </div>

              <div class="sleep-details-card">
                <div class="row three">
                  <div class="field">
                    <label for="bedTime">🌙 Bed Time</label>
                    <input id="bedTime" type="time" class="input-primary" aria-label="Bed time">
                  </div>
                  <div class="field">
                    <label for="wakeTime">☀️ Wake Time</label>
                    <input id="wakeTime" type="time" class="input-primary" aria-label="Wake time">
                  </div>
                  <div class="field">
                    <label for="primaryPosition">
                      🛏️ Sleep Position
                      <span class="info-tooltip">
                        <span class="tooltip-content">Left side sleeping is recommended after 20 weeks as it improves blood flow to baby.</span>
                      </span>
                    </label>
                    <select id="primaryPosition" class="input-primary" aria-label="Primary sleep position">
                      <option value="">Choose position...</option>
                      <option value="left_side">✅ Left Side (Recommended)</option>
                      <option value="right_side">Right Side</option>
                      <option value="back">⚠️ Back (Not recommended after 20 weeks)</option>
                      <option value="varied">Varied</option>
                    </select>
                  </div>
                </div>

                <div class="field">
                  <label class="section-sublabel">What woke you up during the night? <span class="optional-badge">Select all that apply</span></label>
                  <div class="awakening-chips" id="awakeningChips">
                    <button type="button" class="awakening-chip" data-reason="bathroom" aria-pressed="false">🚽 Bathroom</button>
                    <button type="button" class="awakening-chip" data-reason="discomfort" aria-pressed="false">😣 Discomfort</button>
                    <button type="button" class="awakening-chip" data-reason="baby_movement" aria-pressed="false">👶 Baby Movement</button>
                    <button type="button" class="awakening-chip" data-reason="noise" aria-pressed="false">🔊 Noise</button>
                    <button type="button" class="awakening-chip" data-reason="pain" aria-pressed="false">😖 Pain</button>
                    <button type="button" class="awakening-chip" data-reason="nightmare" aria-pressed="false">😰 Nightmare</button>
                    <button type="button" class="awakening-chip" data-reason="other" aria-pressed="false">Other</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Symptoms Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🤒</span> Symptoms
              <span class="section-status incomplete" id="symptomsStatus">Not started</span>
            </div>
            <div class="symptoms-form">
              <label class="section-sublabel">
                Select symptoms you're experiencing <span class="optional-badge">Optional</span>
                <span class="info-tooltip">
                  <span class="tooltip-content">Tracking symptoms helps identify patterns. Contact your healthcare provider for severe or persistent symptoms.</span>
                </span>
              </label>
              <div class="symptom-chips" id="symptomChips">
                <button type="button" class="symptom-chip" data-symptom="nausea" aria-pressed="false">🤢 Nausea</button>
                <button type="button" class="symptom-chip" data-symptom="fatigue" aria-pressed="false">😴 Fatigue</button>
                <button type="button" class="symptom-chip" data-symptom="headache" aria-pressed="false">🤕 Headache</button>
                <button type="button" class="symptom-chip" data-symptom="back_pain" aria-pressed="false">🔙 Back Pain</button>
                <button type="button" class="symptom-chip" data-symptom="spotting" aria-pressed="false">🩸 Spotting</button>
                <button type="button" class="symptom-chip" data-symptom="leg_cramps" aria-pressed="false">🦵 Leg Cramps</button>
                <button type="button" class="symptom-chip" data-symptom="heartburn" aria-pressed="false">🔥 Heartburn</button>
                <button type="button" class="symptom-chip" data-symptom="swelling_feet" aria-pressed="false">🦶 Swelling</button>
              </div>

              <div class="symptom-details-panel" id="symptomDetailsPanel" style="display:none;">
                <div class="row two">
                  <div class="field">
                    <label for="symptomSeverity">
                      How severe? (1-10)
                      <span class="info-tooltip">
                        <span class="tooltip-content">1-3: Mild | 4-6: Moderate | 7-10: Severe. Contact your doctor for severity 8+.</span>
                      </span>
                    </label>
                    <div class="severity-display">
                      <div class="severity-bar-container">
                        <div class="severity-bar" id="severityBar"></div>
                      </div>
                      <span class="severity-value" id="severityValue">5</span>
                    </div>
                    <input id="symptomSeverity" type="range" min="1" max="10" step="1" value="5" class="custom-range" aria-label="Symptom severity">
                    <div class="range-labels">
                      <span>Mild (1-3)</span>
                      <span>Moderate (4-6)</span>
                      <span>Severe (7-10)</span>
                    </div>
                    <div class="validation-message warning" id="severityWarning" style="display:none;">
                      ⚠️ Consider contacting your healthcare provider for severe symptoms
                    </div>
                  </div>
                  <div class="field">
                    <label for="occurredAt">Time it started (optional)</label>
                    <input id="occurredAt" type="time" class="input-primary" aria-label="Time symptom occurred">
                  </div>
                </div>
                <button type="button" class="btn-add-item" id="addSymptomBtn">
                  <span class="btn-icon">+</span> Add This Symptom
                </button>
              </div>
            </div>
            
            <div id="symptomList" class="item-list"></div>
          </div>

          <!-- Tab Navigation -->
          <div class="tab-navigation">
            <button type="button" class="tab-nav-btn tab-nav-prev" id="prevBtnBasics" style="visibility: hidden;">
              <span class="nav-arrow">←</span> Previous
            </button>
            <span class="tab-nav-indicator">1 of 3</span>
            <button type="button" class="tab-nav-btn tab-nav-next" id="nextBtnBasics">
              Next <span class="nav-arrow">→</span>
            </button>
          </div>
        </section>

        <!-- 2. Health Details -->
        <section class="card healthlog-card tab-section" id="tabHealthDetails" style="display:none;">
          <h2 class="card-title">Health Details</h2>

          <!-- Drinks Section (Hydration & Caffeine grouped) -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🥤</span> Hydration & Drinks
              <span class="section-status incomplete" id="hydrationStatus">Not started</span>
            </div>
            <div class="drinks-form">
              <div class="hydration-trackers">
                <div class="tracker-card">
                  <div class="tracker-icon">💧</div>
                  <div class="tracker-content">
                    <label for="waterLiters">
                      Water
                      <span class="info-tooltip">
                        <span class="tooltip-content">Aim for 2-3 liters daily. Proper hydration helps prevent constipation and UTIs.</span>
                      </span>
                    </label>
                    <div class="tracker-value-display">
                      <span class="tracker-value" id="waterDisplay">0</span>
                      <span class="tracker-unit">liters</span>
                    </div>
                    <input id="waterLiters" type="range" min="0" max="5" step="0.1" class="custom-range" aria-label="Water intake in liters">
                    <div class="range-labels">
                      <span>0L</span>
                      <span>2.5L ✓</span>
                      <span>5L</span>
                    </div>
                    <span class="field-hint" id="waterHint">Goal: 2-3 liters per day</span>
                  </div>
                </div>

                <div class="tracker-card">
                  <div class="tracker-icon">🧃</div>
                  <div class="tracker-content">
                    <label for="otherFluidsLiters">Other Fluids</label>
                    <div class="tracker-value-display">
                      <span class="tracker-value" id="fluidsDisplay">0</span>
                      <span class="tracker-unit">liters</span>
                    </div>
                    <input id="otherFluidsLiters" type="range" min="0" max="3" step="0.1" class="custom-range" aria-label="Other fluids in liters">
                    <div class="range-labels">
                      <span>0L</span>
                      <span>1.5L</span>
                      <span>3L</span>
                    </div>
                    <span class="field-hint">Juice, milk, smoothies, etc.</span>
                  </div>
                </div>

                <div class="tracker-card caffeine-tracker">
                  <div class="tracker-icon">☕</div>
                  <div class="tracker-content">
                    <label for="caffeineIntakeMg">
                      Caffeine
                      <span class="info-tooltip">
                        <span class="tooltip-content">Limit caffeine to 200mg/day during pregnancy. 1 cup of coffee ≈ 95mg.</span>
                      </span>
                    </label>
                    <div class="tracker-value-display">
                      <span class="tracker-value" id="caffeineDisplay">0</span>
                      <span class="tracker-unit">mg</span>
                    </div>
                    <input id="caffeineIntakeMg" type="range" min="0" max="500" step="10" class="custom-range" aria-label="Caffeine intake in mg">
                    <div class="range-labels">
                      <span>0mg</span>
                      <span>200mg ⚠️</span>
                      <span>500mg</span>
                    </div>
                    <div class="caffeine-warning" id="caffeineWarning" style="display:none;">
                      ⚠️ Limit to 200mg/day during pregnancy
                    </div>
                    <span class="field-hint">☕ Coffee: ~95mg | 🍵 Tea: ~45mg | 🥤 Cola: ~35mg</span>
                  </div>
                </div>
              </div>

              <div class="drink-log-section">
                <label class="section-sublabel">📝 Log Individual Drinks <span class="optional-badge">Optional</span></label>
                <div class="drink-input-row">
                  <select id="drinkType" class="input-primary drink-type-select" aria-label="Drink type">
                    <option value="">Choose drink type...</option>
                    <option value="water">💧 Water</option>
                    <option value="juice">🧃 Juice</option>
                    <option value="milk">🥛 Milk</option>
                    <option value="tea">🍵 Tea</option>
                    <option value="coffee">☕ Coffee</option>
                    <option value="smoothie">🥤 Smoothie</option>
                    <option value="other">🥤 Other</option>
                  </select>
                  <div class="input-with-unit">
                    <input id="drinkAmount" type="number" min="0" max="2000" placeholder="Amount" class="input-primary drink-amount-input" aria-label="Drink amount in ml">
                    <span class="input-unit">ml</span>
                  </div>
                  <button type="button" class="btn-add-drink-item" id="addDrinkBtn">
                    <span>+ Add</span>
                  </button>
                </div>
                <div id="drinkList" class="drink-chips-list"></div>
              </div>
            </div>
          </div>

          <!-- Exercise Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🏃‍♀️</span> Exercise
              <span class="section-status incomplete" id="exerciseStatus">Not started</span>
            </div>
            <div class="exercise-form">
              <div class="row two">
                <div class="field">
                  <label for="exerciseType">
                    Exercise Type
                    <span class="info-tooltip">
                      <span class="tooltip-content">Safe exercises during pregnancy include walking, swimming, prenatal yoga, and low-impact aerobics.</span>
                    </span>
                  </label>
                  <select id="exerciseType" class="input-primary" aria-label="Select exercise type">
                    <option value="">Choose exercise...</option>
                    <option value="walking">🚶‍♀️ Walking</option>
                    <option value="prenatal_yoga">🧘‍♀️ Prenatal Yoga</option>
                    <option value="swimming">🏊‍♀️ Swimming</option>
                    <option value="strength_training">💪 Strength Training</option>
                    <option value="stretching">🤸‍♀️ Stretching</option>
                    <option value="pilates">Pilates</option>
                    <option value="stationary_cycling">🚴‍♀️ Stationary Cycling</option>
                    <option value="prenatal_aerobics">💃 Prenatal Aerobics</option>
                    <option value="kegel_exercises">Kegel Exercises</option>
                    <option value="other">Other</option>
                  </select>
                </div>
                <div class="field">
                  <label for="exerciseMinutes">
                    Duration (minutes)
                    <span class="info-tooltip">
                      <span class="tooltip-content">Aim for 150 minutes of moderate exercise per week (about 30 min/day, 5 days/week).</span>
                    </span>
                  </label>
                  <input id="exerciseMinutes" type="number" min="0" max="300" placeholder="e.g., 30" class="input-primary" aria-label="Exercise duration in minutes">
                  <span class="field-hint">Valid range: 0-300 minutes</span>
                  <div class="validation-message" id="exerciseMinutesValidation"></div>
                </div>
              </div>
              
              <div class="row two">
                <div class="field">
                  <label>
                    Intensity Level
                    <span class="info-tooltip">
                      <span class="tooltip-content">During pregnancy, moderate intensity is best. You should be able to talk but not sing during exercise.</span>
                    </span>
                  </label>
                  <div class="intensity-buttons">
                    <button type="button" class="intensity-btn" data-val="light" aria-pressed="false">
                      <span class="intensity-icon">🟢</span>
                      <span>Light</span>
                    </button>
                    <button type="button" class="intensity-btn" data-val="moderate" aria-pressed="false">
                      <span class="intensity-icon">🟡</span>
                      <span>Moderate</span>
                    </button>
                    <button type="button" class="intensity-btn" data-val="vigorous" aria-pressed="false">
                      <span class="intensity-icon">🔴</span>
                      <span>Vigorous</span>
                    </button>
                  </div>
                  <input type="hidden" id="exerciseIntensity">
                </div>
                <div class="field">
                  <label for="exerciseFeeling">How did you feel?</label>
                  <select id="exerciseFeeling" class="input-primary">
                    <option value="">Select feeling...</option>
                    <option value="great">😊 Great</option>
                    <option value="good">🙂 Good</option>
                    <option value="okay">😐 Okay</option>
                    <option value="tired">😴 Tired</option>
                    <option value="uncomfortable">😣 Uncomfortable</option>
                    <option value="painful">😖 Painful</option>
                  </select>
                </div>
              </div>

              <div class="row one">
                <div class="field">
                  <label for="exerciseNotes">Additional Notes</label>
                  <input id="exerciseNotes" type="text" placeholder="Any other details..." class="input-primary">
                </div>
              </div>

              <button type="button" class="btn-add-item" id="addExerciseBtn">
                <span class="btn-icon">+</span> Add Exercise
              </button>
            </div>
            
            <div id="exerciseList" class="item-list"></div>
          </div>

          <!-- Nutrition Section -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">🥗</span> Nutrition
              <span class="section-status incomplete" id="nutritionStatus">Not started</span>
            </div>
            <div class="nutrition-form">
              <div class="meal-header">
                <div class="row one">
                  <div class="field">
                    <label for="mealType">
                      Meal Type
                      <span class="info-tooltip">
                        <span class="tooltip-content">Eat smaller, frequent meals to manage nausea and heartburn. Include protein with every meal.</span>
                      </span>
                    </label>
                    <select id="mealType" class="input-primary" aria-label="Select meal type">
                      <option value="">Choose meal...</option>
                      <option value="breakfast">🍳 Breakfast</option>
                      <option value="lunch">🥙 Lunch</option>
                      <option value="dinner">🍽️ Dinner</option>
                      <option value="snack">🍎 Snack</option>
                      <option value="other">Other</option>
                    </select>
                  </div>
                </div>
              </div>

              <div class="food-entry-section">
                <label class="section-sublabel">Add Foods to This Meal</label>
                <div class="food-input-row">
                  <input id="foodName" type="text" placeholder="Food name (e.g., Grilled Chicken)" class="input-primary food-name-input" maxlength="100" aria-label="Food name">
                  <input id="foodAmount" type="number" min="0" max="5000" placeholder="Amount" class="input-primary food-amount-input" aria-label="Food amount">
                  <select id="foodUnit" class="input-primary food-unit-select" aria-label="Food unit">
                    <option value="g">grams</option>
                    <option value="ml">ml</option>
                    <option value="serving">serving</option>
                    <option value="piece">piece</option>
                    <option value="cup">cup</option>
                    <option value="tbsp">tbsp</option>
                    <option value="tsp">tsp</option>
                  </select>
                  <button type="button" class="btn-add-food" id="addFoodBtn">
                    <span>+ Add</span>
                  </button>
                </div>
                <div id="foodList" class="food-list"></div>
              </div>

              <div class="meal-footer">
                <div class="field">
                  <label for="mealNotes">Meal Notes (optional)</label>
                  <input id="mealNotes" type="text" placeholder="Any additional details about this meal..." class="input-primary" maxlength="200" aria-label="Meal notes">
                  <span class="field-hint">E.g., "Felt nauseous after eating" or "Craving satisfied"</span>
                </div>

                <button type="button" class="btn-add-item" id="addMealBtn">
                  <span class="btn-icon">+</span> Add Meal to Log
                </button>
              </div>
            </div>
            
            <div id="mealList" class="item-list"></div>
          </div>

          <!-- Fetal Movement Section (only show if week >= 16) -->
          <div class="section-block" id="fetalMovementSection" style="display:none;">
            <div class="section-title">
              <span class="section-icon">🤰</span> Fetal Movement
              <span class="info-tooltip">
                <span class="tooltip-content">Most women start feeling movement between 16-25 weeks. Track kicks to ensure baby is active.</span>
              </span>
            </div>
            <div class="row three">
              <div class="field">
                <label for="fmStartTime">Start Time</label>
                <input id="fmStartTime" type="time" class="input-primary" aria-label="Kick count start time">
              </div>
              <div class="field">
                <label for="fmEndTime">End Time</label>
                <input id="fmEndTime" type="time" class="input-primary" aria-label="Kick count end time">
              </div>
              <div class="field">
                <label for="fmKickCount">Kick Count</label>
                <input id="fmKickCount" type="number" min="0" max="200" placeholder="Number of kicks" class="input-primary" aria-label="Number of kicks">
                <span class="field-hint info">💡 10+ kicks in 2 hours is normal</span>
              </div>
            </div>
            <div class="row one">
              <div class="field">
                <label for="fmNotes">Movement Notes</label>
                <input id="fmNotes" type="text" placeholder="Describe baby's movement patterns" class="input-primary" maxlength="200" aria-label="Fetal movement notes">
              </div>
            </div>
          </div>

          <!-- Tab Navigation -->
          <div class="tab-navigation">
            <button type="button" class="tab-nav-btn tab-nav-prev" id="prevBtnHealth">
              <span class="nav-arrow">←</span> Previous
            </button>
            <span class="tab-nav-indicator">2 of 3</span>
            <button type="button" class="tab-nav-btn tab-nav-next" id="nextBtnHealth">
              Next <span class="nav-arrow">→</span>
            </button>
          </div>
        </section>

        <!-- 3. Details & Notes -->
        <section class="card healthlog-card tab-section" id="tabNotes" style="display:none;">
          <h2 class="card-title">Details & Notes</h2>

          <!-- Doctor Visit -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">👨‍⚕️</span> Doctor Visit
              <span class="section-status incomplete" id="doctorStatus">Not started</span>
            </div>
            <div class="row two">
              <div class="field checkbox-field">
                <label class="checkbox-label">
                  <input type="checkbox" id="visitedDoctor" class="checkbox-input" aria-label="Visited doctor today" />
                  <span class="checkbox-text">Visited Doctor Today</span>
                </label>
              </div>
              <div class="field">
                <label for="visitType">Visit Type</label>
                <select id="visitType" class="input-primary" disabled aria-label="Type of doctor visit">
                  <option value="">Select...</option>
                  <option value="routine">📋 Routine Checkup</option>
                  <option value="ultrasound">📺 Ultrasound</option>
                  <option value="lab_work">🔬 Lab Work / Blood Tests</option>
                  <option value="specialist">👩‍⚕️ Specialist Visit</option>
                  <option value="emergency">🚨 Emergency</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="doctorVisitNotes">
                Doctor Visit Notes
                <span class="info-tooltip">
                  <span class="tooltip-content">Record important findings, advice, or instructions from your doctor.</span>
                </span>
              </label>
              <textarea id="doctorVisitNotes" rows="3" placeholder="Record important findings, advice, or instructions..." class="input-primary" disabled maxlength="500" aria-label="Doctor visit notes"></textarea>
              <div class="char-counter" id="doctorNotesCounter">0/500</div>
            </div>
            <div class="field">
              <label for="nextAppointment">Next Appointment</label>
              <input id="nextAppointment" type="date" class="input-primary" disabled aria-label="Next appointment date">
              <span class="field-hint">Set a reminder for your next visit</span>
            </div>
          </div>

          <!-- General Notes -->
          <div class="section-block">
            <div class="section-title">
              <span class="section-icon">📝</span> Daily Notes
            </div>
            <div class="field">
              <label for="notes">
                Notes (optional)
                <span class="info-tooltip">
                  <span class="tooltip-content">Record anything notable about today - thoughts, feelings, milestones, or questions for your next doctor visit.</span>
                </span>
              </label>
              <textarea id="notes" rows="5" placeholder="Anything notable about today... thoughts, feelings, questions for your doctor, milestones..." class="input-primary" maxlength="2000" aria-label="Daily notes"></textarea>
              <div class="char-counter" id="notesCounter">0/2000</div>
              <span class="field-hint">💡 Use this space to journal your pregnancy journey</span>
            </div>
          </div>

          <!-- Tab Navigation -->
          <div class="tab-navigation">
            <button type="button" class="tab-nav-btn tab-nav-prev" id="prevBtnNotes">
              <span class="nav-arrow">←</span> Previous
            </button>
            <span class="tab-nav-indicator">3 of 3</span>
            <button type="button" class="tab-nav-btn tab-nav-next tab-nav-save" id="saveBtnNotes">
              <span class="save-icon">💾</span> Save
            </button>
          </div>
        </section>
      </form>

      <!-- Sidebar -->
      <aside class="status-sidebar healthlog-sidebar">
        <!-- Streak Card -->
        <div class="card streak-card">
          <div class="streak-header">
            <span class="streak-fire">🔥</span>
            <div class="streak-info">
              <div class="streak-count" id="streakCount">0</div>
              <div class="streak-label">Day Streak</div>
            </div>
          </div>
          <div class="streak-message" id="streakMessage">Keep logging daily to build your streak!</div>
          <div class="streak-progress">
            <div class="streak-progress-bar" id="streakProgress" style="width: 0%"></div>
          </div>
          <div class="streak-hint" id="streakHint">Log today to continue your streak</div>
        </div>

        <div class="card status-card">
          <div class="section-head">
            <strong>Log Status</strong>
            <div id="logStatusText" class="progress-label">Draft</div>
          </div>
          <div id="lastUpdatedTime" class="last-updated-time" style="display:none;"></div>
          <div class="progress-bar-container">
            <div class="progress-bar" id="logProgress"></div>
          </div>
          <div class="progress-percentage" id="progressPercentage">0% Complete</div>
          <div class="completion-details" id="completionDetails">
            <div class="completion-item">
              <span class="completion-icon" id="vitalsIcon">⭕</span>
              <span class="completion-text">Vitals & Mood</span>
            </div>
            <div class="completion-item">
              <span class="completion-icon" id="hydrationIcon">⭕</span>
              <span class="completion-text">Hydration & Activity</span>
            </div>
            <div class="completion-item">
              <span class="completion-icon" id="notesIcon">⭕</span>
              <span class="completion-text">Notes & Visits</span>
            </div>
          </div>
          <div class="stats-grid">
            <div class="stat-item">
              <div class="stat-value" id="statSections">0/3</div>
              <div class="stat-label">Sections</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statTrimester">-</div>
              <div class="stat-label">Trimester</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statWeek">-</div>
              <div class="stat-label">Week</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statEnergy">-</div>
              <div class="stat-label">Energy</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statSleep">-</div>
              <div class="stat-label">Sleep Hours</div>
            </div>
            <div class="stat-item">
              <div class="stat-value" id="statWater">-</div>
              <div class="stat-label">Water (L)</div>
            </div>
          </div>
        </div>
        <div class="card quick-actions-card" style="display: none;">
          <div class="quick-actions-header">
            <strong>⚡ Quick Actions</strong>
            <p class="quick-actions-subtitle">Manage your daily log</p>
          </div>
          <div class="quick-actions">
            
            <button type="button" class="btn-action btn-complete" id="completeSidebarBtn">
              <span class="btn-icon">✓</span>
              <div class="btn-content">
                <div class="btn-title">Mark Complete</div>
                <div class="btn-subtitle">Finish today's log</div>
              </div>
            </button>
            <button type="button" class="btn-action btn-secondary" id="viewPastLogsBtn">
              <span class="btn-icon">📜</span>
              <div class="btn-content">
                <div class="btn-title">Past Logs</div>
                <div class="btn-subtitle">View your history</div>
              </div>
            </button>
          </div>
        </div>
      </aside>
    </div>
  </main>
</div>

<script>
  (function () {
    // ==================== STATE ====================
    let currentLogId = null;
    let currentLogDate = null;
    let symptoms = [];
    let exercises = [];
    let moodLog = [];
    let drinks = [];
    let meals = [];
    let currentFoodList = []; // Add this line - initialize food list
    let isReadOnly = false;
    let userContext = {
      pregnancyWeek: <%= typeof currentPregnancyWeek !== 'undefined' && currentPregnancyWeek ? JSON.stringify(currentPregnancyWeek) : 'null' %>,
      trimester: <%= typeof currentTrimester !== 'undefined' && currentTrimester ? JSON.stringify(currentTrimester) : 'null' %>
    };
    
    // Track which fields have been touched by the user (not just default values)
    const touchedFields = new Set();
    
    // Helper to mark a field as touched
    function markAsTouched(fieldId) {
      touchedFields.add(fieldId);
    }
    
    // Helper to check if a field has been touched
    function isTouched(fieldId) {
      return touchedFields.has(fieldId);
    }

    // ==================== DOM ELEMENTS ====================
    const messageEl = document.getElementById('message');
    const saveBtn = document.getElementById('saveBtn');
    const saveCompleteBtn = document.getElementById('saveCompleteBtn');
    const completeSidebarBtn = document.getElementById('completeSidebarBtn');

    // ==================== BLOOD PRESSURE VALIDATION ====================
    const systolicBP = document.getElementById('systolicBP');
    const diastolicBP = document.getElementById('diastolicBP');
    const bpValidation = document.getElementById('bpValidation');

    function validateBloodPressure(input, min, max, name) {
      input.addEventListener('input', function() {
        markAsTouched(input.id);
        const value = parseInt(this.value);
        if (this.value && (value < min || value > max)) {
          this.classList.remove('valid');
          this.classList.add('invalid');
          this.setCustomValidity(`${name} must be between ${min} and ${max}`);
        } else if (this.value) {
          this.classList.remove('invalid');
          this.classList.add('valid');
          this.setCustomValidity('');
        } else {
          this.classList.remove('valid', 'invalid');
          this.setCustomValidity('');
        }
        updateBPValidation();
      });

      input.addEventListener('blur', function() {
        const value = parseInt(this.value);
        if (this.value && value < min) {
          this.value = min;
          showMsg(`${name} adjusted to minimum (${min})`, 'info');
        } else if (this.value && value > max) {
          this.value = max;
          showMsg(`${name} adjusted to maximum (${max})`, 'info');
        }
        this.classList.remove('invalid');
        if (this.value) this.classList.add('valid');
        updateBPValidation();
      });
    }

    function updateBPValidation() {
      const systolic = parseInt(systolicBP?.value) || 0;
      const diastolic = parseInt(diastolicBP?.value) || 0;
      
      if (bpValidation && systolic && diastolic) {
        if (systolic >= 140 || diastolic >= 90) {
          bpValidation.innerHTML = '⚠️ Blood pressure is elevated. Consider monitoring and consult your healthcare provider.';
          bpValidation.className = 'validation-message warning show';
        } else if (systolic < 90 || diastolic < 60) {
          bpValidation.innerHTML = '💡 Blood pressure is low. Stay hydrated and change positions slowly.';
          bpValidation.className = 'validation-message warning show';
        } else if (systolic >= 90 && systolic <= 120 && diastolic >= 60 && diastolic <= 80) {
          bpValidation.innerHTML = '✓ Blood pressure is in the healthy range';
          bpValidation.className = 'validation-message success show';
        } else {
          bpValidation.className = 'validation-message';
          bpValidation.style.display = 'none';
        }
      }
    }

    if (systolicBP) validateBloodPressure(systolicBP, 70, 200, 'Systolic BP');
    if (diastolicBP) validateBloodPressure(diastolicBP, 40, 130, 'Diastolic BP');

    // ==================== WEIGHT VALIDATION ====================
    const weightInput = document.getElementById('weightKg');
    const weightValidation = document.getElementById('weightValidation');
    
    if (weightInput) {
      weightInput.addEventListener('input', function() {
        markAsTouched('weightKg');
        const value = parseFloat(this.value);
        if (this.value && (value < 20 || value > 300)) {
          this.classList.remove('valid');
          this.classList.add('invalid');
          if (weightValidation) {
            weightValidation.innerHTML = '⚠️ Weight must be between 20-300 kg';
            weightValidation.className = 'validation-message error show';
          }
        } else if (this.value) {
          this.classList.remove('invalid');
          this.classList.add('valid');
          if (weightValidation) {
            weightValidation.innerHTML = '✓ Weight recorded';
            weightValidation.className = 'validation-message success show';
          }
        } else {
          this.classList.remove('valid', 'invalid');
          if (weightValidation) {
            weightValidation.className = 'validation-message';
          }
        }
        updateSectionStatuses();
      });
      
      weightInput.addEventListener('blur', function() {
        const value = parseFloat(this.value);
        if (this.value && value < 20) {
          this.value = 20;
          showMsg('Weight adjusted to minimum (20 kg)', 'info');
        } else if (this.value && value > 300) {
          this.value = 300;
          showMsg('Weight adjusted to maximum (300 kg)', 'info');
        }
        if (this.value) {
          this.classList.remove('invalid');
          this.classList.add('valid');
        }
      });
    }

    // ==================== CHARACTER COUNTERS ====================
    function setupCharCounter(inputId, counterId, maxLength) {
      const input = document.getElementById(inputId);
      const counter = document.getElementById(counterId);
      if (!input || !counter) return;
      
      const updateCounter = () => {
        const len = input.value.length;
        counter.textContent = `${len}/${maxLength}`;
        if (len >= maxLength * 0.9) {
          counter.classList.add('warning');
          counter.classList.remove('error');
        } else if (len >= maxLength) {
          counter.classList.add('error');
          counter.classList.remove('warning');
        } else {
          counter.classList.remove('warning', 'error');
        }
      };
      
      input.addEventListener('input', updateCounter);
      updateCounter();
    }
    
    setupCharCounter('notes', 'notesCounter', 2000);
    setupCharCounter('doctorVisitNotes', 'doctorNotesCounter', 500);

    // ==================== SECTION STATUS UPDATES ====================
    function updateSectionStatuses() {
      // Vitals status
      const vitalsStatus = document.getElementById('vitalsStatus');
      if (vitalsStatus) {
        const hasWeight = document.getElementById('weightKg')?.value;
        const hasHeartRate = parseInt(document.getElementById('heartRateBpm')?.value) > 50;
        const hasBP = document.getElementById('systolicBP')?.value && document.getElementById('diastolicBP')?.value;
        
        if (hasWeight && hasHeartRate && hasBP) {
          vitalsStatus.textContent = '✓ Complete';
          vitalsStatus.className = 'section-status complete';
        } else if (hasWeight || hasHeartRate || hasBP) {
          vitalsStatus.textContent = 'Partial';
          vitalsStatus.className = 'section-status partial';
        } else {
          vitalsStatus.textContent = 'Not started';
          vitalsStatus.className = 'section-status incomplete';
        }
      }
      
      // Mood status
      const moodStatus = document.getElementById('moodStatus');
      if (moodStatus) {
        const hasEnergy = document.getElementById('energyLevel')?.value;
        const hasStress = document.getElementById('stressLevel')?.value;
        const hasMoodLog = moodLog.length > 0;
        
        if (hasEnergy && hasStress) {
          moodStatus.textContent = '✓ Complete';
          moodStatus.className = 'section-status complete';
        } else if (hasEnergy || hasStress || hasMoodLog) {
          moodStatus.textContent = 'Partial';
          moodStatus.className = 'section-status partial';
        } else {
          moodStatus.textContent = 'Not started';
          moodStatus.className = 'section-status incomplete';
        }
      }
      
      // Sleep status
      const sleepStatusEl = document.getElementById('sleepStatus');
      if (sleepStatusEl) {
        const hasSleepHours = parseFloat(document.getElementById('sleepHours')?.value) > 0;
        const hasSleepQuality = document.getElementById('sleepQuality')?.value;
        
        if (hasSleepHours && hasSleepQuality) {
          sleepStatusEl.textContent = '✓ Complete';
          sleepStatusEl.className = 'section-status complete';
        } else if (hasSleepHours || hasSleepQuality) {
          sleepStatusEl.textContent = 'Partial';
          sleepStatusEl.className = 'section-status partial';
        } else {
          sleepStatusEl.textContent = 'Not started';
          sleepStatusEl.className = 'section-status incomplete';
        }
      }
      
      // Symptoms status
      const symptomsStatus = document.getElementById('symptomsStatus');
      if (symptomsStatus) {
        if (symptoms.length > 0) {
          symptomsStatus.textContent = `${symptoms.length} logged`;
          symptomsStatus.className = 'section-status complete';
        } else {
          symptomsStatus.textContent = 'None logged';
          symptomsStatus.className = 'section-status incomplete';
        }
      }
      
      // Hydration status
      const hydrationStatus = document.getElementById('hydrationStatus');
      if (hydrationStatus) {
        const water = parseFloat(document.getElementById('waterLiters')?.value) || 0;
        const fluids = parseFloat(document.getElementById('otherFluidsLiters')?.value) || 0;
        
        if (water >= 2) {
          hydrationStatus.textContent = '✓ On track';
          hydrationStatus.className = 'section-status complete';
        } else if (water > 0 || fluids > 0) {
          hydrationStatus.textContent = 'Keep drinking!';
          hydrationStatus.className = 'section-status partial';
        } else {
          hydrationStatus.textContent = 'Not started';
          hydrationStatus.className = 'section-status incomplete';
        }
      }
      
      // Exercise status
      const exerciseStatusEl = document.getElementById('exerciseStatus');
      if (exerciseStatusEl) {
        if (exercises.length > 0) {
          const totalMins = exercises.reduce((sum, ex) => sum + (ex.durationMinutes || 0), 0);
          exerciseStatusEl.textContent = `${totalMins} min logged`;
          exerciseStatusEl.className = 'section-status complete';
        } else {
          exerciseStatusEl.textContent = 'Not started';
          exerciseStatusEl.className = 'section-status incomplete';
        }
      }
      
      // Nutrition status
      const nutritionStatus = document.getElementById('nutritionStatus');
      if (nutritionStatus) {
        if (meals.length > 0) {
          nutritionStatus.textContent = `${meals.length} meal(s) logged`;
          nutritionStatus.className = 'section-status complete';
        } else {
          nutritionStatus.textContent = 'Not started';
          nutritionStatus.className = 'section-status incomplete';
        }
      }
      
      // Doctor status
      const doctorStatus = document.getElementById('doctorStatus');
      if (doctorStatus) {
        if (document.getElementById('visitedDoctor')?.checked) {
          doctorStatus.textContent = '✓ Visited';
          doctorStatus.className = 'section-status complete';
        } else {
          doctorStatus.textContent = 'No visit';
          doctorStatus.className = 'section-status incomplete';
        }
      }
    }

    // ==================== SLEEP HINTS ====================
    const sleepHoursInputEl = document.getElementById('sleepHours');
    const sleepHintEl = document.getElementById('sleepHint');
    if (sleepHoursInputEl && sleepHintEl) {
      sleepHoursInputEl.addEventListener('input', function() {
        const hours = parseFloat(this.value);
        if (hours < 6) {
          sleepHintEl.textContent = '😴 Try to get more rest - aim for 7-9 hours';
          sleepHintEl.className = 'field-hint warning';
        } else if (hours >= 7 && hours <= 9) {
          sleepHintEl.textContent = '✓ Great! You\'re getting adequate sleep';
          sleepHintEl.className = 'field-hint success';
        } else if (hours > 9) {
          sleepHintEl.textContent = '💡 If you\'re sleeping more than usual, mention it to your doctor';
          sleepHintEl.className = 'field-hint info';
        } else {
          sleepHintEl.textContent = 'Recommended: 7-9 hours per night';
          sleepHintEl.className = 'field-hint';
        }
        updateSectionStatuses();
      });
    }

    // ==================== WATER INTAKE HINTS ====================
    const waterInputEl = document.getElementById('waterLiters');
    const waterHintEl = document.getElementById('waterHint');
    if (waterInputEl && waterHintEl) {
      waterInputEl.addEventListener('input', function() {
        const liters = parseFloat(this.value);
        if (liters < 1.5) {
          waterHintEl.textContent = '💧 Drink more water - aim for 2-3 liters';
          waterHintEl.className = 'field-hint warning';
        } else if (liters >= 2 && liters <= 3) {
          waterHintEl.textContent = '✓ Excellent hydration!';
          waterHintEl.className = 'field-hint success';
        } else if (liters > 3) {
          waterHintEl.textContent = '✓ Great hydration! Be mindful not to overhydrate.';
          waterHintEl.className = 'field-hint info';
        } else {
          waterHintEl.textContent = 'Goal: 2-3 liters per day';
          waterHintEl.className = 'field-hint';
        }
        updateSectionStatuses();
      });
    }

    // ==================== SEVERITY WARNING ====================
    const severityInputEl = document.getElementById('symptomSeverity');
    const severityWarning = document.getElementById('severityWarning');
    if (severityInputEl && severityWarning) {
      severityInputEl.addEventListener('input', function() {
        const value = parseInt(this.value);
        severityWarning.style.display = value >= 8 ? 'flex' : 'none';
      });
    }

    // ==================== DOCTOR VISIT TOGGLE ====================
    function toggleDoctorVisitFields() {
      const visitedDoctor = document.getElementById('visitedDoctor');
      const visitType = document.getElementById('visitType');
      const doctorVisitNotes = document.getElementById('doctorVisitNotes');
      const nextAppointment = document.getElementById('nextAppointment');
      
      const isChecked = visitedDoctor?.checked || false;
      
      if (visitType) visitType.disabled = !isChecked;
      if (doctorVisitNotes) doctorVisitNotes.disabled = !isChecked;
      if (nextAppointment) nextAppointment.disabled = !isChecked;
      
      // Clear fields when unchecked
      if (!isChecked) {
        if (visitType) visitType.value = '';
        if (doctorVisitNotes) doctorVisitNotes.value = '';
        if (nextAppointment) nextAppointment.value = '';
      }
    }
    
    // Attach event listener to checkbox
    const visitedDoctorCheckbox = document.getElementById('visitedDoctor');
    if (visitedDoctorCheckbox) {
      visitedDoctorCheckbox.addEventListener('change', toggleDoctorVisitFields);
      // Initialize on page load
      toggleDoctorVisitFields();
    }

    // ==================== UTILITY FUNCTIONS ====================
    function isToday(dateString) {
      if (!dateString) return false;
      const logDate = new Date(dateString);
      const today = new Date();
      return logDate.toDateString() === today.toDateString();
    }

    function setReadOnlyMode(readonly) {
      isReadOnly = readonly;
      const allInputs = document.querySelectorAll('input, select, textarea');
      const allButtons = document.querySelectorAll('button[type="button"]');

      allInputs.forEach(input => {
        if (readonly) {
          input.disabled = true;
          input.style.opacity = '0.7';
        } else {
          input.disabled = false;
          input.style.opacity = '1';
        }
      });

      // Disable add buttons but keep tab buttons enabled
      allButtons.forEach(btn => {
        if (btn.id.startsWith('add') || btn.id === 'saveBtn' || btn.id === 'saveCompleteBtn' ||
          btn.id === 'completeSidebarBtn') {
          btn.disabled = readonly;
          btn.style.opacity = readonly ? '0.5' : '1';
        }
      });

      if (readonly) {
        showMsg('This log is from a previous day and cannot be edited.', 'info');
      }
    }

    function showMsg(text, type = 'success') {
      messageEl.textContent = text;
      messageEl.className = `msg ${type}`;
      messageEl.hidden = false;
      setTimeout(() => messageEl.hidden = true, 4000);
    }

    function updateLastSavedTime(timestamp) {
      const lastUpdatedEl = document.getElementById('lastUpdatedTime');
      if (!lastUpdatedEl) return;
      
      const date = new Date(timestamp);
      const now = new Date();
      const diffMs = now - date;
      const diffMins = Math.floor(diffMs / 60000);
      
      let timeText;
      if (diffMins < 1) {
        timeText = 'Just now';
      } else if (diffMins < 60) {
        timeText = `${diffMins} minute${diffMins > 1 ? 's' : ''} ago`;
      } else {
        const hours = date.getHours();
        const minutes = date.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        const displayHours = hours % 12 || 12;
        timeText = `Today at ${displayHours}:${minutes.toString().padStart(2, '0')} ${ampm}`;
      }
      
      lastUpdatedEl.innerHTML = `<strong>Last saved:</strong> ${timeText}`;
      lastUpdatedEl.style.display = 'block';
    }

