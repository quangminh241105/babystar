    // ==================== VALIDATION ====================
    function validateFormData() {
      const errors = [];
      
      // Clear previous validation states
      document.querySelectorAll('.invalid, .valid').forEach(el => {
        el.classList.remove('invalid', 'valid');
      });
      document.querySelectorAll('.validation-message').forEach(el => {
        el.classList.remove('show');
      });
      
      // CHECK: At least one field must be filled to save
      const hasAnyData = checkIfFormHasData();
      if (!hasAnyData) {
        errors.push('Please fill in at least one field before saving. Your health log cannot be empty.');
      }
      
      // Validate weight (20-300 kg)
      const weightEl = document.getElementById('weightKg');
      const weight = parseFloat(weightEl.value);
      if (weight && (weight < 20 || weight > 300)) {
        errors.push('Weight must be between 20-300 kg');
        weightEl.classList.add('invalid');
        const weightValidation = document.getElementById('weightValidation');
        if (weightValidation) {
          weightValidation.innerHTML = '⚠️ Weight must be between 20-300 kg';
          weightValidation.className = 'validation-message error show';
        }
      } else if (weightEl.value) {
        weightEl.classList.add('valid');
      }
      
      // Validate heart rate (40-200 bpm)
      const heartRate = parseInt(document.getElementById('heartRateBpm').value);
      if (heartRate && (heartRate < 40 || heartRate > 200)) {
        errors.push('Heart rate must be between 40-200 bpm');
      }
      
      // Validate blood pressure
      const systolicEl = document.getElementById('systolicBP');
      const diastolicEl = document.getElementById('diastolicBP');
      const systolic = parseInt(systolicEl?.value);
      const diastolic = parseInt(diastolicEl?.value);
      
      if (systolic && (systolic < 70 || systolic > 200)) {
        errors.push('Systolic blood pressure must be between 70-200 mmHg');
        if (systolicEl) systolicEl.classList.add('invalid');
      } else if (systolicEl?.value) {
        systolicEl.classList.add('valid');
      }
      
      if (diastolic && (diastolic < 40 || diastolic > 130)) {
        errors.push('Diastolic blood pressure must be between 40-130 mmHg');
        if (diastolicEl) diastolicEl.classList.add('invalid');
      } else if (diastolicEl?.value) {
        diastolicEl.classList.add('valid');
      }
      
      // Validate blood sugar
      const bloodSugarEl = document.getElementById('bloodSugarValue');
      const bloodSugar = parseFloat(bloodSugarEl.value);
      if (bloodSugar && bloodSugar < 0) {
        errors.push('Blood sugar cannot be negative');
        bloodSugarEl.classList.add('invalid');
      } else if (bloodSugar && bloodSugar > 500) {
        errors.push('Blood sugar value seems too high (max 500)');
        bloodSugarEl.classList.add('invalid');
      } else if (bloodSugarEl.value) {
        bloodSugarEl.classList.add('valid');
      }
      
      // Validate sleep hours (0-24)
      const sleepHours = parseFloat(document.getElementById('sleepHours').value);
      if (sleepHours && (sleepHours < 0 || sleepHours > 24)) {
        errors.push('Sleep hours must be between 0-24');
      }
      
      // Validate energy level (1-5)
      const energy = parseInt(document.getElementById('energyLevel').value);
      if (energy && (energy < 1 || energy > 5)) {
        errors.push('Energy level must be between 1-5');
      }
      
      // Validate stress level (1-5)
      const stress = parseInt(document.getElementById('stressLevel').value);
      if (stress && (stress < 1 || stress > 5)) {
        errors.push('Stress level must be between 1-5');
      }
      
      // Validate water intake (0-10 L)
      const water = parseFloat(document.getElementById('waterLiters').value);
      if (water && (water < 0 || water > 10)) {
        errors.push('Water intake must be between 0-10 liters');
      }
      
      // Validate other fluids (0-10 L)
      const fluids = parseFloat(document.getElementById('otherFluidsLiters').value);
      if (fluids && (fluids < 0 || fluids > 10)) {
        errors.push('Other fluids intake must be between 0-10 liters');
      }
      
      // Validate caffeine (0-500 mg, with warning > 200)
      const caffeine = parseInt(document.getElementById('caffeineIntakeMg').value);
      if (caffeine && caffeine < 0) {
        errors.push('Caffeine intake cannot be negative');
      }
      
      // Validate exercises
      exercises.forEach((ex, i) => {
        if (ex.durationMinutes && (ex.durationMinutes < 0 || ex.durationMinutes > 300)) {
          errors.push(`Exercise ${i + 1}: Duration must be between 0-300 minutes`);
        }
      });
      
      // Validate symptoms
      symptoms.forEach((sym, i) => {
        if (sym.severity && (sym.severity < 1 || sym.severity > 10)) {
          errors.push(`Symptom ${i + 1}: Severity must be between 1-10`);
        }
      });
      
      // Validate mood log triggers (max length 100)
      moodLog.forEach((mood, i) => {
        if (mood.trigger && mood.trigger.length > 100) {
          errors.push(`Mood entry ${i + 1}: Trigger text too long (max 100 characters)`);
        }
      });
      
      // Validate notes length (max 2000)
      const notesEl = document.getElementById('notes');
      const notes = notesEl.value;
      if (notes && notes.length > 2000) {
        errors.push('Notes too long (max 2000 characters)');
        notesEl.classList.add('invalid');
      } else if (notes) {
        notesEl.classList.add('valid');
      }
      
      // Validate doctor visit notes (max 500)
      const doctorNotesEl = document.getElementById('doctorVisitNotes');
      const doctorNotes = doctorNotesEl.value;
      if (doctorNotes && doctorNotes.length > 500) {
        errors.push('Doctor visit notes too long (max 500 characters)');
        doctorNotesEl.classList.add('invalid');
      } else if (doctorNotes) {
        doctorNotesEl.classList.add('valid');
      }
      
      // Validate exercise minutes
      const exerciseMinutesEl = document.getElementById('exerciseMinutes');
      const exerciseMins = parseInt(exerciseMinutesEl?.value);
      if (exerciseMins && (exerciseMins < 0 || exerciseMins > 300)) {
        errors.push('Exercise duration must be between 0-300 minutes');
        if (exerciseMinutesEl) exerciseMinutesEl.classList.add('invalid');
        const exerciseValidation = document.getElementById('exerciseMinutesValidation');
        if (exerciseValidation) {
          exerciseValidation.innerHTML = '⚠️ Duration must be 0-300 minutes';
          exerciseValidation.className = 'validation-message error show';
        }
      }
      
      return errors;
    }
    
    // ==================== CHECK IF FORM HAS DATA ====================
    // Only count fields that user actually touched/interacted with
    function checkIfFormHasData() {
      // Check text/number inputs (these don't have default values)
      const weight = parseFloat(document.getElementById('weightKg').value);
      const systolic = parseInt(document.getElementById('systolicBP')?.value);
      const diastolic = parseInt(document.getElementById('diastolicBP')?.value);
      const bloodSugar = parseFloat(document.getElementById('bloodSugarValue').value);
      
      if (weight || systolic || diastolic || bloodSugar) return true;
      
      // Check range inputs ONLY if user touched them
      if (isTouched('heartRateBpm')) return true;
      if (isTouched('sleepHours')) return true;
      if (isTouched('sleepQuality')) return true;
      if (isTouched('waterLiters')) return true;
      if (isTouched('otherFluidsLiters')) return true;
      if (isTouched('caffeineIntakeMg')) return true;
      
      // Check mood & energy (only if touched)
      if (isTouched('energyLevel')) return true;
      if (isTouched('stressLevel')) return true;
      if (moodLog.length > 0) return true;
      
      // Check symptoms
      if (symptoms.length > 0) return true;
      
      // Check exercises
      if (exercises.length > 0) return true;
      
      // Check drinks array
      if (drinks.length > 0) return true;
      
      // Check nutrition
      if (meals.length > 0) return true;
      
      // Check fetal movement
      const fmCount = parseInt(document.getElementById('fmKickCount')?.value);
      if (fmCount > 0) return true;
      
      // Check doctor visit
      const visitedDoctor = document.getElementById('visitedDoctor').checked;
      if (visitedDoctor) return true;
      
      // Check notes
      const notes = document.getElementById('notes').value?.trim();
      const doctorNotes = document.getElementById('doctorVisitNotes').value?.trim();
      if (notes || doctorNotes) return true;
      
      return false;
    }

    // ==================== COLLECT FORM DATA ====================
