    function collectFormData() {
      return {
        weightKg: parseFloat(document.getElementById('weightKg').value) || null,
        // Only send heartRate if user touched the slider
        heartRateBpm: isTouched('heartRateBpm') ? parseInt(document.getElementById('heartRateBpm').value) : null,
        bloodPressure: {
          systolic: parseInt(document.getElementById('systolicBP')?.value) || null,
          diastolic: parseInt(document.getElementById('diastolicBP')?.value) || null
        },
        bloodSugar: {
          value: parseFloat(document.getElementById('bloodSugarValue').value) || null,
          unit: document.getElementById('bloodSugarUnit').value || 'mg/dL',
          timing: document.getElementById('bloodSugarTiming').value || null,
          measuredAt: null
        },
        // Only send energy/stress if user touched them
        energyLevel: isTouched('energyLevel') ? parseInt(document.getElementById('energyLevel').value) : null,
        stressLevel: isTouched('stressLevel') ? parseInt(document.getElementById('stressLevel').value) : null,
        moodLog: moodLog,
        sleep: {
          // Only send sleep values if user touched them
          totalHours: isTouched('sleepHours') ? parseFloat(document.getElementById('sleepHours').value) : null,
