<link rel="stylesheet" href="/css/chatbot.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<div class="chat-wrapper">
    <!-- Sidebar -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand">
                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8V4H8" />
                        <rect width="16" height="12" x="4" y="8" rx="2" />
                        <path d="M2 14h2M20 14h2M15 13v2M9 13v2" />
                    </svg>
                </div>
                <span class="brand-text">BabyStar</span>
            </div>
            <div class="sidebar-actions">
                <button class="btn-icon btn-new" id="newChatBtn" title="New Chat">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                </button>
                <button class="btn-icon btn-expand" id="expandSidebarBtn" title="Expand Sidebar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </button>
                <button class="btn-icon btn-collapse" id="collapseSidebarBtn" title="Collapse">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="15 18 9 12 15 6"></polyline>
                    </svg>
                </button>
            </div>
        </div>
        <div class="sidebar-search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" placeholder="Search conversations..." id="searchConversations">
        </div>
        <div class="conversation-list" id="conversationList">
            <div class="loading-state">
                <div class="loading-spinner"></div>
                <p>Loading chats...</p>
            </div>
        </div>
    </aside>

    <!-- Expand Sidebar Button (visible when collapsed) -->
    <button class="expand-sidebar-btn" id="expandSidebarBtn" title="Show conversations">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
    </button>

    <!-- Mobile Menu Button -->
    <button class="mobile-menu-btn" id="sidebarToggle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>

    <!-- Main Chat Area -->
    <main class="chat-main">
        <!-- Chat Header -->
        <header class="chat-header">
            <div class="header-info">
                <div class="avatar avatar-ai">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8V4H8" />
                        <rect width="16" height="12" x="4" y="8" rx="2" />
                        <path d="M2 14h2M20 14h2M15 13v2M9 13v2" />
                    </svg>
                </div>
                <div class="header-text">
                    <h1>Pregnancy Assistant</h1> 
                    <span class="status"><span class="status-dot"></span>Online & Ready to Help</span>
                </div>
            </div>
            <div class="header-actions">
                <button class="btn-icon" title="Clear Chat">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Messages Container -->
        <div class="messages-container" id="chatBox">
            <!-- Welcome Screen -->
            <div class="welcome-screen" id="welcomeScreen">
                <div class="welcome-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M12 8V4H8" />
                        <rect width="16" height="12" x="4" y="8" rx="2" />
                        <path d="M2 14h2M20 14h2M15 13v2M9 13v2" />
                    </svg>
                </div>
                <h2>Welcome to BabyStar AI 💕</h2>
                <p>Your trusted pregnancy companion. Ask me anything about nutrition, exercise, symptoms, and more!</p>
                <div class="welcome-features">
                    <div class="feature-item">
                        <span class="feature-icon">🍎</span>
                        <span>Nutrition Tips</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon">🏃‍♀️</span>
                        <span>Safe Exercises</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon">💊</span>
                        <span>Health Advice</span>
                    </div>
                    <div class="feature-item">
                        <span class="feature-icon">👶</span>
                        <span>Baby Development</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Input Area -->
        <div class="input-area">
            <div class="quick-prompts" id="quickQuestions">
                <button class="prompt-chip" data-question="What foods should I avoid during pregnancy?">
                    🍎 Foods to avoid
                </button>
                <button class="prompt-chip" data-question="Is it safe to exercise during pregnancy?">
                    🏃‍♀️ Safe exercises
                </button>
                <button class="prompt-chip" data-question="How can I manage morning sickness?">
                    🌅 Morning sickness
                </button>
                <button class="prompt-chip" data-question="What are the signs of labor?">
                    👶 Signs of labor
                </button>
            </div>
            <form class="input-form" id="chatForm">
                <div class="input-wrapper">
                    <input type="text" id="messageInput" placeholder="Type your message..." autocomplete="off" disabled>
                    <button type="submit" class="btn-send" id="sendBtn" disabled>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="22" y1="2" x2="11" y2="13"></line>
                            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                        </svg>
                    </button>
                </div>
                <p class="input-hint">Press Enter to send • AI responses are for informational purposes only</p>
            </form>
        </div>
    </main>

    <!-- Overlay for mobile -->
    <div class="overlay" id="sidebarOverlay"></div>
</div>

<script>
    (async function () {
        // ===== DOM Elements =====
        const chatBox = document.getElementById('chatBox');
        const welcomeScreen = document.getElementById('welcomeScreen');
        const messageInput = document.getElementById('messageInput');
        const sendBtn = document.getElementById('sendBtn');
        const chatForm = document.getElementById('chatForm');
        const quickQuestions = document.querySelectorAll('.prompt-chip');
        const conversationList = document.getElementById('conversationList');
        const newChatBtn = document.getElementById('newChatBtn');
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const collapseSidebarBtn = document.getElementById('collapseSidebarBtn');
        const expandSidebarBtn = document.getElementById('expandSidebarBtn');
        const sidebarOverlay = document.getElementById('sidebarOverlay');
        const chatWrapper = document.querySelector('.chat-wrapper');

        // ===== State =====
        let conversationId = null;
        let conversations = [];
        let sidebarCollapsed = localStorage.getItem('chatSidebarCollapsed') === 'true';

        // ===== Utility Functions =====
        function formatTime(date) {
            const d = date ? new Date(date) : new Date();
            return d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: true });
        }

        function formatDate(dateStr) {
            if (!dateStr) return '';
            const date = new Date(dateStr);
            const now = new Date();
            const dateOnly = new Date(date.getFullYear(), date.getMonth(), date.getDate());
            const nowOnly = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const diffTime = nowOnly.getTime() - dateOnly.getTime();
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));

            if (diffDays === 0) return date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
            if (diffDays === 1) return 'Yesterday';
            if (diffDays < 7) return date.toLocaleDateString('en-US', { weekday: 'short' });
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        function enableInput(enable) {
            messageInput.disabled = !enable;
            sendBtn.disabled = !enable;
            quickQuestions.forEach(q => q.disabled = !enable);
        }

        function hideWelcomeScreen() {
            if (welcomeScreen) {
                welcomeScreen.style.display = 'none';
            }
        }

        function showWelcomeScreen() {
            if (welcomeScreen) {
                welcomeScreen.style.display = 'flex';
            }
        }

        function hasVisibleMessages() {
            return chatBox.querySelectorAll('.message').length > 0;
        }

        // ===== Sidebar Functions =====
        function openMobileSidebar() {
            sidebar.classList.add('open');
            sidebarOverlay.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeMobileSidebar() {
            sidebar.classList.remove('open');
            sidebarOverlay.classList.remove('active');
            document.body.style.overflow = '';
        }

        sidebarToggle.addEventListener('click', () => {
            sidebar.classList.contains('open') ? closeMobileSidebar() : openMobileSidebar();
        });

        sidebarOverlay.addEventListener('click', closeMobileSidebar);

        function toggleSidebarCollapse() {
            sidebarCollapsed = !sidebarCollapsed;
            localStorage.setItem('chatSidebarCollapsed', sidebarCollapsed);
            updateSidebarState();
        }

        function updateSidebarState() {
            sidebar.classList.toggle('collapsed', sidebarCollapsed);
            chatWrapper.classList.toggle('sidebar-collapsed', sidebarCollapsed);
            expandSidebarBtn.classList.toggle('visible', sidebarCollapsed);
        }

        function expandSidebar() {
            sidebarCollapsed = false;
            localStorage.setItem('chatSidebarCollapsed', 'false');
            updateSidebarState();
        }

        function expandSidebar() {
            sidebarCollapsed = false;
            localStorage.setItem('chatSidebarCollapsed', 'false');
            updateSidebarState();
        }

        collapseSidebarBtn.addEventListener('click', toggleSidebarCollapse);
        expandSidebarBtn.addEventListener('click', expandSidebar);

        function applyInitialSidebarState() {
            if (window.innerWidth > 768) {
                updateSidebarState();
            }
        }
        applyInitialSidebarState();

        window.addEventListener('resize', () => {
            if (window.innerWidth > 768) {
                closeMobileSidebar();
                updateSidebarState();
            } else {
                // On mobile, don't apply collapsed state
                sidebar.classList.remove('collapsed');
                chatWrapper.classList.remove('sidebar-collapsed');
                expandSidebarBtn.classList.remove('visible');
            }
        });

        // ===== Message Functions =====
        function addAIMessage(text, timestamp) {
            hideWelcomeScreen();
            const bubble = document.createElement('div');
            bubble.className = 'message message-ai';
            bubble.innerHTML = `
                <div class="message-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/>
                        <path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>
                    </svg>
                </div>
                <div class="message-content">
                    <div class="message-bubble">${escapeHtml(text)}</div>
                    <span class="message-time">${formatTime(timestamp)}</span>
                </div>
            `;
            chatBox.appendChild(bubble);
            requestAnimationFrame(() => {
                chatBox.scrollTop = chatBox.scrollHeight;
            });
        }

        function addUserMessage(text, timestamp) {
            hideWelcomeScreen();
            const bubble = document.createElement('div');
            bubble.className = 'message message-user';
            bubble.innerHTML = `
                <div class="message-content">
                    <div class="message-bubble">${escapeHtml(text)}</div>
                    <span class="message-time">${formatTime(timestamp)}</span>
                </div>
                <div class="message-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                        <circle cx="12" cy="7" r="4"></circle>
                    </svg>
                </div>
            `;
            chatBox.appendChild(bubble);
            requestAnimationFrame(() => {
                chatBox.scrollTop = chatBox.scrollHeight;
            });
        }

        function addTypingIndicator() {
            hideWelcomeScreen();
            // Remove existing typing indicator first
            removeTypingIndicator();

            const typing = document.createElement('div');
            typing.className = 'message message-ai typing-indicator';
            typing.id = 'typingIndicator';
            typing.innerHTML = `
                <div class="message-avatar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/>
                        <path d="M2 14h2M20 14h2M15 13v2M9 13v2"/>
                    </svg>
                </div>
                <div class="message-content">
                    <div class="message-bubble typing-dots">
                        <span></span><span></span><span></span>
                    </div>
                </div>
            `;
            chatBox.appendChild(typing);
            requestAnimationFrame(() => {
                chatBox.scrollTop = chatBox.scrollHeight;
            });
        }

        function removeTypingIndicator() {
            const typing = document.getElementById('typingIndicator');
            if (typing) {
                typing.remove();
            }
        }

        function clearChatBox() {
            const messages = chatBox.querySelectorAll('.message');
            messages.forEach(m => m.remove());
            showWelcomeScreen();
        }

        // ===== Conversation List =====
        function renderConversationList(filter = '') {
            const searchTerm = filter.toLowerCase();
            let filteredConversations = conversations;
            
            if (searchTerm) {
                filteredConversations = conversations.filter(c => 
                    (c.title || '').toLowerCase().includes(searchTerm)
                );
            }
            
            if (filteredConversations.length === 0) {
                conversationList.innerHTML = `
                    <div class="empty-state">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <p>${searchTerm ? 'No matching conversations' : 'No conversations yet'}</p>
                        <span>Start a new chat!</span>
                    </div>
                `;
                return;
            }

            // Separate pinned and unpinned
            const pinned = filteredConversations.filter(c => c.isPinned);
            const unpinned = filteredConversations.filter(c => !c.isPinned);

            let html = '';
            
            if (pinned.length > 0) {
                html += `<div class="conv-section-label">📌 Pinned</div>`;
                html += pinned.map(conv => createConversationItemHTML(conv)).join('');
            }
            
            if (unpinned.length > 0) {
                if (pinned.length > 0) {
                    html += `<div class="conv-section-label">Recent</div>`;
                }
                html += unpinned.map(conv => createConversationItemHTML(conv)).join('');
            }
            
            conversationList.innerHTML = html;
            attachConversationListeners();
        }
        
        function createConversationItemHTML(conv) {
            return `
                <div class="conversation-item ${conv._id === conversationId ? 'active' : ''} ${conv.isPinned ? 'pinned' : ''}" data-id="${conv._id}">
                    ${conv.isPinned ? '<span class="pin-indicator">📌</span>' : ''}
                    <div class="conv-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                    </div>
                    <div class="conv-info">
                        <span class="conv-title">${escapeHtml(conv.title || 'New Chat')}</span>
                        <span class="conv-meta">${formatDate(conv.lastMessageAt || conv.createdAt)} • ${conv.stats?.messageCount || 0} msgs</span>
                    </div>
                    <div class="conv-actions">
                        <button class="conv-action-btn conv-menu-btn" data-id="${conv._id}" title="More options">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="1"></circle>
                                <circle cx="12" cy="5" r="1"></circle>
                                <circle cx="12" cy="19" r="1"></circle>
                            </svg>
                        </button>
                    </div>
                    <div class="conv-context-menu" data-id="${conv._id}">
                        <button class="context-menu-item" data-action="rename" data-id="${conv._id}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                            Rename
                        </button>
                        <button class="context-menu-item" data-action="pin" data-id="${conv._id}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2v8"></path>
                                <path d="m4.93 10.93 2.83-2.83"></path>
                                <path d="M2 18h20"></path>
                                <path d="m19.07 10.93-2.83-2.83"></path>
                                <path d="M12 22v-4"></path>
                            </svg>
                            ${conv.isPinned ? 'Unpin' : 'Pin'}
                        </button>
                        <button class="context-menu-item danger" data-action="delete" data-id="${conv._id}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            Delete
                        </button>
                    </div>
                </div>
            `;
        }
        
        function attachConversationListeners() {
            // Click on conversation item to load it
            conversationList.querySelectorAll('.conversation-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    if (!e.target.closest('.conv-actions') && !e.target.closest('.conv-context-menu')) {
                        closeAllContextMenus();
                        loadConversation(item.dataset.id);
                        if (window.innerWidth <= 768) closeMobileSidebar();
                    }
                });
            });
            
            // Menu button click
            conversationList.querySelectorAll('.conv-menu-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const id = btn.dataset.id;
                    toggleContextMenu(id);
                });
            });
            
            // Context menu actions
            conversationList.querySelectorAll('.context-menu-item').forEach(item => {
                item.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const action = item.dataset.action;
                    const id = item.dataset.id;
                    closeAllContextMenus();
                    
                    switch(action) {
                        case 'rename': showRenameDialog(id); break;
                        case 'pin': togglePin(id); break;
                        case 'delete': deleteConversation(id); break;
                    }
                });
            });
        }
        
        function toggleContextMenu(id) {
            const menu = document.querySelector(`.conv-context-menu[data-id="${id}"]`);
            const wasOpen = menu?.classList.contains('show');
            closeAllContextMenus();
            if (!wasOpen && menu) {
                menu.classList.add('show');
            }
        }
        
        function closeAllContextMenus() {
            document.querySelectorAll('.conv-context-menu.show').forEach(m => m.classList.remove('show'));
        }
        
        // Close context menus when clicking outside
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.conv-actions') && !e.target.closest('.conv-context-menu')) {
                closeAllContextMenus();
            }
        });
        
        // ===== Rename Dialog =====
        async function showRenameDialog(convId) {
            const conv = conversations.find(c => c._id === convId);
            if (!conv) return;
            
            const currentTitle = conv.title || 'New Chat';
            const newTitle = await CustomModal.prompt('Enter new title:', currentTitle, { titleText: 'Rename Conversation' });
            
            if (newTitle !== null && newTitle.trim() !== '' && newTitle.trim() !== currentTitle) {
                renameConversation(convId, newTitle.trim());
            }
        }
        
        async function renameConversation(id, newTitle) {
            try {
                const resp = await fetch(`/chatbot/conversations/${id}/rename`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ title: newTitle })
                });
                const data = await resp.json();
                if (data.success) {
                    const conv = conversations.find(c => c._id === id);
                    if (conv) conv.title = data.title;
                    renderConversationList(searchInput.value);
                }
            } catch (err) {
                console.error('Error renaming conversation:', err);
            }
        }
        
        // ===== Pin/Unpin =====
        async function togglePin(id) {
            try {
                const resp = await fetch(`/chatbot/conversations/${id}/pin`, {
                    method: 'PUT',
                    credentials: 'include'
                });
                const data = await resp.json();
                if (data.success) {
                    const conv = conversations.find(c => c._id === id);
                    if (conv) conv.isPinned = data.isPinned;
                    // Re-sort: pinned first
                    conversations.sort((a, b) => {
                        if (a.isPinned && !b.isPinned) return -1;
                        if (!a.isPinned && b.isPinned) return 1;
                        return new Date(b.lastMessageAt || b.createdAt) - new Date(a.lastMessageAt || a.createdAt);
                    });
                    renderConversationList(searchInput.value);
                }
            } catch (err) {
                console.error('Error toggling pin:', err);
            }
        }
        
        // ===== Search Conversations =====
        const searchInput = document.getElementById('searchConversations');
        searchInput.addEventListener('input', (e) => {
            renderConversationList(e.target.value);
        });

        // ===== API Functions =====
        async function checkSession() {
            try {
                const resp = await fetch('/chatbot/debug-session', { credentials: 'include' });
                const data = await resp.json();
                return !!data.sessionUser;
            } catch {
                return false;
            }
        }

        async function fetchConversations() {
            try {
                const resp = await fetch('/chatbot/conversations', { credentials: 'include' });
                const data = await resp.json();
                if (data.success) {
                    conversations = data.conversations;
                    renderConversationList(searchInput?.value || '');
                }
            } catch (err) {
                console.error('Error fetching conversations:', err);
                conversationList.innerHTML = '<div class="error-state">Failed to load</div>';
            }
        }

        async function loadConversation(id) {
            try {
                enableInput(false);
                const resp = await fetch(`/chatbot/conversations/${id}`, { credentials: 'include' });
                const data = await resp.json();

                if (data.success && data.conversation) {
                    conversationId = data.conversation._id;
                    clearChatBox();
                    data.conversation.messages.forEach(msg => {
                        if (msg.role === 'user') addUserMessage(msg.content, msg.createdAt);
                        else if (msg.role === 'assistant') addAIMessage(msg.content, msg.createdAt);
                    });
                    renderConversationList(searchInput?.value || '');
                }
            } catch (err) {
                console.error('Error loading conversation:', err);
                addAIMessage('Failed to load conversation. Please try again.');
            } finally {
                enableInput(true);
                messageInput.focus();
            }
        }

        async function deleteConversation(id) {
            if (!await CustomModal.confirm('Delete this conversation?', { titleText: 'Delete Conversation', danger: true })) return;
            try {
                const resp = await fetch(`/chatbot/conversations/${id}`, { method: 'DELETE', credentials: 'include' });
                const data = await resp.json();
                if (data.success) {
                    conversations = conversations.filter(c => c._id !== id);
                    renderConversationList(searchInput?.value || '');
                    if (conversationId === id) startNewChat();
                }
            } catch (err) {
                console.error('Error deleting conversation:', err);
            }
        }

        function startNewChat() {
            conversationId = null;
            clearChatBox();
            renderConversationList();
            messageInput.focus();
        }

        async function sendMessageToServer(text) {
            const resp = await fetch('/chatbot/message', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({ message: text, conversationId })
            });
            const data = await resp.json();
            if (data.success) {
                conversationId = data.conversationId;
                return data.reply || data.assistant; // Handle both response formats
            } else {
                throw new Error(data.error || 'Failed to get response');
            }
        }

        // ===== Event Listeners =====
        chatForm.addEventListener('submit', async (e) => {
            e.preventDefault();
            const text = messageInput.value.trim();
            if (!text) return;

            addUserMessage(text);
            messageInput.value = '';
            enableInput(false);
            addTypingIndicator();

            try {
                const reply = await sendMessageToServer(text);
                removeTypingIndicator();

                // Small delay to ensure DOM is updated before adding AI message
                await new Promise(resolve => setTimeout(resolve, 50));

                addAIMessage(reply);
                await fetchConversations();
            } catch (err) {
                removeTypingIndicator();
                addAIMessage('Error: ' + err.message);
            } finally {
                enableInput(true);
                messageInput.focus();
            }
        });
        quickQuestions.forEach(btn => {
            btn.addEventListener('click', () => {
                if (btn.disabled) return;
                const question = btn.dataset.question;
                messageInput.value = question;
                chatForm.dispatchEvent(new Event('submit'));
            });
        });
        newChatBtn.addEventListener('click', startNewChat);
        
        // ===== Real-time Socket.IO Updates =====
        // Listen for chat updates from other tabs/sessions
        window.addEventListener('chatUpdate', async (e) => {
            const data = e.detail;
            if (data.type === 'new-conversation') {
                // Refresh conversation list when a new conversation is created elsewhere
                await fetchConversations();
            } else if (data.type === 'update-conversation' && data.conversationId === conversationId) {
                // If current conversation was updated elsewhere, reload it
                await loadConversation(conversationId);
            } else if (data.type === 'delete-conversation') {
                conversations = conversations.filter(c => c._id !== data.conversationId);
                renderConversationList();
                if (conversationId === data.conversationId) {
                    startNewChat();
                }
            }
        });

        // ===== Initialization =====
        const sessionValid = await checkSession();
        if (sessionValid) {
            enableInput(true);
            await fetchConversations();
        } else {
            addAIMessage('Please log in to use the chatbot.');
        }
    })();
</script>