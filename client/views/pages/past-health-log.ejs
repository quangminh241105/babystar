<link rel="stylesheet" href="/css/past-health-log.css">

<main role="main" aria-labelledby="pageTitle" class="page">
    <header class="page-header" id="pageTitle">
      <h1 class="title">Daily health logs</h1>
      <p class="subtitle">View and edit your health history.</p>
    </header>

    <!-- Filter / search controls (UI only) -->
    <section class="controls" aria-label="Filters">
      <div class="filter-row">
        <label for="startDate">From</label>
        <input id="startDate" type="date" aria-label="start date" />

        <label for="endDate">To</label>
        <input id="endDate" type="date" aria-label="end date" />

        <div class="quick-filters" role="tablist" aria-label="Quick filters">
          <button type="button" class="filter-btn" data-range="7">Last 7 days</button>
          <button type="button" class="filter-btn" data-range="30">Last 30 days</button>
          <button type="button" class="filter-btn" data-range="all">All</button>
        </div>

        <button type="button" class="clear-btn">Clear</button>
      </div>
    </section>

    <!-- Logs list -->
    <section id="logsList" class="logs-list" aria-live="polite" aria-label="Daily health logs list">
      <% if (logs && logs.length > 0) { %>
        <% logs.forEach(log => { 
          const logDate = new Date(log.logDate);
          const formattedDate = logDate.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
          const isoDate = logDate.toISOString().split('T')[0];
          const logId = log._id || log.id;
          const today = new Date().toISOString().split('T')[0];
          const isToday = isoDate === today;
        %>
          <article class="log-card" aria-labelledby="log-<%= isoDate %>">
            <header class="log-header">
              <div class="log-meta">
                <h2 id="log-<%= isoDate %>" class="log-date"><%= formattedDate %></h2>
                <div class="log-sub">Entry date: <%= isoDate %> • ID #<%= logId %></div>
              </div>

              <div class="log-actions" role="group" aria-label="Log actions">
                <% if (isToday) { %>
                  <button type="button" class="btn edit" data-log-id="<%= logId %>" aria-label="Edit log <%= logId %>">Edit</button>
                <% } %>
                <form method="POST" action="/past-health-records/<%= logId %>/delete" style="display: inline;">
                  <button type="submit" class="btn delete" aria-label="Delete log <%= logId %>");">Delete</button>
                </form>
              </div>
            </header>

            <div class="log-vitals">
              <% if (log.weightKg) { %>
                <div class="vital"><strong>Weight</strong><span><%= log.weightKg %> kg</span></div>
              <% } %>
              <% if (log.bloodPressure) { %>
                <div class="vital"><strong>Blood pressure</strong><span><%= log.bloodPressure %> mmHg</span></div>
              <% } %>
              <% if (log.sleep && log.sleep.totalHours) { %>
                <div class="vital"><strong>Sleep</strong><span><%= log.sleep.totalHours %> h</span></div>
              <% } %>
              <% if (log.mood) { %>
                <div class="vital"><strong>Mood</strong><span><%= log.mood.replace(/_/g, ' ') %></span></div>
              <% } %>
            </div>

            <% if (log.symptoms && log.symptoms.length > 0) { %>
              <div class="log-symptom" aria-label="Main symptom">
                <strong>Main symptom</strong>
                <p><%= log.symptoms[0].symptom.replace(/_/g, ' ') %><% if (log.symptoms[0].notes) { %>; <%= log.symptoms[0].notes %><% } %></p>
              </div>
            <% } %>

            <% if (log.notes) { %>
              <div class="log-note" aria-label="User note">
                <strong>Note</strong>
                <p><%= log.notes %></p>
              </div>
            <% } %>
          </article>
        <% }); %>
      <% } else { %>
        <div class="no-logs">
          <p>No health logs found. Start logging your daily health data to see them here.</p>
        </div>
      <% } %>
    </section>
    
    <footer class="page-footer" aria-hidden="false">
      <p class="hint">Tip: Use the date filters to quickly find past entries.</p>
    </footer>
  </main>