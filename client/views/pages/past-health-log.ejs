<link rel="stylesheet" href="/css/past-health-log.css">

<div class="page-container" data-delete-allowed="<%= canDelete %>">
  <div class="content-wrapper">
    <!-- Header -->
    <header class="page-header">
      <div class="header-content">
        <div class="header-text">
          <h1>Past Health Logs</h1>
          <p>View and manage your daily health records</p>
        </div>
        <!-- Streak Display -->
        <div class="streak-badge" id="streakBadge">
          <span class="streak-fire">🔥</span>
          <span class="streak-count" id="streakCount">0</span>
          <span class="streak-text">Day Streak</span>
        </div>
      </div>
    </header>

    <div class="main-grid">
      <!-- Left Side - Health Log Cards -->
      <div class="left-column">
        <!-- Filter Controls -->
        <section class="filter-section">
          <div class="filter-row">
            <div class="filter-group">
              <label for="startDate">From</label>
              <input id="startDate" type="date" aria-label="start date" />
            </div>
            <div class="filter-group">
              <label for="endDate">To</label>
              <input id="endDate" type="date" aria-label="end date" />
            </div>
          </div>
          <div class="quick-filters">
            <button type="button" class="filter-btn" data-range="7">Last 7 days</button>
            <button type="button" class="filter-btn" data-range="30">Last 30 days</button>
            <button type="button" class="filter-btn" data-range="all">All</button>
          </div>
        </section>

        <!-- Available Health Logs Section -->
        <section class="logs-section">
          <h2>Available Health Logs</h2>
          <div id="logsList" class="logs-container">
            <% if (logs && logs.length > 0) { %>
              <% logs.forEach((log, index) => { 
                const logDate = new Date(log.logDate);
                const formattedDate = logDate.toLocaleDateString('en-US', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' });
                const isoDate = logDate.toISOString().split('T')[0];
                const logId = log._id || log.id;
                
                // Get top 3 symptoms
                const topSymptoms = log.symptoms && log.symptoms.length > 0 
                  ? log.symptoms.slice(0, 3).map(s => s.symptom.replace(/_/g, ' '))
                  : [];
              %>
                <article class="log-card <%= index === 0 ? 'selected' : '' %>" data-log-id="<%= logId %>" data-log-date="<%= isoDate %>" data-log-index="<%= index %>">
                  <div class="log-card-inner">
                    <div class="checkbox-area">
                      <input type="radio" name="log-select" id="log-<%= logId %>" <%= index === 0 ? 'checked' : '' %>>
                    </div>
                    <div class="log-content">
                      <header class="log-header">
                        <h2 class="log-title"><%= formattedDate %></h2>
                      </header>
                      <dl class="log-meta">
                        <% if (log.pregnancyWeek) { %>
                          <div>
                            <dt>Week</dt>
                            <dd><%= log.pregnancyWeek %></dd>
                          </div>
                        <% } %>
                        <div>
                          <dt>Log ID</dt>
                          <dd>#<%= logId.toString().slice(-6) %></dd>
                        </div>
                        <% if (log.weightKg) { %>
                          <div>
                            <dt>Weight</dt>
                            <dd><%= log.weightKg %> kg</dd>
                          </div>
                        <% } %>
                        <% if (log.sleep && log.sleep.totalHours) { %>
                          <div>
                            <dt>Sleep</dt>
                            <dd><%= log.sleep.totalHours %> hrs</dd>
                          </div>
                        <% } %>
                      </dl>
                      <% if (topSymptoms.length > 0) { %>
                        <div class="log-symptoms">
                          <div class="symptoms-title">Symptoms</div>
                          <ul class="symptoms-list">
                            <% topSymptoms.forEach(symptom => { %>
                              <li><%= symptom %></li>
                            <% }); %>
                          </ul>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% }); %>
            <% } else { %>
              <div class="no-logs">
                <p>No health logs found. Start logging your daily health data to see them here.</p>
              </div>
            <% } %>
          </div>
        </section>
      </div>

      <!-- Right Side - Detail View -->
      <div class="right-column">
        <div class="preview-container">
          <div class="preview-header">
            <h2>Health Log Details</h2>
            <span id="previewPageInfo" class="page-info">Select a log to view details</span>
          </div>
          
          <div id="detailContent" class="detail-content">
            <% if (logs && logs.length > 0) { %>
              <div class="loading-detail">
                <p>Loading details...</p>
              </div>
            <% } else { %>
              <div class="empty-detail">
                <p>No logs available. Start logging your health data!</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Hidden log data for JavaScript -->
<script id="logsData" type="application/json">
  <%- JSON.stringify(logs || []) %>
</script>

<script>
// Fetch and display streak
async function fetchStreak() {
  try {
    const response = await fetch('/streak/getStreak');
    if (!response.ok) throw new Error('Failed to fetch streak');
    
    const data = await response.json();
    
    const streakCount = document.getElementById('streakCount');
    const streakBadge = document.getElementById('streakBadge');
    
    if (streakCount) streakCount.textContent = data.currentStreak;
    
    // Add highlight effect for high streaks
    if (streakBadge && data.currentStreak >= 7) {
      streakBadge.classList.add('streak-high');
    }
  } catch (error) {
    console.error('Error fetching streak:', error);
  }
}

// Load streak on page load
document.addEventListener('DOMContentLoaded', fetchStreak);
</script>

<script src="/js/pasthealthlog.js"></script>