<link rel="stylesheet" href="/css/adminuser.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<main class="container admin-users-main">
  <div style="margin-bottom: 16px;">
    <a href="/admin" style="color: #D91E8F; text-decoration: none; font-weight: 600;">← Back to Admin Dashboard</a>
  </div>
  
  <header class="admin-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h1>📚 Quiz Management</h1>
      <p>Manage all pregnancy quizzes</p>
    </div>
    <a href="/admin/quiz-generator" class="btn btn-primary">
      <span>✨</span> Generate New Quiz
    </a>
  </header>

  <div class="quiz-stats">
    <div class="stat-card">
      <div class="stat-number" id="totalQuizzes">-</div>
      <div class="stat-label">Total Quizzes</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="activeQuizzes">-</div>
      <div class="stat-label">Active Quizzes</div>
    </div>
    <div class="stat-card">
      <div class="stat-number" id="totalQuestions">-</div>
      <div class="stat-label">Total Questions</div>
    </div>
  </div>

  <div class="filter-section">
    <select id="categoryFilter" class="filter-select">
      <option value="">All Categories</option>
      <option value="nutrition">Nutrition</option>
      <option value="exercise">Exercise</option>
      <option value="baby_development">Baby Development</option>
    </select>

    <select id="statusFilter" class="filter-select">
      <option value="">All Status</option>
      <option value="active">Active Only</option>
      <option value="inactive">Inactive Only</option>
    </select>
  </div>

  <div id="message" class="message" style="display: none;"></div>

  <div class="quiz-list-container">
    <div id="loadingIndicator" class="loading">
      <div class="spinner"></div>
      <p>Loading quizzes...</p>
    </div>

    <div id="quizList" class="quiz-list" style="display: none;">
      <!-- Quizzes will be populated here -->
    </div>

    <div id="emptyState" class="empty-state" style="display: none;">
      <div class="empty-icon">📝</div>
      <h3>No quizzes found</h3>
      <p>Generate your first quiz using AI</p>
      <a href="/admin/quiz-generator" class="btn-primary">Generate Quiz</a>
    </div>
  </div>
</main>

<style>
.quiz-stats {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.stat-card {
  background: white;
  padding: 24px;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  text-align: center;
}

.stat-number {
  font-size: 36px;
  font-weight: 700;
  color: #D91E8F;
  margin-bottom: 8px;
}

.stat-label {
  color: #666;
  font-size: 14px;
}

.filter-section {
  display: flex;
  gap: 12px;
  margin-bottom: 24px;
}

.filter-select {
  padding: 10px 16px;
  border: 2px solid #e0e0e0;
  border-radius: 8px;
  font-size: 14px;
  cursor: pointer;
  background: white;
}

.filter-select:focus {
  outline: none;
  border-color: #D91E8F;
}

.quiz-list-container {
  background: white;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  min-height: 400px;
}

.quiz-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.quiz-card {
  border: 2px solid #e0e0e0;
  border-radius: 12px;
  padding: 20px;
  transition: all 0.2s;
}

.quiz-card:hover {
  border-color: #D91E8F;
  box-shadow: 0 4px 12px rgba(217, 30, 143, 0.15);
}

.quiz-card-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 12px;
}

.quiz-title {
  font-size: 18px;
  font-weight: 600;
  color: #333;
  margin: 0;
}

.quiz-badges {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.badge {
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 12px;
  font-weight: 600;
}

.badge-active {
  background: #d4edda;
  color: #155724;
}

.badge-inactive {
  background: #f8d7da;
  color: #721c24;
}

.badge-category {
  background: #FFF5F9;
  color: #D91E8F;
  border: 1px solid #FFE3F0;
}

.quiz-meta {
  display: flex;
  gap: 20px;
  margin-bottom: 16px;
  color: #666;
  font-size: 14px;
}

.quiz-meta-item {
  display: flex;
  align-items: center;
  gap: 6px;
}

.quiz-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.btn-action {
  padding: 8px 16px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  border: none;
  transition: all 0.2s;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.btn-view {
  background: #E8F5E9;
  color: #2E7D32;
}

.btn-view:hover {
  background: #C8E6C9;
}

.btn-toggle {
  background: #FFF3E0;
  color: #E65100;
}

.btn-toggle:hover {
  background: #FFE0B2;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.empty-state h3 {
  color: #333;
  margin: 0 0 8px 0;
}

.empty-state p {
  color: #666;
  margin: 0 0 20px 0;
}

@media (max-width: 768px) {
  .quiz-card-header {
    flex-direction: column;
    gap: 12px;
  }

  .quiz-actions {
    width: 100%;
  }

  .btn-action {
    flex: 1;
    justify-content: center;
  }
}
</style>

<script>
(function() {
  let allQuizzes = [];

  const loadingIndicator = document.getElementById('loadingIndicator');
  const quizList = document.getElementById('quizList');
  const emptyState = document.getElementById('emptyState');
  const message = document.getElementById('message');
  const categoryFilter = document.getElementById('categoryFilter');
  const statusFilter = document.getElementById('statusFilter');

  // Load quizzes on page load
  loadQuizzes();

  // Filter listeners
  categoryFilter.addEventListener('change', filterQuizzes);
  statusFilter.addEventListener('change', filterQuizzes);

  async function loadQuizzes() {
    try {
      const response = await fetch('/admin/api/quizzes', {
        credentials: 'include'
      });

      if (!response.ok) throw new Error('Failed to load quizzes');

      const result = await response.json();
      allQuizzes = result.quizzes || [];

      updateStats();
      renderQuizzes(allQuizzes);

      loadingIndicator.style.display = 'none';

    } catch (error) {
      console.error('Error loading quizzes:', error);
      loadingIndicator.style.display = 'none';
      showMessage('Failed to load quizzes', 'error');
    }
  }

  function updateStats() {
    const total = allQuizzes.length;
    const active = allQuizzes.filter(q => q.isActive).length;
    const totalQuestions = allQuizzes.reduce((sum, q) => sum + q.questionCount, 0);

    document.getElementById('totalQuizzes').textContent = total;
    document.getElementById('activeQuizzes').textContent = active;
    document.getElementById('totalQuestions').textContent = totalQuestions;
  }

  function renderQuizzes(quizzes) {
    if (quizzes.length === 0) {
      quizList.style.display = 'none';
      emptyState.style.display = 'block';
      return;
    }

    quizList.style.display = 'block';
    emptyState.style.display = 'none';

    quizList.innerHTML = quizzes.map(quiz => `
      <div class="quiz-card" data-quiz-id="${quiz._id}">
        <div class="quiz-card-header">
          <h3 class="quiz-title">${quiz.title}</h3>
          <div class="quiz-badges">
            <span class="badge badge-${quiz.isActive ? 'active' : 'inactive'}">
              ${quiz.isActive ? '✓ Active' : '✕ Inactive'}
            </span>
            <span class="badge badge-category">${formatCategory(quiz.category)}</span>
          </div>
        </div>

        <div class="quiz-meta">
          <div class="quiz-meta-item">
            <span>📝</span>
            <span>${quiz.questionCount} questions</span>
          </div>
          <div class="quiz-meta-item">
            <span>📅</span>
            <span>${formatDate(quiz.createdAt)}</span>
          </div>
        </div>

        <div class="quiz-actions">
          <a href="/quiz/category/${quiz.category}" class="btn-action btn-view">
            👁️ View
          </a>
          <button class="btn-action btn-toggle" onclick="toggleQuiz('${quiz._id}', ${quiz.isActive})">
            ${quiz.isActive ? '🔴 Deactivate' : '🟢 Activate'}
          </button>
        </div>
      </div>
    `).join('');
  }

  function filterQuizzes() {
    const categoryValue = categoryFilter.value;
    const statusValue = statusFilter.value;

    let filtered = allQuizzes;

    if (categoryValue) {
      filtered = filtered.filter(q => q.category === categoryValue);
    }

    if (statusValue === 'active') {
      filtered = filtered.filter(q => q.isActive);
    } else if (statusValue === 'inactive') {
      filtered = filtered.filter(q => !q.isActive);
    }

    renderQuizzes(filtered);
  }

  function formatCategory(category) {
    const map = {
      'nutrition': 'Nutrition',
      'exercise': 'Exercise',
      'baby_development': 'Baby Development'
    };
    return map[category] || category;
  }

  function formatDate(dateString) {
    const date = new Date(dateString);
    return date.toLocaleDateString('en-US', { 
      month: 'short', 
      day: 'numeric', 
      year: 'numeric' 
    });
  }

  function showMessage(text, type) {
    message.textContent = text;
    message.className = `message ${type}`;
    message.style.display = 'block';
    setTimeout(() => {
      message.style.display = 'none';
    }, 5000);
  }

  // Global functions for button actions
  window.toggleQuiz = async function(quizId, currentStatus) {
    try {
      const response = await fetch(`/admin/quiz/${quizId}/toggle`, {
        method: 'PUT',
        credentials: 'include'
      });

      const result = await response.json();

      if (result.success) {
        showMessage(result.message, 'success');
        loadQuizzes(); // Reload
      } else {
        showMessage(result.error || 'Failed to toggle quiz', 'error');
      }
    } catch (error) {
      console.error('Error:', error);
      showMessage('Network error', 'error');
    }
  };
})();
</script>
