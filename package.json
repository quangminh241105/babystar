{
  "name": "babystar",
  "version": "2.0.0",
  "private": true,
  "description": "BabyStar pregnancy wellness platform",
  "workspaces": ["apps/web"],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "test:api": "python -m pytest apps/api",
    "compile:api": "python -m compileall -q apps/api",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  }
}
